# The image is built from the Go module and the three trees of the
# tool, and from nothing else in the folder: no personal file, no
# database and no build output reaches the builder.
*
!go.mod
!go.sum
!cmd
!fado
!internal
**/*.exe
**/*.test
**/*.out
**/*.prof
**/*.db
**/*.db-wal
**/*.db-shm
**/*.fado
**/*.fado-wal
**/*.fado-shm
**/*.lock
