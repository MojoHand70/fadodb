{
  "suite": "typing",
  "description": "ADR-0019's static types, decided at definition time: no implicit conversion to or from text, no arithmetic on dates, same-type comparisons, bool conditions, agreeing IF branches, and the catalog's argument types. Unknown names are refused with a hint when they are functions.",
  "variables": {"qty": "number", "price": "number", "name": "text", "paid": "bool", "due": "date", "customer": "ref", "extra": "json", "lines": "rows", "tags": "array<text>"},
  "accept": [
    "qty * price",
    "qty + TRUE",
    "-paid",
    "paid%",
    "qty + BLANK",
    "BLANK + BLANK",
    "name & qty",
    "name & due & paid & customer",
    "\"n=\" & 5",
    "qty = 1",
    "qty <> BLANK",
    "name = \"x\"",
    "name < \"x\"",
    "name = BLANK",
    "due < DATE(2024, 1, 1)",
    "due = BLANK",
    "paid = TRUE",
    "paid = FALSE",
    "TEXT(customer) = \"Customer:42\"",
    "customer = customer",
    "TEXT(extra) = \"{}\"",
    "extra = extra",
    "BLANK = BLANK",
    "IF(paid, 1, 2)",
    "IF(paid, 1, BLANK)",
    "IF(paid, BLANK, \"x\")",
    "IF(paid, BLANK, BLANK)",
    "IF(qty > 0, name, \"none\")",
    "IF(BLANK, 1, 2)",
    "IF paid THEN due ELSE ADDDAYS(due, 7)",
    "paid AND qty > 0",
    "paid OR BLANK",
    "NOT paid",
    "NOT BLANK",
    "ISBLANK(due)",
    "ROUND(qty, paid)",
    "ROUND(BLANK)",
    "UPPER(name)",
    "UPPER(BLANK)",
    "LEN(name) > qty",
    "TEXT(qty)",
    "TEXT(due)",
    "TEXT(paid)",
    "TEXT(customer)",
    "VALUE(name) + 1",
    "DATEVALUE(name) < due",
    "DAYS(due, TODAY())",
    "ADDMONTHS(due, qty)",
    "YEAR(due) = 2024",
    "DATEOF(NOW()) > due",
    "NOW() > DATETIME(due)",
    "USER() = \"alice\"",
    "INGROUP(\"admins\") AND paid",
    "JSONVALUE(extra, \"a.b\") = \"x\"",
    "VALUE(JSONVALUE(extra, \"qty\")) * 2",
    "SUM(qty, price, 1)",
    "COUNT(qty, name, due)",
    "CONCAT(name, qty, due)",
    "MIN(qty, BLANK)",
    "REGEXREPLACE(name, \"[0-9]+\", \"#\")",
    "qty > 0 AND NOT ISBLANK(name)",
    "Qty * PRICE",
    "QTY"
  ],
  "reject": [
    {"formula": "unknown + 1", "reason": "unknown variable"},
    {"formula": "ROUND + 1", "reason": "a bare function name is not a variable; the message says to write ROUND(number[, digits])"},
    {"formula": "qty + name", "reason": "no implicit conversion from text"},
    {"formula": "\"a\" + 1", "reason": "no implicit conversion from text"},
    {"formula": "name * 2", "reason": "no implicit conversion from text"},
    {"formula": "-name", "reason": "no implicit conversion from text"},
    {"formula": "name%", "reason": "no implicit conversion from text"},
    {"formula": "due + 1", "reason": "dates take no arithmetic operator"},
    {"formula": "due - due", "reason": "dates take no arithmetic operator"},
    {"formula": "-due", "reason": "dates take no arithmetic operator"},
    {"formula": "customer + 1", "reason": "refs take no arithmetic"},
    {"formula": "extra * 2", "reason": "json takes no arithmetic"},
    {"formula": "TRUE = 1", "reason": "bool and number do not compare"},
    {"formula": "paid = 1", "reason": "bool and number do not compare"},
    {"formula": "qty = \"1\"", "reason": "number and text do not compare"},
    {"formula": "qty = name", "reason": "number and text do not compare"},
    {"formula": "due = \"2024-01-01\"", "reason": "date and text do not compare; DATEVALUE converts"},
    {"formula": "due = 0", "reason": "date and number do not compare"},
    {"formula": "NOW() > due", "reason": "a datetime and a date do not compare; DATEOF or DATETIME converts"},
    {"formula": "DAYS(due, NOW())", "reason": "DAYS needs two dates or two datetimes"},
    {"formula": "customer = qty", "reason": "ref and number do not compare"},
    {"formula": "customer = \"Customer:42\"", "reason": "ref and text do not compare; TEXT(customer) does"},
    {"formula": "extra = \"{}\"", "reason": "json and text do not compare; TEXT(extra) does"},
    {"formula": "lines = lines", "reason": "composites do not compare"},
    {"formula": "IF(qty, 1, 2)", "reason": "a number is not a condition"},
    {"formula": "IF(name, 1, 2)", "reason": "text is not a condition"},
    {"formula": "IF(due, 1, 2)", "reason": "a date is not a condition"},
    {"formula": "IF qty THEN 1 ELSE 2", "reason": "a number is not a condition"},
    {"formula": "IF(paid, 1, \"x\")", "reason": "branches must have the same type"},
    {"formula": "IF(paid, qty, due)", "reason": "branches must have the same type"},
    {"formula": "IF(paid, TRUE, 1)", "reason": "branches must have the same type"},
    {"formula": "qty AND paid", "reason": "a number is not a condition"},
    {"formula": "paid OR name", "reason": "text is not a condition"},
    {"formula": "NOT qty", "reason": "a number is not a condition"},
    {"formula": "NOT due", "reason": "a date is not a condition"},
    {"formula": "ROUND(name)", "reason": "ROUND needs a number"},
    {"formula": "ROUND(due)", "reason": "ROUND needs a number"},
    {"formula": "ROUND(qty, name)", "reason": "the digits must be a number"},
    {"formula": "UPPER(qty)", "reason": "UPPER needs text; TEXT converts"},
    {"formula": "UPPER(due)", "reason": "UPPER needs text"},
    {"formula": "LEN(5)", "reason": "LEN needs text"},
    {"formula": "VALUE(qty)", "reason": "VALUE needs text"},
    {"formula": "YEAR(qty)", "reason": "YEAR needs a date"},
    {"formula": "YEAR(name)", "reason": "YEAR needs a date; DATEVALUE converts"},
    {"formula": "DAYS(due, 5)", "reason": "DAYS needs dates"},
    {"formula": "ADDDAYS(5, 1)", "reason": "ADDDAYS needs a date"},
    {"formula": "ADDDAYS(due, due)", "reason": "the count must be a number"},
    {"formula": "DATEVALUE(due)", "reason": "DATEVALUE needs text"},
    {"formula": "INGROUP(5)", "reason": "INGROUP needs text"},
    {"formula": "JSONVALUE(name, \"a\")", "reason": "JSONVALUE needs a json value"},
    {"formula": "JSONVALUE(extra, \"qty\") * 2", "reason": "JSONVALUE returns text; VALUE converts"},
    {"formula": "SUM(qty, name)", "reason": "SUM needs numbers"},
    {"formula": "MIN(due, due)", "reason": "MIN needs numbers"},
    {"formula": "ISBLANK(1, 2)", "reason": "arity"},
    {"formula": "REGEXREPLACE(name, \"(\", \"x\")", "reason": "an invalid literal pattern is refused at definition time"},
    {"formula": "THIS.qty", "reason": "THIS is only valid inside LOOKUP and QUERY"},
    {"formula": "lines", "reason": "composite values are not supported yet"},
    {"formula": "ISBLANK(lines)", "reason": "composite values are not supported yet"},
    {"formula": "lines.qty", "reason": "composite values are not supported yet"},
    {"formula": "qty.x", "reason": "only a rows variable has columns"},
    {"formula": "tags", "reason": "composite values are not supported yet"},
    {"formula": "SUM(tags)", "reason": "composite values are not supported yet"},
    {"formula": "INDEX(tags, 1)", "reason": "not implemented yet"},
    {"formula": "LOOKUP(Rates, rate, code = THIS.code)", "reason": "not implemented yet"},
    {"formula": "QUERY(Invoice, total)", "reason": "not implemented yet"}
  ]
}
