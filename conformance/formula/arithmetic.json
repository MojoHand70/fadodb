{
  "suite": "arithmetic",
  "description": "The operators of ADR-0004 and ADR-0019: precedence, associativity, division by zero (/ gives 0, \\ is an error), comparison by value and by code point, and text concatenation with the TEXT rendering rule.",
  "variables": {"Revenue": "number", "Cost": "number", "X": "number", "T": "text"},
  "cases": [
    {"formula": "1 + 2", "expected": 3},
    {"formula": "10 - 3", "expected": 7},
    {"formula": "4 * 5", "expected": 20},
    {"formula": "10 / 4", "expected": 2.5},
    {"name": "/ by zero yields 0", "formula": "10 / 0", "expected": 0},
    {"formula": "0 / 0", "expected": 0},
    {"formula": "Revenue / Cost", "inputs": {"Revenue": 100}, "expected": 0},
    {"formula": "10 \\ 4", "expected": 2.5},
    {"name": "\\ by zero is an error", "formula": "10 \\ 0", "error": "div_by_zero"},
    {"formula": "Revenue \\ Cost", "inputs": {"Revenue": 100, "Cost": 0}, "error": "div_by_zero"},
    {"formula": "Revenue \\ Cost", "inputs": {"Revenue": 100}, "error": "div_by_zero"},
    {"formula": "-5", "expected": -5},
    {"formula": "--1", "expected": 1},
    {"formula": "1 - -1", "expected": 2},
    {"formula": "2 + 3 * 4", "expected": 14},
    {"formula": "(2 + 3) * 4", "expected": 20},
    {"formula": "1 + 2 + 3 + 4", "expected": 10},
    {"formula": "((1 + 2) * (3 + 4)) / 7", "expected": 3},
    {"formula": "10 - 2 - 3", "expected": 5},
    {"formula": "100 / 10 / 2", "expected": 5},
    {"formula": "7 / 2 * 2", "expected": 7},
    {"formula": "2 ^ 3 ^ 2", "expected": 512},
    {"formula": "-2 ^ 2", "expected": 4},
    {"formula": "2 * 3 ^ 2", "expected": 18},
    {"formula": "0.1 + 0.2", "expected": 0.30000000000000004},
    {"formula": "1e3 + .5", "expected": 1000.5},
    {"formula": "Revenue - Cost", "inputs": {"Revenue": 100, "Cost": 60}, "expected": 40},
    {"formula": "(Revenue - Cost) / Revenue * 100", "inputs": {"Revenue": 100, "Cost": 60}, "expected": 40},
    {"formula": "0 + Revenue", "inputs": {"Revenue": 10}, "expected": 10},
    {"name": "booleans read as 1 and 0 in arithmetic", "formula": "TRUE + 1", "expected": 2},
    {"formula": "(Revenue > Cost) * 10", "inputs": {"Revenue": 100, "Cost": 60}, "expected": 10},
    {"formula": "FALSE * 5", "expected": 0},
    {"name": "comparisons", "formula": "1 < 2", "expected": true},
    {"formula": "2 <= 2", "expected": true},
    {"formula": "3 > 2", "expected": true},
    {"formula": "2 >= 3", "expected": false},
    {"formula": "1 = 1", "expected": true},
    {"formula": "1 <> 1", "expected": false},
    {"formula": "0.1 + 0.2 = 0.3", "expected": false},
    {"formula": "Revenue > Cost", "inputs": {"Revenue": 100, "Cost": 60}, "expected": true},
    {"name": "text compares by code point and is case-sensitive", "formula": "\"a\" < \"b\"", "expected": true},
    {"formula": "\"abc\" = \"ABC\"", "expected": false},
    {"formula": "\"abc\" = \"abc\"", "expected": true},
    {"formula": "\"ABC\" < \"abc\"", "expected": true},
    {"formula": "\"ż\" > \"z\"", "expected": true},
    {"formula": "\"Zebra\" < \"apple\"", "expected": true},
    {"formula": "\"\" < \"a\"", "expected": true},
    {"formula": "\"ab\" < \"abc\"", "expected": true},
    {"formula": "UPPER(\"abc\") = \"ABC\"", "expected": true},
    {"formula": "T = \"x\"", "inputs": {"T": "x"}, "expected": true},
    {"formula": "T <> \"x\"", "inputs": {"T": "X"}, "expected": true},
    {"name": "& renders every scalar as TEXT does", "formula": "\"a\" & \"b\"", "expected": "ab"},
    {"formula": "\"n=\" & 5", "expected": "n=5"},
    {"formula": "1 & 2", "expected": "12"},
    {"formula": "\"d=\" & 0.5", "expected": "d=0.5"},
    {"formula": "\"t=\" & TRUE", "expected": "t=TRUE"},
    {"formula": "\"x\" & BLANK", "expected": "x"},
    {"formula": "1 / 3 & \"\"", "expected": "0.333333333333333"},
    {"formula": "\"a\" & \"b\" & \"c\"", "expected": "abc"},
    {"formula": "\"sum: \" & 1 + 2", "expected": "sum: 3"},
    {"formula": "T & T", "inputs": {"T": "ab"}, "expected": "abab"},
    {"formula": "X & \"!\"", "inputs": {"X": 7}, "expected": "7!"},
    {"formula": "X & \"!\"", "expected": "!"},
    {"name": "huge magnitudes stay finite until they overflow", "formula": "1e308 * 10", "error": "not_a_number"},
    {"formula": "1e308 + 1e308", "error": "not_a_number"},
    {"formula": "-1e308 * 10", "error": "not_a_number"},
    {"formula": "1e308 * 0.5", "expected": 5e307}
  ]
}
