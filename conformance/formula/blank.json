{
  "suite": "blank",
  "description": "Blank is one value, the JSON null. A stored 0 or an empty text is not blank. In arithmetic and numeric comparison a blank reads as 0, in text as the empty string, as a condition as FALSE (ADR-0005, ADR-0019). Rows from the predecessor engine: r1 Alfa=5 Beta=blank Nazwa=x; r2 Alfa=blank Beta=0 Nazwa=blank; r3 Alfa=-2 Beta=3 Nazwa=y.",
  "variables": {"Alfa": "number", "Beta": "number", "Nazwa": "text"},
  "cases": [
    {"formula": "ISBLANK(Alfa)", "inputs": {"Alfa": 5, "Nazwa": "x"}, "expected": false},
    {"formula": "ISBLANK(Alfa)", "inputs": {"Beta": 0}, "expected": true},
    {"formula": "ISBLANK(Alfa)", "inputs": {"Alfa": -2, "Beta": 3, "Nazwa": "y"}, "expected": false},
    {"formula": "ISNOTBLANK(Beta)", "inputs": {"Alfa": 5, "Nazwa": "x"}, "expected": false},
    {"name": "a stored 0 is not blank", "formula": "ISNOTBLANK(Beta)", "inputs": {"Beta": 0}, "expected": true},
    {"formula": "ISNOTBLANK(Beta)", "inputs": {"Alfa": -2, "Beta": 3, "Nazwa": "y"}, "expected": true},
    {"formula": "IF(ISBLANK(Alfa), -1, Alfa)", "inputs": {"Alfa": 5}, "expected": 5},
    {"formula": "IF(ISBLANK(Alfa), -1, Alfa)", "inputs": {"Beta": 0}, "expected": -1},
    {"formula": "IF(ISBLANK(Alfa), -1, Alfa)", "inputs": {"Alfa": -2, "Beta": 3}, "expected": -2},
    {"formula": "ISBLANK(Alfa) AND ISBLANK(Beta)", "inputs": {"Alfa": 5}, "expected": false},
    {"formula": "ISBLANK(Alfa) AND ISBLANK(Beta)", "inputs": {"Beta": 0}, "expected": false},
    {"formula": "ISBLANK(Alfa) AND ISBLANK(Beta)", "inputs": {"Alfa": -2, "Beta": 3}, "expected": false},
    {"formula": "ISBLANK(Alfa) OR ISBLANK(Beta)", "inputs": {"Alfa": 5}, "expected": true},
    {"formula": "ISBLANK(Alfa) OR ISBLANK(Beta)", "inputs": {"Beta": 0}, "expected": true},
    {"formula": "ISBLANK(Alfa) OR ISBLANK(Beta)", "inputs": {"Alfa": -2, "Beta": 3}, "expected": false},
    {"formula": "IF(ISNOTBLANK(Alfa) AND ISNOTBLANK(Beta), Alfa + Beta, 0)", "inputs": {"Alfa": 5}, "expected": 0},
    {"formula": "IF(ISNOTBLANK(Alfa) AND ISNOTBLANK(Beta), Alfa + Beta, 0)", "inputs": {"Beta": 0}, "expected": 0},
    {"formula": "IF(ISNOTBLANK(Alfa) AND ISNOTBLANK(Beta), Alfa + Beta, 0)", "inputs": {"Alfa": -2, "Beta": 3}, "expected": 1},
    {"name": "arithmetic reads a blank as 0, so an expression is never blank", "formula": "ISBLANK(Alfa + 1)", "inputs": {"Alfa": 5}, "expected": false},
    {"formula": "ISBLANK(Alfa + 1)", "inputs": {"Beta": 0}, "expected": false},
    {"formula": "ISBLANK(Alfa + 1)", "inputs": {"Alfa": -2, "Beta": 3}, "expected": false},
    {"formula": "ISBLANK(Nazwa)", "inputs": {"Nazwa": "x"}, "expected": false},
    {"formula": "ISBLANK(Nazwa)", "inputs": {"Beta": 0}, "expected": true},
    {"formula": "ISBLANK(Nazwa)", "inputs": {"Nazwa": "y"}, "expected": false},
    {"name": "a formula may return BLANK explicitly", "formula": "IF(ISBLANK(Beta) OR Beta = 0, BLANK, Alfa / Beta)", "inputs": {"Alfa": 5}, "expected": null},
    {"formula": "IF(ISBLANK(Beta) OR Beta = 0, BLANK, Alfa / Beta)", "inputs": {"Beta": 0}, "expected": null},
    {"formula": "IF(ISBLANK(Beta) OR Beta = 0, BLANK, Alfa / Beta)", "inputs": {"Alfa": -2, "Beta": 3}, "expected": -0.6666666666666666},
    {"name": "blank reads as 0 in arithmetic", "formula": "Alfa + Beta", "inputs": {"Alfa": 5}, "expected": 5},
    {"formula": "Alfa + Beta", "inputs": {"Beta": 0}, "expected": 0},
    {"formula": "Alfa + Beta", "inputs": {"Alfa": -2, "Beta": 3}, "expected": 1},
    {"formula": "Alfa * 5", "expected": 0},
    {"formula": "-Alfa", "expected": 0},
    {"name": "blank reads as the empty text in concatenation", "formula": "Nazwa & \"!\"", "inputs": {"Nazwa": "x"}, "expected": "x!"},
    {"formula": "Nazwa & \"!\"", "expected": "!"},
    {"formula": "Nazwa & \"!\"", "inputs": {"Nazwa": "y"}, "expected": "y!"},
    {"formula": "BLANK", "type": "blank", "expected": null},
    {"formula": "ISBLANK(BLANK)", "expected": true},
    {"formula": "ISBLANK(0)", "expected": false},
    {"formula": "ISBLANK(\"\")", "expected": false},
    {"formula": "ISNOTBLANK(\"\")", "expected": true},
    {"name": "blank reads as 0 in a numeric comparison", "formula": "Alfa = 0", "inputs": {"Alfa": 5}, "expected": false},
    {"formula": "Alfa = 0", "expected": true},
    {"formula": "Alfa < 1", "expected": true},
    {"formula": "Alfa > -1", "expected": true},
    {"name": "comparing with BLANK is not a blank test: both sides read as 0", "formula": "Beta = BLANK", "inputs": {"Alfa": 5}, "expected": true},
    {"formula": "Beta = BLANK", "inputs": {"Beta": 0}, "expected": true},
    {"formula": "Beta = BLANK", "inputs": {"Beta": 3}, "expected": false},
    {"name": "blank reads as the empty text in a text comparison", "formula": "Nazwa = \"\"", "expected": true},
    {"formula": "Nazwa = \"\"", "inputs": {"Nazwa": "x"}, "expected": false},
    {"formula": "LEN(Nazwa)", "expected": 0},
    {"formula": "UPPER(Nazwa)", "expected": ""},
    {"formula": "IF(ISBLANK(Nazwa), \"none\", Nazwa)", "expected": "none"},
    {"formula": "IF(ISBLANK(Nazwa), \"none\", Nazwa)", "inputs": {"Nazwa": "y"}, "expected": "y"},
    {"name": "a blank condition is FALSE", "formula": "IF(BLANK, 1, 2)", "expected": 2},
    {"formula": "NOT BLANK", "expected": true},
    {"formula": "BLANK OR TRUE", "expected": true},
    {"formula": "BLANK AND TRUE", "expected": false},
    {"name": "numeric functions read a blank as 0", "formula": "ABS(Alfa)", "expected": 0},
    {"formula": "ROUND(Alfa, 2)", "expected": 0},
    {"name": "aggregates skip blanks", "formula": "SUM(Alfa, Beta, 2)", "inputs": {"Beta": 3}, "expected": 5},
    {"formula": "COUNT(Alfa, Beta, 2)", "inputs": {"Beta": 3}, "expected": 2},
    {"formula": "AVERAGE(Alfa, Beta)", "inputs": {"Beta": 3}, "expected": 3},
    {"name": "AVERAGE of only blanks is blank, not an error", "formula": "AVERAGE(Alfa, Beta)", "expected": null},
    {"formula": "MIN(Alfa, Beta)", "inputs": {"Beta": 3}, "expected": 3},
    {"formula": "MAX(Alfa, Beta)", "expected": null},
    {"formula": "COUNT(Alfa, Beta)", "expected": 0},
    {"formula": "SUM(Alfa, Beta)", "expected": 0}
  ]
}
