{
  "suite": "context",
  "description": "The context functions read the caller's context: USER and INGROUP the principal, NOW and TODAY the clock, all in UTC, STATE and ID the document the formula runs over (ADR-0040). NOW is an instant, TODAY a calendar day (ADR-0023).",
  "variables": {"D": "date", "T": "datetime"},
  "cases": [
    {"formula": "USER()", "context": {"user": "alice"}, "expected": "alice"},
    {"name": "a system recompute has no user", "formula": "USER()", "expected": null},
    {"formula": "ISBLANK(USER())", "expected": true},
    {"formula": "USER() = \"alice\"", "context": {"user": "alice"}, "expected": true},
    {"formula": "USER() = \"alice\"", "context": {"user": "bob"}, "expected": false},
    {"formula": "INGROUP(\"admins\")", "context": {"user": "alice", "groups": ["staff", "admins"]}, "expected": true},
    {"formula": "INGROUP(\"admins\")", "context": {"user": "bob", "groups": ["staff"]}, "expected": false},
    {"formula": "INGROUP(\"admins\")", "expected": false},
    {"name": "group names are case-sensitive like all text", "formula": "INGROUP(\"Admins\")", "context": {"groups": ["admins"]}, "expected": false},
    {"formula": "NOW()", "context": {"now": "2024-01-31 10:30:00"}, "type": "datetime", "expected": "2024-01-31 10:30:00"},
    {"formula": "TODAY()", "context": {"now": "2024-01-31 10:30:00"}, "type": "date", "expected": "2024-01-31"},
    {"formula": "TODAY()", "context": {"now": "2024-01-31"}, "type": "date", "expected": "2024-01-31"},
    {"formula": "TODAY()", "context": {"now": "1969-12-31 23:00:00"}, "type": "date", "expected": "1969-12-31"},
    {"formula": "YEAR(TODAY())", "context": {"now": "2024-01-31 10:30:00"}, "expected": 2024},
    {"formula": "DAYS(TODAY(), D)", "context": {"now": "2024-01-31 10:30:00"}, "inputs": {"D": "2024-01-01"}, "expected": 30},
    {"formula": "DAYS(NOW(), T)", "context": {"now": "2024-01-31 01:00:00"}, "inputs": {"T": "2024-01-30 23:00:00"}, "expected": 1},
    {"formula": "DAYS(DATEOF(NOW()), D)", "context": {"now": "2024-01-31 01:00:00"}, "inputs": {"D": "2024-01-30"}, "expected": 1},
    {"formula": "NOW() > DATETIME(TODAY())", "context": {"now": "2024-01-31 10:30:00"}, "expected": true},
    {"formula": "DATEOF(NOW()) = TODAY()", "context": {"now": "2024-01-31 10:30:00"}, "expected": true},
    {"formula": "NOW() = DATETIME(TODAY())", "context": {"now": "2024-01-31"}, "expected": true},
    {"formula": "IF(D < TODAY(), \"overdue\", \"open\")", "context": {"now": "2024-01-31"}, "inputs": {"D": "2024-01-15"}, "expected": "overdue"},
    {"formula": "IF(D < TODAY(), \"overdue\", \"open\")", "context": {"now": "2024-01-31"}, "inputs": {"D": "2024-02-15"}, "expected": "open"},
    {"formula": "TEXT(ADDDAYS(TODAY(), 7))", "context": {"now": "2024-02-25 15:00:00"}, "expected": "2024-03-03"},
    {"formula": "ISBLANK(NOW())", "expected": false},
    {"formula": "STATE()", "context": {"state": "draft"}, "expected": "draft"},
    {"name": "a class without states has no state", "formula": "STATE()", "expected": null},
    {"formula": "ISBLANK(STATE())", "expected": true},
    {"formula": "ISBLANK(STATE())", "context": {"state": "draft"}, "expected": false},
    {"formula": "STATE() = \"draft\"", "context": {"state": "draft"}, "expected": true},
    {"formula": "STATE() = \"draft\"", "context": {"state": "paid"}, "expected": false},
    {"name": "the blank state compares as the empty text", "formula": "STATE() = \"\"", "expected": true},
    {"formula": "IF(STATE() = \"paid\", \"closed\", \"open\")", "context": {"state": "paid"}, "expected": "closed"},
    {"formula": "UPPER(STATE()) & \"/\" & USER()", "context": {"state": "draft", "user": "alice"}, "expected": "DRAFT/alice"},
    {"formula": "ID()", "context": {"id": "01J0W6Z8Y3Q4R5S6T7U8V9WXYZ"}, "expected": "01J0W6Z8Y3Q4R5S6T7U8V9WXYZ"},
    {"name": "no document, no id", "formula": "ID()", "expected": null},
    {"formula": "ISBLANK(ID())", "expected": true},
    {"formula": "\"INV-\" & ID()", "context": {"id": "42"}, "expected": "INV-42"},
    {"formula": "LEN(ID())", "context": {"id": "inv-1"}, "expected": 5},
    {"formula": "ID() = \"inv-1\" AND STATE() <> \"paid\"", "context": {"id": "inv-1", "state": "draft"}, "expected": true}
  ]
}
