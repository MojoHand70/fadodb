{
  "suite": "context",
  "description": "The context functions read the caller's context: USER and INGROUP the principal, NOW and TODAY the clock, all in UTC, STATE and ID the document the formula runs over (ADR-0040). The functions of the row read what the document keeps of its own life (ADR-0047): when it was created, last changed and entered its state, by whom, the state it came from, and its version. NOW is an instant, TODAY a calendar day (ADR-0023).",
  "variables": {"D": "date", "T": "datetime"},
  "cases": [
    {"formula": "USER()", "context": {"user": "alice"}, "expected": "alice"},
    {"name": "a system recompute has no user", "formula": "USER()", "expected": null},
    {"formula": "ISBLANK(USER())", "expected": true},
    {"formula": "USER() = \"alice\"", "context": {"user": "alice"}, "expected": true},
    {"formula": "USER() = \"alice\"", "context": {"user": "bob"}, "expected": false},
    {"formula": "INGROUP(\"admins\")", "context": {"user": "alice", "groups": ["staff", "admins"]}, "expected": true},
    {"formula": "INGROUP(\"admins\")", "context": {"user": "bob", "groups": ["staff"]}, "expected": false},
    {"formula": "INGROUP(\"admins\")", "expected": false},
    {"name": "group names are case-sensitive like all text", "formula": "INGROUP(\"Admins\")", "context": {"groups": ["admins"]}, "expected": false},
    {"formula": "NOW()", "context": {"now": "2024-01-31 10:30:00"}, "type": "datetime", "expected": "2024-01-31 10:30:00"},
    {"formula": "TODAY()", "context": {"now": "2024-01-31 10:30:00"}, "type": "date", "expected": "2024-01-31"},
    {"formula": "TODAY()", "context": {"now": "2024-01-31"}, "type": "date", "expected": "2024-01-31"},
    {"formula": "TODAY()", "context": {"now": "1969-12-31 23:00:00"}, "type": "date", "expected": "1969-12-31"},
    {"formula": "YEAR(TODAY())", "context": {"now": "2024-01-31 10:30:00"}, "expected": 2024},
    {"formula": "DAYS(TODAY(), D)", "context": {"now": "2024-01-31 10:30:00"}, "inputs": {"D": "2024-01-01"}, "expected": 30},
    {"formula": "DAYS(NOW(), T)", "context": {"now": "2024-01-31 01:00:00"}, "inputs": {"T": "2024-01-30 23:00:00"}, "expected": 1},
    {"formula": "DAYS(DATEOF(NOW()), D)", "context": {"now": "2024-01-31 01:00:00"}, "inputs": {"D": "2024-01-30"}, "expected": 1},
    {"formula": "NOW() > DATETIME(TODAY())", "context": {"now": "2024-01-31 10:30:00"}, "expected": true},
    {"formula": "DATEOF(NOW()) = TODAY()", "context": {"now": "2024-01-31 10:30:00"}, "expected": true},
    {"formula": "NOW() = DATETIME(TODAY())", "context": {"now": "2024-01-31"}, "expected": true},
    {"formula": "IF(D < TODAY(), \"overdue\", \"open\")", "context": {"now": "2024-01-31"}, "inputs": {"D": "2024-01-15"}, "expected": "overdue"},
    {"formula": "IF(D < TODAY(), \"overdue\", \"open\")", "context": {"now": "2024-01-31"}, "inputs": {"D": "2024-02-15"}, "expected": "open"},
    {"formula": "TEXT(ADDDAYS(TODAY(), 7))", "context": {"now": "2024-02-25 15:00:00"}, "expected": "2024-03-03"},
    {"formula": "ISBLANK(NOW())", "expected": false},
    {"formula": "STATE()", "context": {"state": "draft"}, "expected": "draft"},
    {"name": "a class without states has no state", "formula": "STATE()", "expected": null},
    {"formula": "ISBLANK(STATE())", "expected": true},
    {"formula": "ISBLANK(STATE())", "context": {"state": "draft"}, "expected": false},
    {"formula": "STATE() = \"draft\"", "context": {"state": "draft"}, "expected": true},
    {"formula": "STATE() = \"draft\"", "context": {"state": "paid"}, "expected": false},
    {"name": "the blank state compares as the empty text", "formula": "STATE() = \"\"", "expected": true},
    {"formula": "IF(STATE() = \"paid\", \"closed\", \"open\")", "context": {"state": "paid"}, "expected": "closed"},
    {"formula": "UPPER(STATE()) & \"/\" & USER()", "context": {"state": "draft", "user": "alice"}, "expected": "DRAFT/alice"},
    {"formula": "ID()", "context": {"id": "01J0W6Z8Y3Q4R5S6T7U8V9WXYZ"}, "expected": "01J0W6Z8Y3Q4R5S6T7U8V9WXYZ"},
    {"name": "no document, no id", "formula": "ID()", "expected": null},
    {"formula": "ISBLANK(ID())", "expected": true},
    {"formula": "\"INV-\" & ID()", "context": {"id": "42"}, "expected": "INV-42"},
    {"formula": "LEN(ID())", "context": {"id": "inv-1"}, "expected": 5},
    {"formula": "ID() = \"inv-1\" AND STATE() <> \"paid\"", "context": {"id": "inv-1", "state": "draft"}, "expected": true},

    {"name": "the life of the document, from its row (ADR-0047)", "formula": "CREATEDAT()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "type": "datetime", "expected": "2026-03-01 09:30:00"},
    {"formula": "CREATEDBY()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "type": "text", "expected": "ann"},
    {"formula": "UPDATEDAT()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "type": "datetime", "expected": "2026-03-09 16:45:10"},
    {"formula": "UPDATEDBY()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": "bob"},
    {"formula": "ENTEREDAT()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "type": "datetime", "expected": "2026-03-03 08:00:00"},
    {"formula": "ENTEREDBY()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": "ann"},
    {"formula": "ENTEREDFROM()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": "draft"},
    {"formula": "VERSION()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "type": "number", "expected": 7},
    {"name": "seven days in this state", "formula": "NOW() >= ADDDAYS(ENTEREDAT(), 7)", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": true},
    {"name": "and not yet eight", "formula": "NOW() >= ADDDAYS(ENTEREDAT(), 8)", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": false},
    {"name": "calendar days in the state", "formula": "DAYSBETWEEN(ENTEREDAT(), NOW())", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": 7},
    {"name": "the person who created it may not approve it", "formula": "CREATEDBY() <> USER()", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": true},
    {"formula": "CREATEDBY() <> USER()", "context": {"now": "2026-03-10 12:00:00", "user": "ann", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": false},
    {"name": "it came back from review", "formula": "ENTEREDFROM() = \"review\"", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": false},
    {"formula": "IF(ENTEREDFROM() = \"draft\", \"first time\", \"again\")", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": "first time"},
    {"name": "the day it was created", "formula": "DATEOF(CREATEDAT())", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "type": "date", "expected": "2026-03-01"},
    {"name": "who and which version, as text", "formula": "UPDATEDBY() & \" made \" & TEXT(VERSION())", "context": {"now": "2026-03-10 12:00:00", "user": "cy", "state": "review", "id": "INV-1", "version": 7, "created_at": "2026-03-01 09:30:00", "created_by": "ann", "updated_at": "2026-03-09 16:45:10", "updated_by": "bob", "entered_at": "2026-03-03 08:00:00", "entered_by": "ann", "entered_from": "draft"}, "expected": "bob made 7"},
    {"name": "every one is blank when there is no document", "formula": "ISBLANK(CREATEDAT()) AND ISBLANK(CREATEDBY()) AND ISBLANK(UPDATEDAT()) AND ISBLANK(UPDATEDBY()) AND ISBLANK(ENTEREDAT()) AND ISBLANK(ENTEREDBY()) AND ISBLANK(ENTEREDFROM()) AND ISBLANK(VERSION())", "expected": true},
    {"name": "a fact that is not set is blank, whatever else is", "formula": "ISBLANK(VERSION()) AND ISBLANK(ENTEREDAT()) AND ISBLANK(UPDATEDBY())", "context": {"created_at": "2026-03-01", "created_by": "ann"}, "expected": true},
    {"name": "nobody is blank, and a blank equals the empty text", "formula": "CREATEDBY() = \"\"", "context": {"version": 1, "created_at": "2026-03-01"}, "expected": true},
    {"name": "a document still in the state it was created in came from nowhere", "formula": "ISBLANK(ENTEREDFROM())", "context": {"version": 1, "created_at": "2026-03-01", "entered_at": "2026-03-01", "state": "draft"}, "expected": true},
    {"name": "a moment that is blank makes a difference blank, like any blank date", "formula": "DAYSBETWEEN(ENTEREDAT(), CREATEDAT())", "context": {"version": 1, "created_at": "1970-01-03"}, "expected": null}
  ]
}
