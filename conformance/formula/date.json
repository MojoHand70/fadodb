{
  "suite": "date",
  "description": "Dates are seconds since the epoch in UTC. DATE carries overflow as Excel does, ADDMONTHS and ADDYEARS clamp to the end of a shorter month, DAYS counts calendar days, the BETWEEN family counts calendar boundaries crossed, and date functions of a blank are blank (ADR-0019). Ported from the predecessor engine's date tests.",
  "variables": {"D": "date", "E": "date"},
  "cases": [
    {"formula": "DATE(2024, 1, 31)", "type": "date", "expected": "2024-01-31"},
    {"name": "day overflow carries", "formula": "DATE(2024, 2, 30)", "type": "date", "expected": "2024-03-01"},
    {"name": "month overflow carries", "formula": "DATE(2024, 14, 1)", "type": "date", "expected": "2025-02-01"},
    {"name": "month 0 is December before", "formula": "DATE(2024, 0, 1)", "type": "date", "expected": "2023-12-01"},
    {"name": "day 0 is the last day of the month before", "formula": "DATE(2024, 3, 0)", "type": "date", "expected": "2024-02-29"},
    {"name": "before 1970", "formula": "DATE(1960, 6, 15)", "type": "date", "expected": "1960-06-15"},
    {"name": "fractions truncate", "formula": "DATE(2024.7, 1.9, 31.2)", "type": "date", "expected": "2024-01-31"},
    {"formula": "DATE(2023, 2, 29)", "type": "date", "expected": "2023-03-01"},
    {"formula": "DATE(2024, 12, 32)", "type": "date", "expected": "2025-01-01"},
    {"formula": "DATE(2024, -1, 1)", "type": "date", "expected": "2023-11-01"},
    {"formula": "DATE(1, 1, 1)", "type": "date", "expected": "0001-01-01"},
    {"formula": "DATE(9999, 12, 31)", "type": "date", "expected": "9999-12-31"},
    {"formula": "DATE(10000, 1, 1)", "error": "out_of_range"},
    {"formula": "DATE(0, 12, 31)", "error": "out_of_range"},
    {"formula": "DATE(9999, 12, 32)", "error": "out_of_range"},
    {"formula": "DATEVALUE(\"2024-01-31\")", "type": "date", "expected": "2024-01-31"},
    {"formula": "DATEVALUE(\"2024-01-31 10:30:00\")", "type": "date", "expected": "2024-01-31 10:30:00"},
    {"formula": "DATEVALUE(\"1960-06-15\")", "type": "date", "expected": "1960-06-15"},
    {"formula": "DATEVALUE(\"\")", "type": "date", "expected": null},
    {"formula": "DATEVALUE(\"garbage\")", "error": "bad_text"},
    {"formula": "DATEVALUE(\"2024-02-30\")", "error": "bad_text"},
    {"formula": "DATEVALUE(\"31/01/2024\")", "error": "bad_text"},
    {"formula": "DATEVALUE(\"2024-01-31T10:30:00Z\")", "error": "bad_text"},
    {"formula": "YEAR(DATE(2024, 1, 31))", "expected": 2024},
    {"formula": "MONTH(DATE(2024, 1, 31))", "expected": 1},
    {"formula": "DAY(DATE(2024, 1, 31))", "expected": 31},
    {"formula": "QUARTER(DATE(2024, 1, 31))", "expected": 1},
    {"formula": "QUARTER(DATE(2024, 10, 1))", "expected": 4},
    {"formula": "QUARTER(DATE(2024, 6, 30))", "expected": 2},
    {"formula": "YEAR(DATE(1960, 6, 15))", "expected": 1960},
    {"formula": "MONTH(DATE(1960, 6, 15))", "expected": 6},
    {"formula": "DAY(DATE(1960, 6, 15))", "expected": 15},
    {"name": "the time of day is ignored", "formula": "DAY(DATEVALUE(\"2024-01-31 23:59:59\"))", "expected": 31},
    {"formula": "YEAR(D)", "inputs": {"D": "2024-01-31"}, "expected": 2024},
    {"formula": "MONTH(D)", "inputs": {"D": "2024-01-31 23:59:59"}, "expected": 1},
    {"formula": "DAYS(DATE(2024, 3, 1), DATE(2024, 2, 1))", "expected": 29},
    {"formula": "DAYS(DATE(2026, 1, 1), DATE(2024, 1, 31))", "expected": 701},
    {"name": "whole calendar days, not two hours", "formula": "DAYS(DATEVALUE(\"2024-01-31 01:00:00\"), DATEVALUE(\"2024-01-30 23:00:00\"))", "expected": 1},
    {"formula": "DAYS(DATE(2024, 1, 1), DATE(2024, 1, 2))", "expected": -1},
    {"formula": "DAYS(D, E)", "inputs": {"D": "2024-03-01", "E": "2024-02-01"}, "expected": 29},
    {"formula": "DAYS(D, D)", "inputs": {"D": "2024-03-01 12:00:00"}, "expected": 0},
    {"formula": "ADDDAYS(DATE(2024, 1, 31), 1)", "type": "date", "expected": "2024-02-01"},
    {"formula": "ADDDAYS(DATE(2024, 1, 31), -0.5)", "type": "date", "expected": "2024-01-30 12:00:00"},
    {"formula": "ADDDAYS(DATE(2024, 2, 28), 2)", "type": "date", "expected": "2024-03-01"},
    {"formula": "ADDDAYS(D, 7)", "inputs": {"D": "2024-12-28"}, "type": "date", "expected": "2025-01-04"},
    {"name": "clamps to the end of a shorter month, leap year", "formula": "ADDMONTHS(DATE(2024, 1, 31), 1)", "type": "date", "expected": "2024-02-29"},
    {"name": "clamps, common year", "formula": "ADDMONTHS(DATE(2024, 1, 31), 13)", "type": "date", "expected": "2025-02-28"},
    {"name": "backwards", "formula": "ADDMONTHS(DATE(2024, 3, 31), -1)", "type": "date", "expected": "2024-02-29"},
    {"name": "keeps the clock", "formula": "ADDMONTHS(DATEVALUE(\"2024-01-31 10:00:00\"), 1)", "type": "date", "expected": "2024-02-29 10:00:00"},
    {"name": "the count truncates", "formula": "ADDMONTHS(DATE(2024, 1, 15), 1.9)", "type": "date", "expected": "2024-02-15"},
    {"name": "across the year", "formula": "ADDMONTHS(DATE(2024, 11, 30), 3)", "type": "date", "expected": "2025-02-28"},
    {"formula": "ADDMONTHS(DATE(2024, 1, 15), 0)", "type": "date", "expected": "2024-01-15"},
    {"formula": "ADDMONTHS(DATE(2024, 1, 15), -13)", "type": "date", "expected": "2022-12-15"},
    {"formula": "ADDYEARS(DATE(2024, 2, 29), 1)", "type": "date", "expected": "2025-02-28"},
    {"formula": "ADDYEARS(DATE(2024, 2, 29), -4)", "type": "date", "expected": "2020-02-29"},
    {"formula": "ADDYEARS(DATE(2024, 6, 15), 10)", "type": "date", "expected": "2034-06-15"},
    {"formula": "ADDYEARS(DATE(2024, 2, 29), 4)", "type": "date", "expected": "2028-02-29"},
    {"name": "the BETWEEN family counts calendar boundaries crossed", "formula": "DAYSBETWEEN(DATE(2024, 2, 1), DATE(2024, 3, 1))", "expected": 29},
    {"formula": "DAYSBETWEEN(DATEVALUE(\"2024-01-30 23:00:00\"), DATEVALUE(\"2024-01-31 01:00:00\"))", "expected": 1},
    {"formula": "DAYSBETWEEN(DATE(2024, 1, 2), DATE(2024, 1, 1))", "expected": -1},
    {"formula": "MONTHSBETWEEN(DATE(2025, 1, 31), DATE(2025, 2, 1))", "expected": 1},
    {"formula": "MONTHSBETWEEN(DATE(2025, 1, 1), DATE(2025, 1, 31))", "expected": 0},
    {"name": "agrees with ADDMONTHS' clamp", "formula": "MONTHSBETWEEN(DATE(2025, 1, 31), DATE(2025, 2, 28))", "expected": 1},
    {"formula": "MONTHSBETWEEN(DATE(2024, 11, 15), DATE(2025, 2, 15))", "expected": 3},
    {"formula": "MONTHSBETWEEN(DATE(2025, 3, 1), DATE(2025, 1, 1))", "expected": -2},
    {"formula": "MONTHSBETWEEN(DATEVALUE(\"2024-01-31 23:59:59\"), DATE(2024, 2, 1))", "expected": 1},
    {"formula": "MONTHSBETWEEN(DATE(1960, 6, 15), DATE(1970, 1, 1))", "expected": 115},
    {"formula": "MONTHSBETWEEN(D, ADDMONTHS(D, 13))", "inputs": {"D": "2024-01-31"}, "expected": 13},
    {"formula": "MONTHSBETWEEN(D, ADDMONTHS(D, -25))", "inputs": {"D": "2024-02-29"}, "expected": -25},
    {"formula": "YEARSBETWEEN(DATE(2025, 12, 31), DATE(2026, 1, 1))", "expected": 1},
    {"formula": "YEARSBETWEEN(DATE(2025, 1, 1), DATE(2025, 12, 31))", "expected": 0},
    {"name": "agrees with ADDYEARS' clamp", "formula": "YEARSBETWEEN(DATE(2024, 2, 29), DATE(2025, 2, 28))", "expected": 1},
    {"formula": "YEARSBETWEEN(DATE(2026, 1, 1), DATE(2024, 12, 31))", "expected": -2},
    {"formula": "YEARSBETWEEN(DATE(1960, 6, 15), DATE(2024, 1, 1))", "expected": 64},
    {"formula": "YEARSBETWEEN(D, ADDYEARS(D, 48))", "inputs": {"D": "2024-02-29"}, "expected": 48},
    {"name": "date functions of a blank are blank", "formula": "YEAR(D)", "expected": null},
    {"formula": "MONTH(D)", "expected": null},
    {"formula": "DAY(D)", "expected": null},
    {"formula": "QUARTER(D)", "expected": null},
    {"formula": "DAYS(D, DATE(2024, 1, 1))", "expected": null},
    {"formula": "DAYS(DATE(2024, 1, 1), D)", "expected": null},
    {"formula": "DAYSBETWEEN(D, DATE(2024, 1, 1))", "expected": null},
    {"formula": "MONTHSBETWEEN(DATE(2024, 1, 1), D)", "expected": null},
    {"formula": "YEARSBETWEEN(D, DATE(2024, 1, 1))", "expected": null},
    {"formula": "ADDDAYS(D, 1)", "type": "date", "expected": null},
    {"formula": "ADDMONTHS(D, 1)", "type": "date", "expected": null},
    {"formula": "ADDYEARS(D, 1)", "type": "date", "expected": null},
    {"formula": "ISBLANK(ADDDAYS(D, 1))", "expected": true},
    {"formula": "IF(ISBLANK(D), \"open\", \"due \" & TEXT(D))", "inputs": {"D": "2024-01-31"}, "expected": "due 2024-01-31"},
    {"formula": "IF(ISBLANK(D), \"open\", \"due \" & TEXT(D))", "expected": "open"},
    {"name": "comparison is by instant; a blank date reads as the epoch", "formula": "DATE(2024, 1, 1) < DATE(2024, 1, 2)", "expected": true},
    {"formula": "DATE(2024, 1, 1) = DATEVALUE(\"2024-01-01\")", "expected": true},
    {"formula": "DATEVALUE(\"2024-01-01 00:00:01\") > DATE(2024, 1, 1)", "expected": true},
    {"formula": "D < DATE(2024, 1, 1)", "expected": true},
    {"formula": "D = DATEVALUE(\"1970-01-01\")", "expected": true},
    {"formula": "D < E", "inputs": {"D": "2024-01-31", "E": "2024-02-01"}, "expected": true},
    {"formula": "D >= E", "inputs": {"D": "2024-01-31", "E": "2024-02-01"}, "expected": false},
    {"formula": "D = E", "inputs": {"D": "2024-01-31", "E": "2024-01-31"}, "expected": true},
    {"formula": "DATE(1969, 12, 31) < DATE(1970, 1, 1)", "expected": true},
    {"name": "arithmetic on dates goes through functions", "formula": "DAYS(ADDDAYS(D, 30), D)", "inputs": {"D": "2024-01-31"}, "expected": 30},
    {"formula": "ADDDAYS(DATE(2024, 1, 31), DAYS(DATE(2024, 3, 1), DATE(2024, 2, 1)))", "type": "date", "expected": "2024-02-29"},
    {"formula": "ADDMONTHS(D, 1) > D", "inputs": {"D": "2024-01-31"}, "expected": true},
    {"formula": "TEXT(ADDMONTHS(DATE(2024, 1, 31), 1))", "expected": "2024-02-29"},
    {"name": "months and days carry by the calendar, far as they like, within year 1 to 9999", "formula": "DATE(2000, 0, 0)", "type": "date", "expected": "1999-11-30"},
    {"formula": "DATE(2000, -11, 1)", "type": "date", "expected": "1999-01-01"},
    {"formula": "DATE(2000, 25, 1)", "type": "date", "expected": "2002-01-01"},
    {"formula": "DATE(2000, 1, 366)", "type": "date", "expected": "2000-12-31"},
    {"formula": "DATE(2001, 1, 366)", "type": "date", "expected": "2002-01-01"},
    {"formula": "DATE(1, 1, 1)", "type": "date", "expected": "0001-01-01"},
    {"formula": "DATE(9999, 12, 31)", "type": "date", "expected": "9999-12-31"},
    {"formula": "DATE(1000, 1, 3000000)", "type": "date", "expected": "9213-09-20"},
    {"formula": "DATE(2000, 1, -300000)", "type": "date", "expected": "1178-08-17"},
    {"formula": "DATE(1600, 2, 29)", "type": "date", "expected": "1600-02-29"},
    {"formula": "DATE(1700, 2, 29)", "type": "date", "expected": "1700-03-01"},
    {"name": "a result outside year 1 to 9999 is out of range, however the month and the day combine", "formula": "DATE(1, 1, 0)", "error": "out_of_range"},
    {"formula": "DATE(9999, 12, 32)", "error": "out_of_range"},
    {"formula": "DATE(9999, 13, 1)", "error": "out_of_range"},
    {"formula": "DATE(2000, 1, 3000000)", "error": "out_of_range"},
    {"formula": "DATE(1942, -968801, 99950000)", "error": "out_of_range"},
    {"formula": "DATE(2000, 1, 1000000000.0)", "error": "out_of_range"},
    {"formula": "DATE(2000, 10000000.0, 1)", "error": "out_of_range"},
    {"formula": "DATE(1000000.0, 1, 1)", "error": "out_of_range"}
  ]
}
