{
  "suite": "datetime",
  "description": "A datetime is an instant, seconds since the epoch in UTC (ADR-0023); a date is a calendar day. DATETIMEVALUE reads an instant, DATEOF takes an instant's UTC day, DATETIME is a day's midnight, the date functions take either kind, DAYS and the BETWEEN family need two of one kind, ADDDAYS keeps fractions of a day on an instant, and TEXT always shows the clock. The cases with a time of day of the predecessor engine's date tests live here.",
  "variables": {"T": "datetime", "U": "datetime", "D": "date"},
  "cases": [
    {"formula": "DATETIMEVALUE(\"2024-01-31 10:30:00\")", "type": "datetime", "expected": "2024-01-31 10:30:00"},
    {"name": "a date-only text is midnight", "formula": "DATETIMEVALUE(\"2024-01-31\")", "type": "datetime", "expected": "2024-01-31 00:00:00"},
    {"formula": "DATETIMEVALUE(\"1960-06-15 23:59:59\")", "type": "datetime", "expected": "1960-06-15 23:59:59"},
    {"formula": "DATETIMEVALUE(\"0001-01-01 00:00:00\")", "type": "datetime", "expected": "0001-01-01 00:00:00"},
    {"formula": "DATETIMEVALUE(\"9999-12-31 23:59:59\")", "type": "datetime", "expected": "9999-12-31 23:59:59"},
    {"formula": "DATETIMEVALUE(\"\")", "type": "datetime", "expected": null},
    {"formula": "DATETIMEVALUE(\"garbage\")", "error": "bad_text"},
    {"formula": "DATETIMEVALUE(\"2024-02-30 10:00:00\")", "error": "bad_text"},
    {"formula": "DATETIMEVALUE(\"2024-01-31T10:30:00Z\")", "error": "bad_text"},
    {"formula": "DATETIMEVALUE(\"2024-01-31 24:00:00\")", "error": "bad_text"},
    {"formula": "DATETIMEVALUE(\"2024-01-31 10:30\")", "error": "bad_text"},
    {"name": "DATEOF is the UTC day, DATETIME its midnight", "formula": "DATEOF(T)", "inputs": {"T": "2024-01-31 23:59:59"}, "type": "date", "expected": "2024-01-31"},
    {"formula": "DATEOF(T)", "inputs": {"T": "2024-01-31 00:00:00"}, "type": "date", "expected": "2024-01-31"},
    {"formula": "DATEOF(T)", "inputs": {"T": "1969-12-31 23:00:00"}, "type": "date", "expected": "1969-12-31"},
    {"formula": "DATEOF(T)", "type": "date", "expected": null},
    {"formula": "DATETIME(D)", "inputs": {"D": "2024-01-31"}, "type": "datetime", "expected": "2024-01-31 00:00:00"},
    {"formula": "DATETIME(DATE(1960, 6, 15))", "type": "datetime", "expected": "1960-06-15 00:00:00"},
    {"formula": "DATETIME(D)", "type": "datetime", "expected": null},
    {"formula": "DATEOF(DATETIME(D)) = D", "inputs": {"D": "2024-01-31"}, "expected": true},
    {"formula": "DATETIME(DATEOF(T)) <= T", "inputs": {"T": "2024-01-31 10:30:00"}, "expected": true},
    {"name": "the date functions take an instant and ignore the clock", "formula": "YEAR(T)", "inputs": {"T": "2024-01-31 23:59:59"}, "expected": 2024},
    {"formula": "MONTH(T)", "inputs": {"T": "2024-01-31 23:59:59"}, "expected": 1},
    {"formula": "DAY(T)", "inputs": {"T": "2024-01-31 23:59:59"}, "expected": 31},
    {"formula": "QUARTER(T)", "inputs": {"T": "2024-10-01 00:00:01"}, "expected": 4},
    {"formula": "DAY(DATETIMEVALUE(\"2024-01-31 23:59:59\"))", "expected": 31},
    {"formula": "YEAR(T)", "expected": null},
    {"formula": "QUARTER(T)", "expected": null},
    {"name": "whole calendar days, not two hours", "formula": "DAYS(DATETIMEVALUE(\"2024-01-31 01:00:00\"), DATETIMEVALUE(\"2024-01-30 23:00:00\"))", "expected": 1},
    {"formula": "DAYS(T, U)", "inputs": {"T": "2024-03-01 12:00:00", "U": "2024-02-01 00:00:00"}, "expected": 29},
    {"formula": "DAYS(T, T)", "inputs": {"T": "2024-03-01 12:00:00"}, "expected": 0},
    {"formula": "DAYS(T, U)", "inputs": {"T": "2024-03-01 12:00:00"}, "expected": null},
    {"formula": "DAYSBETWEEN(DATETIMEVALUE(\"2024-01-30 23:00:00\"), DATETIMEVALUE(\"2024-01-31 01:00:00\"))", "expected": 1},
    {"formula": "MONTHSBETWEEN(DATETIMEVALUE(\"2024-01-31 23:59:59\"), DATETIME(DATE(2024, 2, 1)))", "expected": 1},
    {"formula": "YEARSBETWEEN(T, U)", "inputs": {"T": "2025-12-31 23:59:59", "U": "2026-01-01 00:00:00"}, "expected": 1},
    {"formula": "DAYS(DATEOF(T), D)", "inputs": {"T": "2024-01-31 01:00:00", "D": "2024-01-30"}, "expected": 1},
    {"name": "ADDDAYS keeps fractions of a day on an instant", "formula": "ADDDAYS(T, -0.5)", "inputs": {"T": "2024-01-31 00:00:00"}, "type": "datetime", "expected": "2024-01-30 12:00:00"},
    {"formula": "ADDDAYS(T, 1)", "inputs": {"T": "2024-01-31 10:30:00"}, "type": "datetime", "expected": "2024-02-01 10:30:00"},
    {"formula": "ADDDAYS(T, 0.25)", "inputs": {"T": "2024-01-31 00:00:00"}, "type": "datetime", "expected": "2024-01-31 06:00:00"},
    {"formula": "ADDDAYS(T, 1)", "type": "datetime", "expected": null},
    {"formula": "ADDDAYS(T, 1e12)", "inputs": {"T": "2024-01-31 00:00:00"}, "error": "out_of_range"},
    {"formula": "ADDDAYS(DATETIMEVALUE(\"9999-12-31 23:59:59\"), 1)", "error": "out_of_range"},
    {"name": "ADDMONTHS and ADDYEARS keep the clock and clamp the day", "formula": "ADDMONTHS(DATETIMEVALUE(\"2024-01-31 10:00:00\"), 1)", "type": "datetime", "expected": "2024-02-29 10:00:00"},
    {"formula": "ADDMONTHS(T, -1)", "inputs": {"T": "2024-03-31 23:59:59"}, "type": "datetime", "expected": "2024-02-29 23:59:59"},
    {"formula": "ADDYEARS(T, 1)", "inputs": {"T": "2024-02-29 10:00:00"}, "type": "datetime", "expected": "2025-02-28 10:00:00"},
    {"formula": "ADDMONTHS(T, 1)", "type": "datetime", "expected": null},
    {"formula": "ADDYEARS(T, 8000)", "inputs": {"T": "2024-02-29 10:00:00"}, "error": "out_of_range"},
    {"name": "comparison is by instant; a blank reads as the epoch", "formula": "DATETIMEVALUE(\"2024-01-01 00:00:01\") > DATETIME(DATE(2024, 1, 1))", "expected": true},
    {"formula": "T < U", "inputs": {"T": "2024-01-31 10:30:00", "U": "2024-01-31 10:30:01"}, "expected": true},
    {"formula": "T = U", "inputs": {"T": "2024-01-31 10:30:00", "U": "2024-01-31 10:30:00"}, "expected": true},
    {"formula": "T = BLANK", "expected": true},
    {"formula": "T = DATETIMEVALUE(\"1970-01-01\")", "expected": true},
    {"formula": "T < DATETIMEVALUE(\"1970-01-01 00:00:01\")", "expected": true},
    {"name": "TEXT always shows the clock", "formula": "TEXT(T)", "inputs": {"T": "2024-01-31 10:30:00"}, "expected": "2024-01-31 10:30:00"},
    {"formula": "TEXT(T)", "inputs": {"T": "2024-01-31 00:00:00"}, "expected": "2024-01-31 00:00:00"},
    {"formula": "TEXT(T)", "expected": ""},
    {"formula": "\"at \" & T", "inputs": {"T": "1960-06-15 23:59:59"}, "expected": "at 1960-06-15 23:59:59"},
    {"formula": "TEXT(DATEOF(T))", "inputs": {"T": "2024-01-31 10:30:00"}, "expected": "2024-01-31"},
    {"formula": "ISBLANK(T)", "expected": true},
    {"formula": "ISBLANK(ADDDAYS(T, 1))", "expected": true},
    {"formula": "IF(T > DATETIME(D), \"late\", \"on time\")", "inputs": {"T": "2024-01-31 00:00:01", "D": "2024-01-31"}, "expected": "late"}
  ]
}
