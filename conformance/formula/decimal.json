    {"formula": "ROUND(A / 3, 2, \"half_up\")", "inputs": {"A": 2.00}, "type": "decimal(2)", "expected": "0.67"},
    {"formula": "ROUND(A / 3, 2, \"half_even\")", "inputs": {"A": 2.00}, "type": "decimal(2)", "expected": "0.67"},
