{
  "suite": "decimal",
  "description": "Exact numbers (ADR-0022): a decimal is an int64 mantissa at a scale of 0 to 18, int is scale 0. + and - are exact at the larger scale, * at the sum of the scales, / lands on the dividend's scale plus four rounding half away from zero, % adds two places. A number literal that meets an exact operand is read exactly from its spelling. ROUND, FLOOR, CEILING, TRUNC and DECIMAL take their places from the formula and a method; a result that does not fit 18 digits is the error overflow. Blank reads as 0.",
  "variables": {"A": "decimal(2)", "B": "decimal(4)", "I": "int", "N": "number", "T": "text", "Z": "decimal(2)"},
  "cases": [
    {"name": "0.10 + 0.20 is 0.30, exactly", "formula": "A + B", "inputs": {"A": 0.10, "B": 0.2}, "type": "decimal(4)", "expected": 0.3},
    {"formula": "A + 0.2 = 0.3", "inputs": {"A": 0.1}, "expected": true},
    {"formula": "A + B = 0.3", "inputs": {"A": 0.10, "B": 0.2000}, "expected": true},
    {"formula": "A = 0.30", "inputs": {"A": "0.3"}, "expected": true},
    {"name": "+ and - land on the larger scale", "formula": "A + B", "inputs": {"A": 1.50, "B": 0.0001}, "type": "decimal(4)", "expected": "1.5001"},
    {"formula": "A - B", "inputs": {"A": 1.50, "B": 0.0001}, "type": "decimal(4)", "expected": "1.4999"},
    {"formula": "B - A", "inputs": {"A": 1.50, "B": 0.0001}, "type": "decimal(4)", "expected": "-1.4999"},
    {"formula": "A + 1", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "2.50"},
    {"formula": "1 - A", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "-0.50"},
    {"formula": "A + 0.125", "inputs": {"A": 1.50}, "type": "decimal(3)", "expected": "1.625"},
    {"name": "* adds the scales and is exact", "formula": "A * B", "inputs": {"A": 1.50, "B": 2}, "type": "decimal(6)", "expected": "3.000000"},
    {"formula": "A * 3", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "4.50"},
    {"formula": "A * 1.5", "inputs": {"A": 1.50}, "type": "decimal(3)", "expected": "2.250"},
    {"formula": "A * A", "inputs": {"A": 0.10}, "type": "decimal(4)", "expected": "0.0100"},
    {"formula": "A * A * A", "inputs": {"A": 0.10}, "type": "decimal(6)", "expected": "0.001000"},
    {"formula": "I * I", "inputs": {"I": 123456789}, "type": "int", "expected": 15241578750190521},
    {"name": "/ lands on the dividend's scale plus four, half away from zero", "formula": "A / 3", "inputs": {"A": 1.00}, "type": "decimal(6)", "expected": "0.333333"},
    {"formula": "A / B", "inputs": {"A": 1.00, "B": 3}, "type": "decimal(6)", "expected": "0.333333"},
    {"formula": "I / 3", "inputs": {"I": 1}, "type": "decimal(4)", "expected": "0.3333"},
    {"formula": "I / 4", "inputs": {"I": 1}, "type": "decimal(4)", "expected": "0.2500"},
    {"formula": "I / 3", "inputs": {"I": 2}, "type": "decimal(4)", "expected": "0.6667"},
    {"formula": "I / 6", "inputs": {"I": -1}, "type": "decimal(4)", "expected": "-0.1667"},
    {"formula": "I / 8", "inputs": {"I": 5}, "type": "decimal(4)", "expected": "0.6250"},
    {"formula": "A / 7", "inputs": {"A": 0.01}, "type": "decimal(6)", "expected": "0.001429"},
    {"formula": "A / 0.5", "inputs": {"A": 1.00}, "type": "decimal(6)", "expected": "2.000000"},
    {"formula": "I / 2", "inputs": {"I": 3}, "type": "decimal(4)", "expected": "1.5000"},
    {"name": "the tie rounds away from zero", "formula": "I / 8", "inputs": {"I": 1}, "type": "decimal(4)", "expected": "0.1250"},
    {"formula": "I / 16", "inputs": {"I": 1}, "type": "decimal(4)", "expected": "0.0625"},
    {"formula": "I / 32", "inputs": {"I": 1}, "type": "decimal(4)", "expected": "0.0313"},
    {"formula": "I / 32", "inputs": {"I": -1}, "type": "decimal(4)", "expected": "-0.0313"},
    {"name": "division by zero is an error, a blank divisor included", "formula": "A / 0", "inputs": {"A": 1.00}, "error": "div_by_zero"},
    {"formula": "A / B", "inputs": {"A": 1.00}, "error": "div_by_zero"},
    {"formula": "A \\ B", "inputs": {"A": 1.00}, "error": "div_by_zero"},
    {"formula": "I / 0.0", "inputs": {"I": 1}, "error": "div_by_zero"},
    {"name": "percent adds two places", "formula": "A%", "inputs": {"A": 23.00}, "type": "decimal(4)", "expected": "0.2300"},
    {"formula": "23% * A", "inputs": {"A": 100.00}, "type": "decimal(4)", "expected": "23.0000"},
    {"formula": "A * 23%", "inputs": {"A": 100.00}, "type": "decimal(4)", "expected": "23.0000"},
    {"formula": "I%", "inputs": {"I": 5}, "type": "decimal(2)", "expected": "0.05"},
    {"formula": "I%%", "inputs": {"I": 5}, "type": "decimal(4)", "expected": "0.0005"},
    {"name": "unary minus", "formula": "-A", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "-1.50"},
    {"formula": "--A", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "1.50"},
    {"formula": "-(A + B)", "inputs": {"A": 1.50, "B": 0.0001}, "type": "decimal(4)", "expected": "-1.5001"},
    {"formula": "A - -1.5", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "3.00"},
    {"name": "a bool reads as 1 or 0", "formula": "A + TRUE", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "2.50"},
    {"formula": "I * FALSE", "inputs": {"I": 7}, "type": "int", "expected": 0},
    {"formula": "A * (A > 1)", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "1.50"},
    {"name": "blank reads as 0 of the result's scale", "formula": "A + BLANK", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "1.50"},
    {"formula": "BLANK + A", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "1.50"},
    {"formula": "A + B", "inputs": {"B": 0.0001}, "type": "decimal(4)", "expected": "0.0001"},
    {"formula": "A + B", "type": "decimal(4)", "expected": "0.0000"},
    {"formula": "A * B", "inputs": {"A": 1.50}, "type": "decimal(6)", "expected": "0.000000"},
    {"formula": "B / A", "inputs": {"A": 1.50}, "type": "decimal(8)", "expected": "0.00000000"},
    {"formula": "-A", "type": "decimal(2)", "expected": "0.00"},
    {"formula": "A%", "type": "decimal(4)", "expected": "0.0000"},
    {"formula": "ISBLANK(A + B)", "expected": false},
    {"formula": "ISBLANK(A)", "expected": true},
    {"formula": "A = BLANK", "inputs": {"A": 0}, "expected": true},
    {"formula": "A > BLANK", "inputs": {"A": 0.01}, "expected": true},
    {"formula": "BLANK < A", "inputs": {"A": 0.01}, "expected": true},
    {"name": "comparison is by value across scales", "formula": "A < B", "inputs": {"A": 1.50, "B": 1.5001}, "expected": true},
    {"formula": "A = B", "inputs": {"A": 1.50, "B": 1.5}, "expected": true},
    {"formula": "A <> B", "inputs": {"A": 1.50, "B": 1.5}, "expected": false},
    {"formula": "A >= 1.5", "inputs": {"A": 1.50}, "expected": true},
    {"formula": "A > 1.499", "inputs": {"A": 1.50}, "expected": true},
    {"formula": "I = 7", "inputs": {"I": 7}, "expected": true},
    {"formula": "I < 7.5", "inputs": {"I": 7}, "expected": true},
    {"formula": "-A < A", "inputs": {"A": 0.01}, "expected": true},
    {"formula": "A < I", "inputs": {"A": 9999999999999999.99, "I": 9999999999999999}, "expected": false},
    {"formula": "A > I", "inputs": {"A": 9999999999999999.99, "I": 9999999999999999}, "expected": true},
    {"name": "int arithmetic stays int", "formula": "I + 1", "inputs": {"I": 2}, "type": "int", "expected": 3},
    {"formula": "I - 5", "inputs": {"I": 2}, "type": "int", "expected": -3},
    {"formula": "I * 2 + 1", "inputs": {"I": 2}, "type": "int", "expected": 5},
    {"formula": "I + A", "inputs": {"I": 2, "A": 0.50}, "type": "decimal(2)", "expected": "2.50"},
    {"name": "the aggregates run on one family at the largest scale, blanks skipped", "formula": "SUM(A, B, 1)", "inputs": {"A": 1.50, "B": 0.0001}, "type": "decimal(4)", "expected": "2.5001"},
    {"formula": "SUM(A, B)", "inputs": {"B": 0.0001}, "type": "decimal(4)", "expected": "0.0001"},
    {"formula": "SUM(A)", "type": "decimal(2)", "expected": "0.00"},
    {"formula": "SUM(A, 0.5)", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "2.00"},
    {"formula": "SUM(A, A, A, A, A, A, A, A, A, A)", "inputs": {"A": 0.01}, "type": "decimal(2)", "expected": "0.10"},
    {"formula": "AVERAGE(A, B)", "inputs": {"A": 1.50, "B": 0.0001}, "type": "decimal(8)", "expected": "0.75005000"},
    {"formula": "AVERAGE(A, 2)", "inputs": {"A": 1.00}, "type": "decimal(6)", "expected": "1.500000"},
    {"formula": "AVERAGE(A, B)", "type": "decimal(8)", "expected": null},
    {"formula": "AVERAGE(A, B)", "inputs": {"A": 1.00}, "type": "decimal(8)", "expected": "1.00000000"},
    {"formula": "AVERAGE(I, 2)", "inputs": {"I": 1}, "type": "decimal(4)", "expected": "1.5000"},
    {"formula": "MIN(A, B)", "inputs": {"A": 1.50, "B": 1.4999}, "type": "decimal(4)", "expected": "1.4999"},
    {"formula": "MAX(A, B)", "inputs": {"A": 1.50, "B": 1.4999}, "type": "decimal(4)", "expected": "1.5000"},
    {"formula": "MAX(A, 2)", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "2.00"},
    {"formula": "MIN(A, B)", "inputs": {"B": 1.4999}, "type": "decimal(4)", "expected": "1.4999"},
    {"formula": "MIN(A, B)", "type": "decimal(4)", "expected": null},
    {"formula": "MIN(A, -1)", "inputs": {"A": 0}, "type": "decimal(2)", "expected": "-1.00"},
    {"formula": "COUNT(A, B, I)", "inputs": {"A": 1.50}, "expected": 1},
    {"name": "MOD takes the sign of the divisor", "formula": "MOD(A, 0.4)", "inputs": {"A": 1.00}, "type": "decimal(2)", "expected": "0.20"},
    {"formula": "MOD(A, -0.4)", "inputs": {"A": 1.00}, "type": "decimal(2)", "expected": "-0.20"},
    {"formula": "MOD(-A, 0.4)", "inputs": {"A": 1.00}, "type": "decimal(2)", "expected": "0.20"},
    {"formula": "MOD(I, 3)", "inputs": {"I": -7}, "type": "int", "expected": 2},
    {"formula": "MOD(I, 3)", "inputs": {"I": 7}, "type": "int", "expected": 1},
    {"formula": "MOD(A, B)", "inputs": {"A": 1.00, "B": 0.0003}, "type": "decimal(4)", "expected": "0.0001"},
    {"formula": "MOD(A, 0)", "inputs": {"A": 1.00}, "error": "div_by_zero"},
    {"formula": "MOD(A, B)", "inputs": {"A": 1.00}, "error": "div_by_zero"},
    {"name": "ABS keeps the type, SIGN gives an int", "formula": "ABS(-A)", "inputs": {"A": 1.50}, "type": "decimal(2)", "expected": "1.50"},
    {"formula": "ABS(A)", "inputs": {"A": -1.50}, "type": "decimal(2)", "expected": "1.50"},
    {"formula": "ABS(A)", "type": "decimal(2)", "expected": "0.00"},
    {"formula": "SIGN(A)", "inputs": {"A": -1.50}, "type": "int", "expected": -1},
    {"formula": "SIGN(A)", "inputs": {"A": 1.50}, "type": "int", "expected": 1},
    {"formula": "SIGN(A)", "type": "int", "expected": 0},
