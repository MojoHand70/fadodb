{
  "suite": "iferror",
  "description": "IFERROR(value, fallback) is the value, or the fallback when evaluating the value stops with an error (ADR-0024). Only errors inside the value are caught; an error in the fallback, or outside, propagates. A blank is a value, not an error.",
  "variables": {"N": "number", "T": "text", "A": "decimal(2)", "D": "date"},
  "cases": [
    {"formula": "IFERROR(1 / 0, -1)", "expected": -1},
    {"formula": "IFERROR(10 / 2, -1)", "expected": 5},
    {"formula": "IFERROR(N / 0, BLANK)", "inputs": {"N": 1}, "expected": null},
    {"formula": "IFERROR(N / N, 0)", "expected": 0},
    {"formula": "IFERROR(N, 1)", "expected": null},
    {"formula": "IFERROR(VALUE(T), 0)", "inputs": {"T": "abc"}, "expected": 0},
    {"formula": "IFERROR(VALUE(T), 0)", "inputs": {"T": "1.5"}, "expected": 1.5},
    {"formula": "IFERROR(DATEVALUE(T), DATE(2000, 1, 1))", "inputs": {"T": "garbage"}, "type": "date", "expected": "2000-01-01"},
    {"formula": "IFERROR(DATEVALUE(T), D)", "inputs": {"T": "2024-02-29"}, "type": "date", "expected": "2024-02-29"},
    {"name": "the branches join at the larger scale", "formula": "IFERROR(A / 0, A)", "inputs": {"A": 1.50}, "type": "decimal(6)", "expected": "1.500000"},
    {"formula": "IFERROR(A / 3, 0)", "inputs": {"A": 1.50}, "type": "decimal(6)", "expected": "0.500000"},
    {"formula": "IFERROR(DECIMALVALUE(T, 2), 0)", "inputs": {"T": "x"}, "type": "decimal(2)", "expected": "0.00"},
    {"formula": "IFERROR(SQRT(-1), 0)", "expected": 0},
    {"formula": "IFERROR(LEFT(T, -1), \"\")", "inputs": {"T": "abc"}, "expected": ""},
    {"formula": "IFERROR(\"a\" & 1 / 0, \"b\")", "expected": "b"},
    {"formula": "IFERROR(MOD(N, 0), 7)", "inputs": {"N": 3}, "expected": 7},
    {"name": "nested", "formula": "IFERROR(IFERROR(1 / 0, 1 / 0), 7)", "expected": 7},
    {"formula": "IFERROR(IFERROR(1 / 0, 2), 7)", "expected": 2},
    {"formula": "IFERROR(1 + IFERROR(1 / 0, 2), 7)", "expected": 3},
    {"name": "an error in the fallback propagates", "formula": "IFERROR(1 / 0, 1 / 0)", "error": "div_by_zero"},
    {"formula": "IFERROR(1 / 0, SQRT(-1))", "error": "not_a_number"},
    {"name": "an error outside propagates", "formula": "IFERROR(1, 2) / 0", "error": "div_by_zero"},
    {"formula": "IFERROR(1 / 0, 2) + 1 / 0", "error": "div_by_zero"},
    {"formula": "IFERROR(1 / 0, 2) + IFERROR(3, 4) = 5", "expected": true},
    {"name": "an error anywhere inside the value is caught", "formula": "IFERROR(IF(1 / 0 > 1, 1, 2), 3)", "expected": 3},
    {"formula": "IFERROR(IF(N > 0, 1 / 0, 2), 3)", "inputs": {"N": 1}, "expected": 3},
    {"formula": "IFERROR(IF(N > 0, 1 / 0, 2), 3)", "inputs": {"N": -1}, "expected": 2},
    {"formula": "IFERROR(SUM(1, 2, 1 / 0), 0)", "expected": 0},
    {"formula": "IFERROR(ROUND(1 / 0, 2), 0)", "expected": 0},
    {"formula": "IFERROR(1 / 0 > 1 AND TRUE, FALSE)", "expected": false},
    {"formula": "IFERROR(TRUE OR 1 / 0 > 1, FALSE)", "expected": true},
    {"name": "the result is a condition or a value like any other", "formula": "IF(IFERROR(1 / N, 0) > 0, \"ok\", \"zero\")", "inputs": {"N": 2}, "expected": "ok"},
    {"formula": "IF(IFERROR(1 / N, 0) > 0, \"ok\", \"zero\")", "expected": "zero"},
    {"formula": "TEXT(IFERROR(1 / 0, 0.5))", "expected": "0.5"},
    {"formula": "IFERROR(1 / 0, 0) = 0", "expected": true},
    {"formula": "ISBLANK(IFERROR(1 / 0, BLANK))", "expected": true}
  ]
}
