{
  "suite": "limits",
  "description": "The text limit of ADR-0021 at a small setting, 64 code points: a result longer than max_text is out_of_range, decided before it is built, on every text builder; a count past the end of a text reads to the end.",
  "limits": {"max_text": 64},
  "variables": {"Code": "text"},
  "cases": [
    {"name": "a result at the limit is fine, one past it is out of range", "formula": "LEN(REPEAT(\"ab\", 32))", "expected": 64},
    {"formula": "REPEAT(\"ab\", 33)", "error": "out_of_range"},
    {"formula": "REPEAT(\"ab\", 1e300)", "error": "out_of_range"},
    {"name": "the empty text repeats to the empty text however often", "formula": "REPEAT(\"\", 1e300)", "expected": ""},
    {"formula": "LEN(PAD(\"7\", 64, \"0\"))", "expected": 64},
    {"formula": "PAD(\"7\", 65, \"0\")", "error": "out_of_range"},
    {"formula": "PAD(\"7\", 1e300)", "error": "out_of_range"},
    {"name": "concatenation adds the lengths up before it joins", "formula": "LEN(REPEAT(\"x\", 60) & \"abcd\")", "expected": 64},
    {"formula": "REPEAT(\"x\", 60) & \"abcde\"", "error": "out_of_range"},
    {"formula": "LEN(REPEAT(\"x\", 60) & 1234)", "expected": 64},
    {"formula": "REPEAT(\"x\", 60) & 12345", "error": "out_of_range"},
    {"formula": "LEN(CONCAT(REPEAT(\"x\", 30), REPEAT(\"y\", 30), \"abcd\"))", "expected": 64},
    {"formula": "CONCAT(REPEAT(\"x\", 30), REPEAT(\"y\", 30), \"abcde\")", "error": "out_of_range"},
    {"name": "a chain stays bounded: the first overflow is the error", "formula": "(REPEAT(\"x\", 60) & \"abcde\") & \"\"", "error": "out_of_range"},
    {"name": "SUBSTITUTE counts the occurrences first", "formula": "LEN(SUBSTITUTE(REPEAT(\"a-\", 16), \"-\", \"xyz\"))", "expected": 64},
    {"formula": "SUBSTITUTE(REPEAT(\"a-\", 16), \"-\", \"wxyz\")", "error": "out_of_range"},
    {"formula": "SUBSTITUTE(REPEAT(\"a\", 64), \"a\", \"\")", "expected": ""},
    {"formula": "LEN(SUBSTITUTE(REPEAT(\"a\", 64), \"\", REPEAT(\"b\", 64)))", "expected": 64},
    {"name": "REPLACE reads the position and the length clamped to the text", "formula": "LEN(REPLACE(REPEAT(\"x\", 60), 2, 2, \"abcdef\"))", "expected": 64},
    {"formula": "REPLACE(REPEAT(\"x\", 60), 2, 2, \"abcdefg\")", "error": "out_of_range"},
    {"formula": "REPLACE(\"abcdef\", 2, 1e300, \"XYZW\")", "expected": "aXYZW"},
    {"formula": "REPLACE(\"abc\", 100, 0, \"XYZW\")", "expected": "abcXYZW"},
    {"name": "REGEXREPLACE counts the matches first", "formula": "LEN(REGEXREPLACE(REPEAT(\"a1\", 16), \"[0-9]\", \"###\"))", "expected": 64},
    {"formula": "REGEXREPLACE(REPEAT(\"a1\", 16), \"[0-9]\", \"####\")", "error": "out_of_range"},
    {"name": "an empty match counts once per position, never right after a match", "formula": "REGEXREPLACE(\"abc\", \"\", \"-\")", "expected": "-a-b-c-"},
    {"formula": "LEN(REGEXREPLACE(REPEAT(\"x\", 31), \"\", \"-\"))", "expected": 63},
    {"formula": "REGEXREPLACE(REPEAT(\"x\", 32), \"\", \"-\")", "error": "out_of_range"},
    {"formula": "REGEXREPLACE(\"aaa\", \"a*\", \"-\")", "expected": "-"},
    {"formula": "REGEXREPLACE(\"abc\", \"x*\", \"-\")", "expected": "-a-b-c-"},
    {"formula": "REGEXREPLACE(\"abcab\", \"(ab)+\", \"1234\")", "expected": "1234c1234"},
    {"name": "a count past the end of the text reads to the end", "formula": "LEFT(\"abc\", 1e300)", "expected": "abc"},
    {"formula": "RIGHT(\"abc\", 1e300)", "expected": "abc"},
    {"formula": "MID(\"abc\", 2, 1e300)", "expected": "bc"},
    {"formula": "MID(\"abc\", 1e300)", "expected": ""},
    {"formula": "LEFT(\"abc\", -1)", "error": "out_of_range"},
    {"name": "URLENCODE counts three characters for every byte it encodes", "formula": "LEN(URLENCODE(REPEAT(\" \", 21) & \"a\"))", "expected": 64},
    {"formula": "URLENCODE(REPEAT(\" \", 21) & \"ab\")", "error": "out_of_range"},
    {"formula": "URLENCODE(REPEAT(\"é\", 11))", "error": "out_of_range"},
    {"formula": "LEN(URLENCODE(REPEAT(\"é\", 10) & \"abcd\"))", "expected": 64},
    {"name": "shrinking and recasing never reach the limit", "formula": "LEN(UPPER(REPEAT(\"ab\", 32)))", "expected": 64},
    {"formula": "LEN(TRIM(REPEAT(\" \", 10) & REPEAT(\"a\", 54)))", "expected": 54},
    {"formula": "LEN(LEFT(REPEAT(\"ab\", 32), 10))", "expected": 10},
    {"name": "a stored text within the limit flows through unchanged", "formula": "LEN(Code & \"\")", "inputs": {"Code": "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl"}, "expected": 64},
    {"formula": "Code & \"x\"", "inputs": {"Code": "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl"}, "error": "out_of_range"}
  ]
}
