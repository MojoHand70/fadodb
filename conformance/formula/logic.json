{
  "suite": "logic",
  "description": "IF in both forms, AND, OR and NOT as operators and functions, precedence (NOT before AND before OR), and short-circuit evaluation. Rows: r1 (5, 3), r2 (0, 3), r3 (-2, 0).",
  "variables": {"Alfa": "number", "Beta": "number"},
  "cases": [
    {"formula": "IF(Alfa > 0, IF(Beta > 2, 1, 2), 3)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF(Alfa > 0, IF(Beta > 2, 1, 2), 3)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 3},
    {"formula": "IF(Alfa > 0, IF(Beta > 2, 1, 2), 3)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 3},
    {"name": "keyword form with parenthesised conditions", "formula": "IF(Alfa > 0) THEN IF(Beta > 2) THEN 1 ELSE 2 ELSE 3", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF(Alfa > 0) THEN IF(Beta > 2) THEN 1 ELSE 2 ELSE 3", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 3},
    {"formula": "IF(Alfa > 0) THEN IF(Beta > 2) THEN 1 ELSE 2 ELSE 3", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 3},
    {"formula": "IF Alfa > 0 THEN IF Beta > 2 THEN 1 ELSE 2 ELSE 3", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF Alfa > 0 THEN IF Beta > 2 THEN 1 ELSE 2 ELSE 3", "inputs": {"Alfa": 5, "Beta": 1}, "expected": 2},
    {"formula": "1 + IF(Alfa > 0, 10, 20)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 11},
    {"formula": "1 + IF(Alfa > 0, 10, 20)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 21},
    {"formula": "1 + IF(Alfa > 0, 10, 20)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 21},
    {"formula": "1 + IF Alfa > 0 THEN 10 ELSE 20", "inputs": {"Alfa": 5}, "expected": 11},
    {"formula": "1 + IF Alfa > 0 THEN 10 ELSE 20", "inputs": {"Alfa": 0}, "expected": 21},
    {"name": "the ELSE branch extends as far right as it can", "formula": "IF Alfa > 0 THEN 1 ELSE 2 + 3", "inputs": {"Alfa": 5}, "expected": 1},
    {"formula": "IF Alfa > 0 THEN 1 ELSE 2 + 3", "inputs": {"Alfa": 0}, "expected": 5},
    {"formula": "IF(Alfa > 0, 1, 0) * Beta", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 3},
    {"formula": "IF(Alfa > 0, 1, 0) * Beta", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "IF(Alfa > 0, 1, 0) * Beta", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "IF(IF(Alfa > 0, 1, 0) = 1, Alfa, Beta)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 5},
    {"formula": "IF(IF(Alfa > 0, 1, 0) = 1, Alfa, Beta)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 3},
    {"formula": "IF(IF(Alfa > 0, 1, 0) = 1, Alfa, Beta)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "IF(Alfa > 0, Beta > 2, FALSE)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": true},
    {"formula": "IF(Alfa > 0, Beta > 2, FALSE)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": false},
    {"formula": "IF(Alfa > 0, Beta > 2, FALSE)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": false},
    {"formula": "IF(Alfa > 0 AND Beta > 2, 1, 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF(Alfa > 0 AND Beta > 2, 1, 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "IF(Alfa > 0 AND Beta > 2, 1, 0)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "IF(Alfa > 0 OR Beta > 2, 1, 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF(Alfa > 0 OR Beta > 2, 1, 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 1},
    {"formula": "IF(Alfa > 0 OR Beta > 2, 1, 0)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "IF(NOT Alfa > 0, 1, 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 0},
    {"formula": "IF(NOT Alfa > 0, 1, 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 1},
    {"formula": "IF(NOT Alfa > 0, 1, 0)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 1},
    {"formula": "IF(NOT(Alfa > 0) AND Beta = 0, 1, 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 0},
    {"formula": "IF(NOT(Alfa > 0) AND Beta = 0, 1, 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "IF(NOT(Alfa > 0) AND Beta = 0, 1, 0)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 1},
    {"name": "AND binds before OR: r3 is TRUE OR (FALSE AND FALSE)", "formula": "IF(Alfa < 0 OR Beta > 0 AND Alfa > 0, 1, 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF(Alfa < 0 OR Beta > 0 AND Alfa > 0, 1, 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "IF(Alfa < 0 OR Beta > 0 AND Alfa > 0, 1, 0)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 1},
    {"formula": "Alfa > 0 AND Beta > 0", "inputs": {"Alfa": 5, "Beta": 3}, "expected": true},
    {"formula": "Alfa > 0 AND Beta > 0", "inputs": {"Alfa": 0, "Beta": 3}, "expected": false},
    {"formula": "Alfa > 0 AND Beta > 0", "inputs": {"Alfa": -2, "Beta": 0}, "expected": false},
    {"formula": "IF(Alfa > 0 AND NOT Beta = 0, Alfa * 2, -1)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 10},
    {"formula": "IF(Alfa > 0 AND NOT Beta = 0, Alfa * 2, -1)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": -1},
    {"formula": "IF(Alfa > 0 AND NOT Beta = 0, Alfa * 2, -1)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": -1},
    {"name": "function forms", "formula": "AND(Alfa > 0, Beta > 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": true},
    {"formula": "AND(Alfa > 0, Beta > 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": false},
    {"formula": "AND(Alfa > 0, Beta > 0, Alfa > Beta)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": true},
    {"formula": "OR(Alfa < 0, Beta < 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": false},
    {"formula": "OR(Alfa < 0, Beta < 0)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": true},
    {"formula": "NOT(Alfa > 0)", "inputs": {"Alfa": 5}, "expected": false},
    {"formula": "NOT(Alfa > 0)", "inputs": {"Alfa": 0}, "expected": true},
    {"formula": "TRUE AND FALSE", "expected": false},
    {"formula": "TRUE OR FALSE", "expected": true},
    {"formula": "NOT TRUE", "expected": false},
    {"formula": "NOT NOT TRUE", "expected": true},
    {"name": "NOT( is the function form, a primary", "formula": "NOT(FALSE) <= TRUE", "expected": true},
    {"name": "NOT without a parenthesis negates the comparison", "formula": "NOT FALSE <= TRUE", "expected": false},
    {"formula": "NOT(Alfa > 0) <= (Beta > 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": true},
    {"formula": "true and True", "expected": true},
    {"name": "only the chosen branch is evaluated", "formula": "IF(Beta = 0, 0, Alfa \\ Beta)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "IF(Beta = 0, 0, Alfa \\ Beta)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1.6666666666666667},
    {"formula": "IF Beta = 0 THEN 0 ELSE Alfa \\ Beta", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"name": "OR stops at the first TRUE", "formula": "Beta = 0 OR Alfa \\ Beta > 1", "inputs": {"Alfa": -2, "Beta": 0}, "expected": true},
    {"formula": "Beta = 0 OR Alfa \\ Beta > 1", "inputs": {"Alfa": 5, "Beta": 3}, "expected": true},
    {"formula": "Beta = 0 OR Alfa \\ Beta > 1", "inputs": {"Alfa": 0, "Beta": 3}, "expected": false},
    {"name": "AND stops at the first FALSE", "formula": "Beta <> 0 AND Alfa \\ Beta > 1", "inputs": {"Alfa": -2, "Beta": 0}, "expected": false},
    {"formula": "FALSE AND (1 \\ 0 > 0)", "expected": false},
    {"formula": "TRUE OR (1 \\ 0 > 0)", "expected": true},
    {"name": "an error in a taken branch is an error", "formula": "TRUE AND (1 \\ 0 > 0)", "error": "div_by_zero"},
    {"formula": "IF(TRUE, 1 \\ 0, 0)", "error": "div_by_zero"},
    {"name": "comparisons of booleans", "formula": "TRUE = TRUE", "expected": true},
    {"formula": "TRUE = FALSE", "expected": false},
    {"formula": "FALSE < TRUE", "expected": true},
    {"formula": "(Alfa > 0) = (Beta > 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": true},
    {"formula": "(Alfa > 0) <> (Beta > 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": true}
  ]
}
