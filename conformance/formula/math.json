{
  "suite": "math",
  "description": "MIN, MAX, POWER, ^, SQRT, EXP, LN, LOG, MOD, SIGN and TRUNC, with the errors of ADR-0019 where the predecessor engine produced a blank or 0. Rows: r1 (5, 3), r2 (0, 3), r3 (-2, 0).",
  "variables": {"Alfa": "number", "Beta": "number"},
  "cases": [
    {"formula": "MAX(Alfa, Beta)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 5},
    {"formula": "MAX(Alfa, Beta)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 3},
    {"formula": "MAX(Alfa, Beta)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "MIN(Alfa, Beta, 1)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "MIN(Alfa, Beta, 1)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "MIN(Alfa, Beta, 1)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": -2},
    {"formula": "MAX(0, Alfa - Beta)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 2},
    {"formula": "MAX(0, Alfa - Beta)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "MAX(0, Alfa - Beta)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "MAX(Alfa, Beta) + MIN(Alfa, Beta)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 8},
    {"formula": "MAX(Alfa, Beta) + MIN(Alfa, Beta)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 3},
    {"formula": "MAX(Alfa, Beta) + MIN(Alfa, Beta)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": -2},
    {"formula": "IF(MAX(Alfa, Beta) > 4, 1, 0)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 1},
    {"formula": "IF(MAX(Alfa, Beta) > 4, 1, 0)", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 0},
    {"formula": "MAX(0, IF(Alfa > Beta, Alfa, Beta))", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 5},
    {"formula": "MAX(0, IF(Alfa > Beta, Alfa, Beta))", "inputs": {"Alfa": 0, "Beta": 3}, "expected": 3},
    {"formula": "MAX(0, IF(Alfa > Beta, Alfa, Beta))", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "POWER(Beta, 2)", "inputs": {"Alfa": 5, "Beta": 3}, "expected": 9},
    {"formula": "POWER(Beta, 2)", "inputs": {"Alfa": -2, "Beta": 0}, "expected": 0},
    {"formula": "Alfa ^ 2", "inputs": {"Alfa": 5}, "expected": 25},
    {"formula": "Alfa ^ 2", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "Alfa ^ 2", "inputs": {"Alfa": -2}, "expected": 4},
    {"name": "^ is right-associative: 2 ^ (3 ^ 2)", "formula": "2 ^ Beta ^ 2", "inputs": {"Beta": 3}, "expected": 512},
    {"formula": "2 ^ Beta ^ 2", "inputs": {"Beta": 0}, "expected": 1},
    {"name": "unary minus binds before ^, as in Excel", "formula": "-Beta ^ 2", "inputs": {"Beta": 3}, "expected": 9},
    {"formula": "-Beta ^ 2", "inputs": {"Beta": 0}, "expected": 0},
    {"formula": "ROUND((1 + 10%) ^ Beta, 3)", "inputs": {"Beta": 3}, "expected": 1.331},
    {"formula": "ROUND((1 + 10%) ^ Beta, 3)", "inputs": {"Beta": 0}, "expected": 1},
    {"formula": "SQRT(Alfa * Alfa)", "inputs": {"Alfa": 5}, "expected": 5},
    {"formula": "SQRT(Alfa * Alfa)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "SQRT(Alfa * Alfa)", "inputs": {"Alfa": -2}, "expected": 2},
    {"formula": "ROUND(EXP(Beta), 3)", "inputs": {"Beta": 3}, "expected": 20.086},
    {"formula": "ROUND(EXP(Beta), 3)", "inputs": {"Beta": 0}, "expected": 1},
    {"formula": "ROUND(LN(EXP(Beta)), 6)", "inputs": {"Beta": 3}, "expected": 3},
    {"formula": "ROUND(LN(EXP(Beta)), 6)", "inputs": {"Beta": 0}, "expected": 0},
    {"formula": "ROUND(LOG(1000 + 0 * Alfa), 6)", "inputs": {"Alfa": 5}, "expected": 3},
    {"formula": "ROUND(LOG(POWER(2, Beta), 2), 6)", "inputs": {"Beta": 3}, "expected": 3},
    {"formula": "ROUND(LOG(POWER(2, Beta), 2), 6)", "inputs": {"Beta": 0}, "expected": 0},
    {"name": "MOD takes the sign of the divisor, as in Excel", "formula": "MOD(Alfa, 3)", "inputs": {"Alfa": 5}, "expected": 2},
    {"formula": "MOD(Alfa, 3)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "MOD(Alfa, 3)", "inputs": {"Alfa": -2}, "expected": 1},
    {"formula": "MOD(Alfa, -3)", "inputs": {"Alfa": 5}, "expected": -1},
    {"formula": "MOD(Alfa, -3)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "MOD(Alfa, -3)", "inputs": {"Alfa": -2}, "expected": -2},
    {"name": "MOD by zero is an error, not 0 as the predecessor returned", "formula": "MOD(Alfa, 0)", "inputs": {"Alfa": 5}, "error": "div_by_zero"},
    {"formula": "MOD(Alfa, 0)", "inputs": {"Alfa": 0}, "error": "div_by_zero"},
    {"formula": "SIGN(Alfa)", "inputs": {"Alfa": 5}, "expected": 1},
    {"formula": "SIGN(Alfa)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "SIGN(Alfa)", "inputs": {"Alfa": -2}, "expected": -1},
    {"formula": "TRUNC(Alfa / 3)", "inputs": {"Alfa": 5}, "expected": 1},
    {"formula": "TRUNC(Alfa / 3)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "TRUNC(Alfa / 3)", "inputs": {"Alfa": -2}, "expected": 0},
    {"formula": "TRUNC(Alfa / 3, 1)", "inputs": {"Alfa": 5}, "expected": 1.6},
    {"formula": "TRUNC(Alfa / 3, 1)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "TRUNC(Alfa / 3, 1)", "inputs": {"Alfa": -2}, "expected": -0.6},
    {"formula": "TRUNC(-Alfa * 1.5)", "inputs": {"Alfa": 5}, "expected": -7},
    {"formula": "TRUNC(-Alfa * 1.5)", "inputs": {"Alfa": 0}, "expected": 0},
    {"formula": "TRUNC(-Alfa * 1.5)", "inputs": {"Alfa": -2}, "expected": 3},
    {"name": "reference values", "formula": "MIN(3, -1, 2)", "expected": -1},
    {"formula": "MAX(3, -1, 2)", "expected": 3},
    {"formula": "MIN(7)", "expected": 7},
    {"formula": "POWER(2, 10)", "expected": 1024},
    {"formula": "POWER(4, 0.5)", "expected": 2},
    {"formula": "2 ^ 10", "expected": 1024},
    {"formula": "2 ^ -1", "expected": 0.5},
    {"formula": "0 ^ 0", "expected": 1},
    {"formula": "SQRT(144)", "expected": 12},
    {"formula": "SQRT(0)", "expected": 0},
    {"formula": "EXP(0)", "expected": 1},
    {"formula": "LN(1)", "expected": 0},
    {"formula": "ROUND(LN(5), 6)", "expected": 1.609438},
    {"formula": "ROUND(LOG(100), 10)", "expected": 2},
    {"formula": "ROUND(LOG(8, 2), 10)", "expected": 3},
    {"formula": "MOD(7, 3)", "expected": 1},
    {"formula": "MOD(-7, 3)", "expected": 2},
    {"formula": "MOD(7, -3)", "expected": -2},
    {"formula": "MOD(7.5, 2)", "expected": 1.5},
    {"formula": "SIGN(-0.001)", "expected": -1},
    {"formula": "SIGN(0)", "expected": 0},
    {"formula": "ABS(-12.5)", "expected": 12.5},
    {"formula": "ABS(3)", "expected": 3},
    {"name": "non-finite results are errors, not blanks", "formula": "SQRT(-1)", "error": "not_a_number"},
    {"formula": "SQRT(Alfa)", "inputs": {"Alfa": -2}, "error": "not_a_number"},
    {"formula": "LN(0)", "error": "not_a_number"},
    {"formula": "LN(-5)", "error": "not_a_number"},
    {"formula": "LN(Beta)", "inputs": {"Beta": 0}, "error": "not_a_number"},
    {"formula": "LOG(-5)", "error": "not_a_number"},
    {"formula": "LOG(0)", "error": "not_a_number"},
    {"formula": "LOG(5, 1)", "error": "not_a_number"},
    {"formula": "LOG(5, 0)", "error": "not_a_number"},
    {"formula": "LOG(5, -2)", "error": "not_a_number"},
    {"formula": "0 ^ -1", "error": "not_a_number"},
    {"formula": "POWER(0, -1)", "error": "not_a_number"},
    {"formula": "(-8) ^ 0.5", "error": "not_a_number"},
    {"formula": "10 ^ 400", "error": "not_a_number"},
    {"formula": "EXP(1000)", "error": "not_a_number"},
    {"formula": "MOD(7, 0)", "error": "div_by_zero"}
  ]
}
