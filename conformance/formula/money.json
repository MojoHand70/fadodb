    {"formula": "MONEYVALUE(\"92233720368547758.07 PLN\", 2) + 0.01", "error": "overflow"},
    {"name": "an invoice", "formula": "ROUND(M * 3 * (1 - 10%), 2)", "inputs": {"M": "9.99 PLN"}, "type": "money(2)", "expected": "26.97 PLN"},
    {"formula": "M + ROUND(M * 23%, 2)", "inputs": {"M": "12345.67 PLN"}, "type": "money(2)", "expected": "15185.17 PLN"},
    {"formula": "TEXT(M + ROUND(M * 23%, 2))", "inputs": {"M": "12345.67 PLN"}, "expected": "15185.17 PLN"}
  ]
}
