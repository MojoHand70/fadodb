{
  "suite": "money",
  "description": "Money is a decimal with a currency code (ADR-0022): money plus or minus money or a decimal is money, money times a decimal is money, money divided by money is a decimal and by a decimal is money, and the money operands of one operation share a currency or the result is the error currency_mismatch. A money value with no currency, every money operand having been blank, is blank. Written as \"12.30 PLN\".",
  "variables": {"M": "money(2)", "P": "money(2)", "D": "decimal(2)", "C": "text", "J": "money(0)", "T": "text"},
  "cases": [
    {"formula": "M + P", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(2)", "expected": "10.50 PLN"},
    {"formula": "M - P", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(2)", "expected": "9.50 PLN"},
    {"formula": "P - M", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(2)", "expected": "-9.50 PLN"},
    {"name": "currencies must agree", "formula": "M + P", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "error": "currency_mismatch"},
    {"formula": "M - P", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "error": "currency_mismatch"},
    {"formula": "M / P", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "error": "currency_mismatch"},
    {"formula": "M = P", "inputs": {"M": "10.00 PLN", "P": "10.00 EUR"}, "error": "currency_mismatch"},
    {"formula": "M < P", "inputs": {"M": "10.00 PLN", "P": "10.00 EUR"}, "error": "currency_mismatch"},
    {"formula": "SUM(M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "error": "currency_mismatch"},
    {"formula": "MIN(M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "error": "currency_mismatch"},
    {"formula": "MOD(M, P)", "inputs": {"M": "10.00 PLN", "P": "3.00 EUR"}, "error": "currency_mismatch"},
    {"name": "money with a decimal or a literal keeps the currency", "formula": "M + 1", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "11.00 PLN"},
    {"formula": "1 + M", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "11.00 PLN"},
    {"formula": "M - D", "inputs": {"M": "10.00 PLN", "D": 0.25}, "type": "money(2)", "expected": "9.75 PLN"},
    {"formula": "D - M", "inputs": {"M": "10.00 PLN", "D": 0.25}, "type": "money(2)", "expected": "-9.75 PLN"},
    {"formula": "M * 2", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "20.00 PLN"},
    {"formula": "2 * M", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "20.00 PLN"},
    {"formula": "M * 1.5", "inputs": {"M": "10.00 PLN"}, "type": "money(3)", "expected": "15.000 PLN"},
    {"formula": "M * D", "inputs": {"M": "10.00 PLN", "D": 0.23}, "type": "money(4)", "expected": "2.3000 PLN"},
    {"formula": "M * 23%", "inputs": {"M": "10.00 PLN"}, "type": "money(4)", "expected": "2.3000 PLN"},
    {"formula": "M / 4", "inputs": {"M": "10.00 PLN"}, "type": "money(6)", "expected": "2.500000 PLN"},
    {"formula": "M / 3", "inputs": {"M": "10.00 PLN"}, "type": "money(6)", "expected": "3.333333 PLN"},
    {"formula": "M / D", "inputs": {"M": "10.00 PLN", "D": 0.50}, "type": "money(6)", "expected": "20.000000 PLN"},
    {"formula": "M / 0", "inputs": {"M": "10.00 PLN"}, "error": "div_by_zero"},
    {"name": "money divided by money is a decimal", "formula": "M / P", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "decimal(6)", "expected": "20.000000"},
    {"formula": "M / P = 20", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "expected": true},
    {"formula": "ROUND(M / P * 100, 1)", "inputs": {"M": "1.00 PLN", "P": "3.00 PLN"}, "type": "decimal(1)", "expected": "33.3"},
    {"formula": "-M", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "-10.00 PLN"},
    {"formula": "M%", "inputs": {"M": "10.00 PLN"}, "type": "money(4)", "expected": "0.1000 PLN"},
    {"formula": "M + TRUE", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "11.00 PLN"},
    {"name": "comparison", "formula": "M = P", "inputs": {"M": "10.00 PLN", "P": "10.00 PLN"}, "expected": true},
    {"formula": "M < P", "inputs": {"M": "10.00 PLN", "P": "10.01 PLN"}, "expected": true},
    {"formula": "M >= P", "inputs": {"M": "10.00 PLN", "P": "10.01 PLN"}, "expected": false},
    {"formula": "M = 10", "inputs": {"M": "10.00 PLN"}, "expected": true},
    {"formula": "M > 9.99", "inputs": {"M": "10.00 PLN"}, "expected": true},
    {"formula": "M = BLANK", "inputs": {"M": "0.00 PLN"}, "expected": true},
    {"formula": "M > BLANK", "inputs": {"M": "0.01 PLN"}, "expected": true},
    {"formula": "M = P", "inputs": {"M": "0.00 PLN"}, "expected": true},
    {"formula": "J < M", "inputs": {"J": "5 JPY", "M": "5.01 JPY"}, "expected": true},
    {"name": "a blank operand defers to the other's currency; no currency at all is blank", "formula": "M + P", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "10.00 PLN"},
    {"formula": "M + P", "inputs": {"P": "0.50 EUR"}, "type": "money(2)", "expected": "0.50 EUR"},
    {"formula": "M + P", "type": "money(2)", "expected": null},
    {"formula": "ISBLANK(M + P)", "expected": true},
    {"formula": "COUNT(M + P)", "expected": 0},
    {"formula": "M + 5", "type": "money(2)", "expected": null},
    {"formula": "M * 2", "type": "money(2)", "expected": null},
    {"formula": "-M", "type": "money(2)", "expected": null},
    {"formula": "M%", "type": "money(4)", "expected": null},
    {"formula": "M * D", "inputs": {"M": "10.00 PLN"}, "type": "money(4)", "expected": "0.0000 PLN"},
    {"formula": "M / P", "inputs": {"P": "0.50 PLN"}, "type": "decimal(6)", "expected": "0.000000"},
    {"formula": "M / P", "inputs": {"M": "10.00 PLN"}, "error": "div_by_zero"},
    {"formula": "TEXT(M + P)", "expected": ""},
    {"name": "MONEY builds money from an amount and a code", "formula": "MONEY(D, \"PLN\")", "inputs": {"D": 0.23}, "type": "money(2)", "expected": "0.23 PLN"},
    {"formula": "MONEY(12.5, \"EUR\")", "type": "money(1)", "expected": "12.5 EUR"},
    {"formula": "MONEY(1, \"PLN\")", "type": "money(0)", "expected": "1 PLN"},
    {"formula": "MONEY(-0.01, \"USD\")", "type": "money(2)", "expected": "-0.01 USD"},
    {"formula": "MONEY(D, C)", "inputs": {"D": 0.23, "C": "CHF"}, "type": "money(2)", "expected": "0.23 CHF"},
    {"formula": "MONEY(TRUE, \"PLN\")", "type": "money(0)", "expected": "1 PLN"},
    {"formula": "MONEY(D, \"pln\")", "inputs": {"D": 0.23}, "error": "bad_text"},
    {"formula": "MONEY(D, \"PLNX\")", "inputs": {"D": 0.23}, "error": "bad_text"},
    {"formula": "MONEY(D, \"\")", "inputs": {"D": 0.23}, "error": "bad_text"},
    {"formula": "MONEY(D, C)", "inputs": {"D": 0.23}, "error": "bad_text"},
    {"formula": "MONEY(D, \"PLN\")", "type": "money(2)", "expected": null},
    {"formula": "MONEY(BLANK, \"nope\")", "type": "money(0)", "expected": null},
    {"formula": "MONEY(AMOUNT(M) * 2, CURRENCY(M))", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "20.00 PLN"},
    {"name": "MONEYVALUE reads \"amount code\"", "formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.30 PLN"}, "type": "money(2)", "expected": "12.30 PLN"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.3 PLN"}, "type": "money(2)", "expected": "12.30 PLN"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": " -5 EUR "}, "type": "money(2)", "expected": "-5.00 EUR"},
    {"formula": "MONEYVALUE(T, 0)", "inputs": {"T": "1e2 USD"}, "type": "money(0)", "expected": "100 USD"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.345 PLN"}, "error": "inexact"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.30PLN"}, "error": "bad_text"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.30 pln"}, "error": "bad_text"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.30  PLN"}, "error": "bad_text"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "PLN 12.30"}, "error": "bad_text"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "abc PLN"}, "error": "bad_text"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": "12.30"}, "error": "bad_text"},
    {"formula": "MONEYVALUE(T, 2)", "inputs": {"T": ""}, "type": "money(2)", "expected": null},
    {"formula": "MONEYVALUE(T, 2)", "type": "money(2)", "expected": null},
    {"formula": "MONEYVALUE(T, 0)", "inputs": {"T": "9223372036854775808 PLN"}, "error": "overflow"},
    {"name": "AMOUNT and CURRENCY take money apart", "formula": "AMOUNT(M)", "inputs": {"M": "10.00 PLN"}, "type": "decimal(2)", "expected": "10.00"},
    {"formula": "CURRENCY(M)", "inputs": {"M": "10.00 PLN"}, "expected": "PLN"},
    {"formula": "AMOUNT(M)", "type": "decimal(2)", "expected": null},
    {"formula": "CURRENCY(M)", "expected": null},
    {"formula": "AMOUNT(M) + D", "inputs": {"M": "10.00 PLN", "D": 0.25}, "type": "decimal(2)", "expected": "10.25"},
    {"formula": "CURRENCY(M) = \"PLN\"", "inputs": {"M": "10.00 PLN"}, "expected": true},
    {"formula": "AMOUNT(M + P)", "inputs": {"M": "10.00 PLN"}, "type": "decimal(2)", "expected": "10.00"},
    {"formula": "AMOUNT(M + P)", "type": "decimal(2)", "expected": null},
    {"name": "TEXT is the amount, a space and the code", "formula": "TEXT(M)", "inputs": {"M": "10.00 PLN"}, "expected": "10.00 PLN"},
    {"formula": "TEXT(J)", "inputs": {"J": "5 JPY"}, "expected": "5 JPY"},
    {"formula": "M & \"\"", "inputs": {"M": "-0.50 EUR"}, "expected": "-0.50 EUR"},
    {"formula": "\"due: \" & M", "inputs": {"M": "10.00 PLN"}, "expected": "due: 10.00 PLN"},
    {"formula": "TEXT(M)", "expected": ""},
    {"formula": "TEXT(M * 1.5)", "inputs": {"M": "10.00 PLN"}, "expected": "15.000 PLN"},
    {"name": "rounding keeps the currency", "formula": "ROUND(M * 1.23, 2)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "12.30 PLN"},
    {"formula": "ROUND(M / 3, 2)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "3.33 PLN"},
    {"formula": "ROUND(M / 3, 2, \"up\")", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "3.34 PLN"},
    {"formula": "ROUND(M / 3, 2, \"half_even\")", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "3.33 PLN"},
    {"formula": "FLOOR(M / 3, 2)", "inputs": {"M": "-10.00 PLN"}, "type": "money(2)", "expected": "-3.34 PLN"},
    {"formula": "CEILING(M / 3, 2)", "inputs": {"M": "-10.00 PLN"}, "type": "money(2)", "expected": "-3.33 PLN"},
    {"formula": "TRUNC(M / 3, 2)", "inputs": {"M": "-10.00 PLN"}, "type": "money(2)", "expected": "-3.33 PLN"},
    {"formula": "ROUND(M, 0)", "inputs": {"M": "10.50 PLN"}, "type": "money(0)", "expected": "11 PLN"},
    {"formula": "ROUND(M, -1)", "inputs": {"M": "15.00 PLN"}, "type": "money(0)", "expected": "20 PLN"},
    {"formula": "ROUND(M, 2)", "type": "money(2)", "expected": null},
    {"formula": "ROUND(J, 2)", "inputs": {"J": "5 JPY"}, "type": "money(2)", "expected": "5.00 JPY"},
    {"name": "the aggregates", "formula": "SUM(M, P, 1)", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(2)", "expected": "11.50 PLN"},
    {"formula": "SUM(M, P)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "10.00 PLN"},
    {"formula": "SUM(M, P)", "inputs": {"P": "0.50 EUR"}, "type": "money(2)", "expected": "0.50 EUR"},
    {"formula": "SUM(M, P)", "type": "money(2)", "expected": null},
    {"formula": "SUM(M, 1)", "type": "money(2)", "expected": null},
    {"formula": "SUM(M)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "10.00 PLN"},
    {"formula": "MIN(M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(2)", "expected": "0.50 PLN"},
    {"formula": "MAX(M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(2)", "expected": "10.00 PLN"},
    {"formula": "MAX(M, 20)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "20.00 PLN"},
    {"formula": "MIN(M, P)", "inputs": {"P": "0.50 PLN"}, "type": "money(2)", "expected": "0.50 PLN"},
    {"formula": "MIN(M, P)", "type": "money(2)", "expected": null},
    {"formula": "AVERAGE(M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 PLN"}, "type": "money(6)", "expected": "5.250000 PLN"},
    {"formula": "AVERAGE(M, P)", "inputs": {"M": "10.00 PLN"}, "type": "money(6)", "expected": "10.000000 PLN"},
    {"formula": "AVERAGE(M, P)", "type": "money(6)", "expected": null},
    {"formula": "COUNT(M, P)", "inputs": {"M": "10.00 PLN"}, "expected": 1},
    {"formula": "ABS(M)", "inputs": {"M": "-10.00 PLN"}, "type": "money(2)", "expected": "10.00 PLN"},
    {"formula": "ABS(M)", "type": "money(2)", "expected": null},
    {"formula": "SIGN(M)", "inputs": {"M": "-10.00 PLN"}, "type": "int", "expected": -1},
    {"formula": "MOD(M, 3)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": "1.00 PLN"},
    {"formula": "MOD(M, P)", "inputs": {"M": "10.00 PLN", "P": "3.00 PLN"}, "type": "money(2)", "expected": "1.00 PLN"},
    {"name": "conversions", "formula": "DECIMAL(M, 1)", "inputs": {"M": "10.05 PLN"}, "type": "decimal(1)", "expected": "10.1"},
    {"formula": "NUMBER(M)", "inputs": {"M": "10.05 PLN"}, "expected": 10.05},
    {"formula": "DECIMAL(M, 1)", "type": "decimal(1)", "expected": null},
    {"name": "a money at scale 0 and at other scales", "formula": "J + 1", "inputs": {"J": "5 JPY"}, "type": "money(0)", "expected": "6 JPY"},
    {"formula": "J * 1.5", "inputs": {"J": "5 JPY"}, "type": "money(1)", "expected": "7.5 JPY"},
    {"formula": "J / 2", "inputs": {"J": "5 JPY"}, "type": "money(4)", "expected": "2.5000 JPY"},
    {"formula": "ROUND(J / 3, 0)", "inputs": {"J": "5 JPY"}, "type": "money(0)", "expected": "2 JPY"},
    {"formula": "M + J", "inputs": {"M": "1.50 JPY", "J": "5 JPY"}, "type": "money(2)", "expected": "6.50 JPY"},
    {"name": "IF joins money branches", "formula": "IF(TRUE, M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "type": "money(2)", "expected": "10.00 PLN"},
    {"formula": "IF(FALSE, M, P)", "inputs": {"M": "10.00 PLN", "P": "0.50 EUR"}, "type": "money(2)", "expected": "0.50 EUR"},
    {"formula": "IF(FALSE, M, BLANK)", "inputs": {"M": "10.00 PLN"}, "type": "money(2)", "expected": null},
    {"formula": "IF(TRUE, M, M * 1.5)", "inputs": {"M": "10.00 PLN"}, "type": "money(3)", "expected": "10.000 PLN"},
    {"formula": "IFERROR(M / P, 0)", "inputs": {"M": "10.00 PLN"}, "type": "decimal(6)", "expected": "0.000000"},
    {"formula": "IFERROR(M + P, M)", "inputs": {"M": "10.00 PLN", "P": "1.00 EUR"}, "type": "money(2)", "expected": "10.00 PLN"},
