{
  "suite": "numeric",
  "description": "ROUND half away from zero, FLOOR and CEILING toward the infinities, at positive, zero and negative digit counts, including the binary-float traps 2.675, 1.005 and 0.29 that a naive scale-and-step gets wrong; the percent operator.",
  "variables": {"Godziny": "number"},
  "cases": [
    {"name": "half away from zero, not banker's rounding", "formula": "ROUND(2.5)", "expected": 3},
    {"formula": "ROUND(-2.5)", "expected": -3},
    {"formula": "ROUND(3.5)", "expected": 4},
    {"formula": "ROUND(0.5)", "expected": 1},
    {"formula": "ROUND(-0.5)", "expected": -1},
    {"formula": "ROUND(2.4999)", "expected": 2},
    {"formula": "ROUND(2.5, 0)", "expected": 3},
    {"name": "the binary-float traps round as Excel does", "formula": "ROUND(2.675, 2)", "expected": 2.68},
    {"name": "1.005 is stored as 1.00499999999999989, so every engine rounds it down; Excel's 1.01 is a display rule", "formula": "ROUND(1.005, 2)", "expected": 1},
    {"formula": "ROUND(1234, -2)", "expected": 1200},
    {"formula": "ROUND(1250, -2)", "expected": 1300},
    {"formula": "ROUND(-1250, -2)", "expected": -1300},
    {"formula": "ROUND(17 / 8)", "expected": 2},
    {"formula": "ROUND(20 / 8)", "expected": 3},
    {"formula": "ROUND(1.23456, 3)", "expected": 1.235},
    {"name": "absurd digit counts degrade to a no-op or 0, never to nonsense", "formula": "ROUND(123.456, 400)", "expected": 123.456},
    {"formula": "ROUND(123.456, -400)", "expected": 0},
    {"formula": "ROUND(Godziny / 8)", "inputs": {"Godziny": 17}, "expected": 2},
    {"formula": "ROUND(Godziny / 8)", "inputs": {"Godziny": 20}, "expected": 3},
    {"formula": "ROUND(Godziny / 8)", "inputs": {"Godziny": 16}, "expected": 2},
    {"formula": "ROUND(Godziny / 8)", "inputs": {"Godziny": -20}, "expected": -3},
    {"name": "the digit count is a full expression", "formula": "ROUND(Godziny, Godziny - Godziny)", "inputs": {"Godziny": 2.6}, "expected": 3},
    {"formula": "ROUND(Godziny / 8) * 8", "inputs": {"Godziny": 20}, "expected": 24},
    {"formula": "ABS(Godziny - 8)", "inputs": {"Godziny": 17}, "expected": 9},
    {"formula": "ABS(Godziny - 16)", "inputs": {"Godziny": 20}, "expected": 4},
    {"formula": "FLOOR(2.125)", "expected": 2},
    {"formula": "CEILING(2.125)", "expected": 3},
    {"formula": "FLOOR(17 / 8)", "expected": 2},
    {"formula": "CEILING(17 / 8)", "expected": 3},
    {"formula": "CEIL(17 / 8)", "expected": 3},
    {"formula": "FLOOR(20 / 8)", "expected": 2},
    {"formula": "CEILING(20 / 8)", "expected": 3},
    {"name": "an exact value moves in neither direction", "formula": "FLOOR(16 / 8)", "expected": 2},
    {"formula": "CEILING(16 / 8)", "expected": 2},
    {"name": "0.29 * 100 is 28.999999999999996 in binary; the scaled value is rounded before stepping", "formula": "FLOOR(0.29, 2)", "expected": 0.29},
    {"formula": "CEILING(0.29, 2)", "expected": 0.29},
    {"formula": "FLOOR(2.875, 2)", "expected": 2.87},
    {"formula": "CEILING(2.875, 2)", "expected": 2.88},
    {"formula": "FLOOR(2.675, 2)", "expected": 2.67},
    {"formula": "CEILING(2.675, 2)", "expected": 2.68},
    {"formula": "FLOOR(8.7, 1)", "expected": 8.7},
    {"formula": "CEILING(8.7, 1)", "expected": 8.7},
    {"formula": "FLOOR(1234, -2)", "expected": 1200},
    {"formula": "CEILING(1234, -2)", "expected": 1300},
    {"name": "toward an infinity, not away from zero", "formula": "FLOOR(-2.1)", "expected": -3},
    {"formula": "CEILING(-2.1)", "expected": -2},
    {"formula": "FLOOR(-2.9)", "expected": -3},
    {"formula": "CEILING(-2.9)", "expected": -2},
    {"formula": "CEILING(Godziny / 8)", "inputs": {"Godziny": 17}, "expected": 3},
    {"formula": "CEILING(Godziny / 8)", "inputs": {"Godziny": 20}, "expected": 3},
    {"formula": "CEILING(Godziny / 8)", "inputs": {"Godziny": 16}, "expected": 2},
    {"formula": "CEILING(Godziny / 8)", "inputs": {"Godziny": 0.5}, "expected": 1},
    {"formula": "CEILING(Godziny / 8) * 8 - Godziny", "inputs": {"Godziny": 17}, "expected": 7},
    {"formula": "FLOOR(Godziny / 8)", "inputs": {"Godziny": 17}, "expected": 2},
    {"formula": "TRUNC(2.9)", "expected": 2},
    {"formula": "TRUNC(-2.9)", "expected": -2},
    {"formula": "TRUNC(2.675, 2)", "expected": 2.67},
    {"formula": "TRUNC(1234, -2)", "expected": 1200},
    {"name": "percent is a postfix operator: 5% is 0.05", "formula": "50%", "expected": 0.5},
    {"formula": "5%", "expected": 0.05},
    {"formula": "-5%", "expected": -0.05},
    {"formula": "200 * 10%", "expected": 20},
    {"formula": "50%%", "expected": 0.005},
    {"formula": "ROUND((1 + 10%) ^ 2, 4)", "expected": 1.21},
    {"formula": "Godziny%", "inputs": {"Godziny": 25}, "expected": 0.25}
  ]
}
