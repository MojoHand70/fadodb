{
  "suite": "ref",
  "description": "REF makes a pointer to a document, which a ref compares with (ADR-0076, item 10). REF(class, id) is the pointer to the document of the class that has the id: the class is written as a text, the id is any text, and a blank id gives a blank pointer. REF() is the pointer to the document the formula runs over, of the class the formula belongs to, which the suite names under class; with no document it is blank. A pointer compares with a pointer and never with a text; TEXT and & write it as Class:id.",
  "class": "Order",
  "variables": {"R": "ref", "S": "text"},
  "cases": [
    {"name": "a class and an id", "formula": "REF(\"Order\", \"ORD-17\")", "type": "ref", "expected": "Order:ORD-17"},
    {"name": "the id is any text", "formula": "REF(\"Order\", S)", "inputs": {"S": "ORD-17"}, "expected": "Order:ORD-17"},
    {"formula": "REF(\"Order\", S & \"-17\")", "inputs": {"S": "ORD"}, "expected": "Order:ORD-17"},
    {"formula": "REF(\"Order\", TEXT(17))", "expected": "Order:17"},
    {"name": "an id may hold a colon", "formula": "REF(\"Order\", \"a:b\")", "expected": "Order:a:b"},
    {"name": "a blank id is no pointer", "formula": "REF(\"Order\", S)", "expected": null},
    {"formula": "REF(\"Order\", \"\")", "expected": null},
    {"formula": "REF(\"Order\", BLANK)", "expected": null},
    {"formula": "ISBLANK(REF(\"Order\", S))", "expected": true},
    {"formula": "ISBLANK(REF(\"Order\", S))", "inputs": {"S": "ORD-17"}, "expected": false},
    {"name": "a ref compares with it", "formula": "R = REF(\"Order\", \"ORD-17\")", "inputs": {"R": "Order:ORD-17"}, "expected": true},
    {"formula": "R = REF(\"Order\", \"ORD-18\")", "inputs": {"R": "Order:ORD-17"}, "expected": false},
    {"formula": "R <> REF(\"Order\", S)", "inputs": {"R": "Order:ORD-17", "S": "ORD-18"}, "expected": true},
    {"name": "the same id in another class is another document", "formula": "R = REF(\"Invoice\", \"ORD-17\")", "inputs": {"R": "Order:ORD-17"}, "expected": false},
    {"name": "a blank pointer equals a blank pointer", "formula": "R = REF(\"Order\", S)", "expected": true},
    {"formula": "R = REF(\"Order\", S)", "inputs": {"R": "Order:ORD-17"}, "expected": false},
    {"formula": "REF(\"Order\", \"ORD-17\") = REF(\"Order\", S)", "inputs": {"S": "ORD-17"}, "expected": true},
    {"name": "written as Class:id", "formula": "TEXT(REF(\"Order\", \"ORD-17\"))", "type": "text", "expected": "Order:ORD-17"},
    {"formula": "\"see \" & REF(\"Order\", S)", "inputs": {"S": "ORD-17"}, "expected": "see Order:ORD-17"},
    {"formula": "LEN(TEXT(REF(\"Order\", S)))", "expected": 0},
    {"formula": "IF(S = \"\", REF(\"Order\", \"none\"), REF(\"Invoice\", S))", "inputs": {"S": "FV-1"}, "type": "ref", "expected": "Invoice:FV-1"},
    {"name": "the document the formula runs over", "formula": "REF()", "context": {"id": "ORD-17"}, "type": "ref", "expected": "Order:ORD-17"},
    {"name": "no document, no pointer", "formula": "REF()", "expected": null},
    {"formula": "ISBLANK(REF())", "expected": true},
    {"formula": "ISBLANK(REF())", "context": {"id": "ORD-17"}, "expected": false},
    {"formula": "R = REF()", "inputs": {"R": "Order:ORD-17"}, "context": {"id": "ORD-17"}, "expected": true},
    {"formula": "R = REF()", "inputs": {"R": "Order:ORD-18"}, "context": {"id": "ORD-17"}, "expected": false},
    {"formula": "R <> REF()", "inputs": {"R": "Invoice:ORD-17"}, "context": {"id": "ORD-17"}, "expected": true},
    {"formula": "REF() = REF(\"Order\", ID())", "context": {"id": "ORD-17"}, "expected": true},
    {"formula": "REF() = REF(\"Order\", S)", "inputs": {"S": "ORD-18"}, "context": {"id": "ORD-17"}, "expected": false},
    {"formula": "TEXT(REF())", "context": {"id": "ORD-17"}, "expected": "Order:ORD-17"},
    {"formula": "IF(R = REF(), \"this one\", \"another\")", "inputs": {"R": "Order:ORD-17"}, "context": {"id": "ORD-17"}, "expected": "this one"},
    {"formula": "IF(R = REF(), \"this one\", \"another\")", "context": {"id": "ORD-17"}, "expected": "another"}
  ]
}
