{
  "suite": "roles",
  "description": "INROLE answers whether the caller holds a role of the app the formula belongs to (ADR-0100). The engine works out the roles a caller holds from who holds each role on the database; a case gives them as app.role. A role is not a group: INGROUP never answers one, whatever its name, and INROLE never answers a group. The names mean the same whatever their case.",
  "app": "Expenses",
  "roles": ["approver", "finance"],
  "cases": [
    {"formula": "INROLE(\"approver\")", "context": {"user": "bob", "roles": ["Expenses.approver"]}, "expected": true},
    {"formula": "INROLE(\"finance\")", "context": {"user": "bob", "roles": ["Expenses.approver"]}, "expected": false},
    {"name": "a caller who holds no role", "formula": "INROLE(\"approver\")", "context": {"user": "carl"}, "expected": false},
    {"name": "a system recompute holds no role", "formula": "INROLE(\"approver\")", "expected": false},
    {"name": "the case of a name does not matter", "formula": "INROLE(\"APPROVER\")", "context": {"user": "bob", "roles": ["expenses.Approver"]}, "expected": true},
    {"name": "a role of another app is not this app's", "formula": "INROLE(\"approver\")", "context": {"user": "bob", "roles": ["Travel.approver"]}, "expected": false},
    {"name": "a group of the role's name is no role", "formula": "INROLE(\"approver\")", "context": {"user": "bob", "groups": ["approver", "Expenses.approver"]}, "expected": false},
    {"name": "a role is no group", "formula": "INGROUP(\"Expenses.approver\") OR INGROUP(\"approver\")", "context": {"user": "bob", "roles": ["Expenses.approver"]}, "expected": false},
    {"name": "roles beside groups and system groups", "formula": "INROLE(\"finance\") AND INGROUP(\"staff\") AND INGROUP(\"designers\")", "context": {"user": "ann", "groups": ["staff"], "system": ["designers"], "roles": ["Expenses.approver", "Expenses.finance"]}, "expected": true},
    {"name": "several roles, each answered", "formula": "IF(INROLE(\"approver\"), 1, 0) + IF(INROLE(\"finance\"), 2, 0)", "context": {"user": "ann", "roles": ["Expenses.finance", "Expenses.approver"]}, "expected": 3}
  ]
}
