{
  "suite": "text",
  "description": "Text literals with the doubled-quote escape, code-point positions and lengths, Unicode case mapping, TEXT and VALUE conversions (ADR-0019).",
  "variables": {"Code": "text", "Amount": "number"},
  "cases": [
    {"name": "literal quoting: a doubled quote is one quote", "formula": "\"abc\"", "expected": "abc"},
    {"formula": "\"\"", "expected": ""},
    {"formula": "\"\"\"\"", "expected": "\""},
    {"formula": "\"\"\"\"\"\"", "expected": "\"\""},
    {"formula": "\"it\"\"s\"", "expected": "it\"s"},
    {"formula": "\"say 'hi'\"", "expected": "say 'hi'"},
    {"formula": "\"\" & \"x\"", "expected": "x"},
    {"formula": "\"żółw\"", "expected": "żółw"},
    {"name": "LEN counts code points", "formula": "LEN(\"abc\")", "expected": 3},
    {"formula": "LEN(\"żółw\")", "expected": 4},
    {"formula": "LEN(\"\")", "expected": 0},
    {"formula": "LEN(Code)", "inputs": {"Code": "A-12"}, "expected": 4},
    {"formula": "LEN(Code) + 1", "inputs": {"Code": "A-12"}, "expected": 5},
    {"name": "case mapping is Unicode", "formula": "UPPER(\"żółw\")", "expected": "ŻÓŁW"},
    {"formula": "LOWER(\"ŻÓŁW\")", "expected": "żółw"},
    {"formula": "UPPER(\"abc\")", "expected": "ABC"},
    {"formula": "LOWER(\"ABC\")", "expected": "abc"},
    {"formula": "UPPER(Code)", "inputs": {"Code": "a-1"}, "expected": "A-1"},
    {"formula": "PROPER(\"hello world\")", "expected": "Hello World"},
    {"formula": "PROPER(\"HELLO\")", "expected": "Hello"},
    {"name": "positions are 1-based", "formula": "LEFT(\"hello\", 2)", "expected": "he"},
    {"formula": "LEFT(\"hello\", 10)", "expected": "hello"},
    {"formula": "LEFT(\"hello\", 0)", "expected": ""},
    {"formula": "LEFT(\"żółw\", 2)", "expected": "żó"},
    {"formula": "RIGHT(\"hello\", 3)", "expected": "llo"},
    {"formula": "RIGHT(\"hello\", 10)", "expected": "hello"},
    {"formula": "MID(\"hello\", 2, 3)", "expected": "ell"},
    {"formula": "MID(\"hello\", 4)", "expected": "lo"},
    {"formula": "MID(\"hello\", 10, 2)", "expected": ""},
    {"formula": "MID(\"żółw\", 2, 2)", "expected": "ół"},
    {"formula": "LEFT(\"hello\", -1)", "error": "out_of_range"},
    {"formula": "RIGHT(\"hello\", -1)", "error": "out_of_range"},
    {"formula": "MID(\"hello\", 0, 2)", "error": "out_of_range"},
    {"formula": "MID(\"hello\", 2, -1)", "error": "out_of_range"},
    {"formula": "LEFT(\"hello\", 1.9)", "expected": "h"},
    {"name": "TRIM collapses inner runs of spaces, as in Excel", "formula": "TRIM(\"  a  b  \")", "expected": "a b"},
    {"formula": "TRIM(\"abc\")", "expected": "abc"},
    {"formula": "TRIM(\"\")", "expected": ""},
    {"name": "FIND is case-sensitive and 0 when absent", "formula": "FINDFIRST(\"l\", \"hello\")", "expected": 3},
    {"formula": "FIND(\"l\", \"hello\")", "expected": 3},
    {"formula": "FINDLAST(\"l\", \"hello\")", "expected": 4},
    {"formula": "FIND(\"z\", \"hello\")", "expected": 0},
    {"formula": "FIND(\"L\", \"hello\")", "expected": 0},
    {"formula": "FIND(\"\", \"hello\")", "expected": 1},
    {"formula": "FIND(\"ł\", \"żółw\")", "expected": 3},
    {"formula": "LEFT(Code, FINDLAST(\"-\", Code) - 1)", "inputs": {"Code": "ab-cd-ef"}, "expected": "ab-cd"},
    {"formula": "SUBSTITUTE(\"a-b-c\", \"-\", \"\")", "expected": "abc"},
    {"formula": "SUBSTITUTE(Code, \"-\", \"/\")", "inputs": {"Code": "a-b"}, "expected": "a/b"},
    {"formula": "SUBSTITUTE(\"aaa\", \"a\", \"bb\")", "expected": "bbbbbb"},
    {"formula": "REPLACE(\"hello\", 1, 1, \"J\")", "expected": "Jello"},
    {"formula": "REPLACE(\"hello\", 2, 3, \"ipp\")", "expected": "hippo"},
    {"formula": "REPLACE(\"hello\", 6, 0, \"!\")", "expected": "hello!"},
    {"formula": "CONCAT(\"a\", \"b\", \"c\")", "expected": "abc"},
    {"formula": "CONCAT(\"n=\", 5)", "expected": "n=5"},
    {"formula": "CONCAT(\"x\")", "expected": "x"},
    {"formula": "REPEAT(\"ab\", 3)", "expected": "ababab"},
    {"formula": "REPEAT(\"ab\", 0)", "expected": ""},
    {"formula": "REPEAT(\"ab\", -1)", "error": "out_of_range"},
    {"formula": "PAD(\"7\", 3, \"0\")", "expected": "007"},
    {"formula": "PAD(\"7\", 3)", "expected": "  7"},
    {"formula": "PAD(\"1234\", 3, \"0\")", "expected": "1234"},
    {"formula": "REGEXREPLACE(\"a1b22c\", \"[0-9]+\", \"#\")", "expected": "a#b#c"},
    {"formula": "REGEXREPLACE(\"hello\", \"l+\", \"L\")", "expected": "heLo"},
    {"name": "the replacement is literal text, not a template", "formula": "REGEXREPLACE(\"ab\", \"(a)\", \"$1x\")", "expected": "$1xb"},
    {"formula": "REGEXREPLACE(\"a.b\", \"\\.\", \"-\")", "expected": "a-b"},
    {"name": "TEXT renders 15 significant digits without trailing zeros", "formula": "TEXT(1)", "expected": "1"},
    {"formula": "TEXT(1.5)", "expected": "1.5"},
    {"formula": "TEXT(-1.5)", "expected": "-1.5"},
    {"formula": "TEXT(100)", "expected": "100"},
    {"formula": "TEXT(0.1 + 0.2)", "expected": "0.3"},
    {"formula": "TEXT(1 / 3)", "expected": "0.333333333333333"},
    {"formula": "TEXT(2 / 3)", "expected": "0.666666666666667"},
    {"formula": "TEXT(1234567.891)", "expected": "1234567.891"},
    {"formula": "TEXT(123456789012345)", "expected": "123456789012345"},
    {"formula": "TEXT(1e15)", "expected": "1e+15"},
    {"formula": "TEXT(1e20)", "expected": "1e+20"},
    {"formula": "TEXT(0.0001)", "expected": "0.0001"},
    {"formula": "TEXT(0.00001)", "expected": "1e-05"},
    {"formula": "TEXT(0)", "expected": "0"},
    {"formula": "TEXT(-0)", "expected": "0"},
    {"formula": "TEXT(Amount)", "inputs": {"Amount": 2.5}, "expected": "2.5"},
    {"formula": "TEXT(TRUE)", "expected": "TRUE"},
    {"formula": "TEXT(FALSE)", "expected": "FALSE"},
    {"formula": "TEXT(BLANK)", "expected": ""},
    {"formula": "TEXT(\"abc\")", "expected": "abc"},
    {"formula": "TEXT(DATE(2024, 1, 31))", "expected": "2024-01-31"},
    {"formula": "TEXT(DATETIMEVALUE(\"2024-01-31 10:30:00\"))", "expected": "2024-01-31 10:30:00"},
    {"name": "a datetime always shows its clock", "formula": "TEXT(DATETIMEVALUE(\"2024-01-31\"))", "expected": "2024-01-31 00:00:00"},
    {"name": "VALUE reads a plain decimal number", "formula": "VALUE(\"12.5\")", "expected": 12.5},
    {"formula": "VALUE(\" 7 \")", "expected": 7},
    {"formula": "VALUE(\"1e3\")", "expected": 1000},
    {"formula": "VALUE(\"-3\")", "expected": -3},
    {"formula": "VALUE(\"+3\")", "expected": 3},
    {"formula": "VALUE(\".5\")", "expected": 0.5},
    {"formula": "VALUE(\"0.333333333333333\")", "expected": 0.333333333333333},
    {"formula": "VALUE(TEXT(1 / 3)) = 1 / 3", "expected": false},
    {"formula": "VALUE(\"\")", "expected": null},
    {"formula": "VALUE(\"   \")", "expected": null},
    {"formula": "VALUE(Code)", "expected": null},
    {"formula": "VALUE(Code)", "inputs": {"Code": "42"}, "expected": 42},
    {"formula": "VALUE(\"abc\")", "error": "bad_text"},
    {"formula": "VALUE(\"1,5\")", "error": "bad_text"},
    {"formula": "VALUE(\"12abc\")", "error": "bad_text"},
    {"formula": "VALUE(\"1 000\")", "error": "bad_text"},
    {"formula": "VALUE(\"inf\")", "error": "bad_text"},
    {"formula": "VALUE(\"0x10\")", "error": "bad_text"},
    {"name": "text functions read a blank as the empty text", "formula": "LEN(Code)", "expected": 0},
    {"formula": "UPPER(Code) & \"!\"", "expected": "!"},
    {"formula": "LEFT(Code, 2)", "expected": ""},
    {"formula": "FIND(\"a\", Code)", "expected": 0},
    {"name": "a count past the end of the text reads to the end", "formula": "LEFT(\"abc\", 1e10)", "expected": "abc"},
    {"formula": "RIGHT(\"abc\", 1e10)", "expected": "abc"},
    {"formula": "MID(\"abc\", 2, 1e10)", "expected": "bc"},
    {"formula": "REPLACE(\"abc\", 2, 1e300, \"x\")", "expected": "ax"},
    {"name": "a huge position is past the end", "formula": "MID(\"abc\", 1e300)", "expected": ""},
    {"formula": "REPLACE(\"abc\", 1e300, 1, \"x\")", "expected": "abcx"},
    {"name": "a result longer than the text limit, 65536 code points by default, is out of range (ADR-0021)", "formula": "PAD(\"x\", 65537)", "error": "out_of_range"},
    {"formula": "LEN(PAD(\"x\", 65536))", "expected": 65536},
    {"formula": "REPEAT(\"ab\", 32769)", "error": "out_of_range"},
    {"formula": "LEN(REPEAT(\"ab\", 32768))", "expected": 65536},
    {"name": "the limit counts code points", "formula": "LEN(REPEAT(\"日本語\", 20000))", "expected": 60000},
    {"formula": "REPEAT(\"日本語\", 21846)", "error": "out_of_range"},
    {"name": "every text builder decides before it builds", "formula": "SUBSTITUTE(REPEAT(\"a\", 10000), \"a\", \"bbbbbbbbbb\")", "error": "out_of_range"},
    {"formula": "LEN(SUBSTITUTE(REPEAT(\"a\", 6000), \"a\", \"bbbbbbbbbb\"))", "expected": 60000},
    {"formula": "REPEAT(\"x\", 40000) & REPEAT(\"y\", 30000)", "error": "out_of_range"},
    {"formula": "LEN(REPEAT(\"x\", 30000) & REPEAT(\"y\", 30000))", "expected": 60000},
    {"formula": "CONCAT(REPEAT(\"x\", 30000), REPEAT(\"y\", 30000), REPEAT(\"z\", 30000))", "error": "out_of_range"},
    {"formula": "REPLACE(REPEAT(\"x\", 60000), 1, 0, REPEAT(\"y\", 6000))", "error": "out_of_range"},
    {"formula": "LEN(REPLACE(REPEAT(\"x\", 60000), 1, 10000, REPEAT(\"y\", 10000)))", "expected": 60000},
    {"formula": "REGEXREPLACE(REPEAT(\"a\", 10000), \"a\", \"bbbbbbbbbb\")", "error": "out_of_range"},
    {"formula": "LEN(REGEXREPLACE(REPEAT(\"a\", 6000), \"a\", \"bbbbbbbbbb\"))", "expected": 60000},
    {"formula": "REGEXREPLACE(REPEAT(\"a\", 30000), \"\", \"--\")", "error": "out_of_range"}
  ]
}
