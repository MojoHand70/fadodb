{
  "suite": "calls",
  "description": "A rule names an action that has a definition and gives its arguments under args (ADR-0045, items 1, 4, 5 and 9). The commit evaluates the arguments, each a formula typed against its parameter or a template for a json parameter, and queues a row; the worker calls the action's function with them, by parameter, and with the event that fired the rule and the document at that version. The call happens outside any transaction, at least once, each time with the same key. An action that gets no answer is asked again with a doubling wait and a counted attempt; one that refuses is dead at once; a required argument that is blank is a refusal and the function is not called. The document that caused the action gets one event either way. A trial runs an action outside any document, a preview shows the call and calls nothing, and the catalogue lists the engine's actions and the defined ones.",
  "clock": "2026-03-01 12:00:00",
  "actions": [
    {"name": "books.post", "label": "Post to the books", "description": "Books an invoice and answers the entry.",
     "params": {"invoice": {"type": "text", "required": true, "description": "The number of the invoice"},
                "amount": "decimal(2)", "day": "date", "urgent": "bool", "payload": "json", "note": "text"},
     "returns": {"entry": "text"}},
    {"name": "mail.send", "params": {"to": {"type": "text", "required": true}, "subject": "text"}},
    {"name": "period.check"},
    {"name": "audit.ping", "params": {"at": "datetime"}}
  ],
  "functions": {
    "books.post": {"returns": {"entry": "E-1"}},
    "mail.send": {"fails": 2},
    "period.check": {"refuses": "the period is closed"}
  },
  "class": {
    "name": "Invoice",
    "variables": {
      "number": {"type": "text"},
      "total": {"type": "decimal", "scale": 2},
      "due": {"type": "date"},
      "customer": {"type": "text"},
      "parts": {"type": "number", "default": "0"},
      "lines": {"type": "rows", "schema": {"sku": "text", "qty": "number"}},
      "meta": {"type": "json"}
    },
    "states": {"initial": "draft", "list": ["draft", "approved", "paid", "closed"]},
    "transitions": [
      {"name": "approve", "from": "draft", "to": "approved"},
      {"name": "pay", "from": "approved", "to": "paid"},
      {"name": "close", "from": ["draft", "approved", "paid"], "to": "closed"},
      {"name": "recount", "from": "draft", "to": "draft"}
    ],
    "rules": [
      {"on": "transition", "name": "approve",
       "do": [{"action": "books.post",
               "args": {"invoice": "number", "amount": "total", "day": "due", "urgent": "total > 1000",
                        "payload": {"number": "number", "total": "total", "state": "STATE()", "by": "USER()", "meta": "meta",
                                    "tags": ["\"invoice\"", 7, true, null]}}}]},
      {"on": "enter", "state": "paid",
       "do": [{"action": "mail.send", "args": {"to": "customer", "subject": "\"Paid: \" & number"}}]},
      {"on": "transition", "name": "close", "do": [{"action": "period.check"}]},
      {"on": "delete", "do": [{"action": "audit.ping", "args": {"at": "NOW()"}}]},
      {"on": "transition", "name": "recount",
       "do": [{"action": "books.post", "args": {"invoice": "number", "urgent": "1 / parts > 0"}}]}
    ]
  },
  "principals": {
    "alice": {"id": "alice", "groups": ["finance"]}
  },
  "script": [
    {"do": "create", "doc": "a", "as": "alice",
     "values": {"number": "INV-7", "total": "1250.00", "due": "2026-03-15", "customer": "ann@example.test", "lines": [{"sku": "A1", "qty": 2}], "meta": {"po": 9}},
     "expect": {"state": "draft", "version": 1, "calls": []}},

    {"name": "a preview shows the arguments the commit would queue, each by its parameter, and calls nothing", "do": "preview", "doc": "a", "as": "alice", "transition": "approve",
     "expect": {"state": "approved", "outbox": [], "calls": [],
                "queued": [{"action": "books.post",
                            "args": {"invoice": "INV-7", "amount": "1250.00", "day": "2026-03-15", "urgent": true,
                                     "payload": {"number": "INV-7", "total": "1250.00", "state": "draft", "by": "alice", "meta": {"po": 9}, "tags": ["invoice", 7, true, null]}}}]}},
    {"name": "the commit queues the action with the arguments of that moment and calls nothing", "do": "transition", "doc": "a", "as": "alice", "key": "approve-a", "transition": "approve",
     "expect": {"state": "approved", "version": 2, "calls": [],
                "outbox": [{"action": "books.post", "status": "pending", "attempts": 0, "depth": 0, "as": "alice",
                            "args": {"invoice": "INV-7", "amount": "1250.00", "day": "2026-03-15", "urgent": true,
                                     "payload": {"number": "INV-7", "total": "1250.00", "state": "draft", "by": "alice", "meta": {"po": 9}, "tags": ["invoice", 7, true, null]}}}]}},
    {"name": "the worker calls the function: every parameter by name, one not given as null, and the event with the document at that version", "do": "drain", "doc": "a",
     "expect": {"drained": 1,
                "calls": [{"attempt": 1, "action": "books.post",
                           "args": {"invoice": "INV-7", "amount": "1250.00", "day": "2026-03-15", "urgent": true, "note": null,
                                    "payload": {"number": "INV-7", "total": "1250.00", "state": "draft", "by": "alice", "meta": {"po": 9}, "tags": ["invoice", 7, true, null]}},
                           "event": {"kind": "transition", "class": "Invoice", "class_version": 1, "name": "approve", "from_state": "draft", "to_state": "approved",
                                     "version": 2, "actor_id": "alice", "command_key": "approve-a", "business_date": "2026-03-01", "ts": 1772366400,
                                     "document": {"class": "Invoice", "state": "approved", "version": 2, "class_version": 1,
                                                  "values": {"number": "INV-7", "total": "1250.00", "due": "2026-03-15", "customer": "ann@example.test",
                                                             "lines": [{"sku": "A1", "qty": 2}], "meta": {"po": 9}}}}}],
                "outbox": [{"action": "books.post", "status": "done", "attempts": 1}],
                "events": ["created", "transition:approve", "action_run:books.post"]}},

    {"name": "an action that gets no answer is asked again later", "do": "transition", "doc": "a", "as": "alice", "transition": "pay", "expect": {"state": "paid", "version": 3}},
    {"do": "drain", "doc": "a",
     "expect": {"drained": 1,
                "calls": [{"attempt": 1, "action": "mail.send", "args": {"to": "ann@example.test", "subject": "Paid: INV-7"},
                           "event": {"kind": "transition", "name": "pay", "to_state": "paid", "version": 3, "document": {"state": "paid", "version": 3}}}],
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "pending", "code": "action_error", "attempts": 1}],
                "events": ["created", "transition:approve", "action_run:books.post", "transition:pay"]}},
    {"name": "not before it is due", "do": "drain", "expect": {"drained": 0, "calls": []}},
    {"do": "wait", "seconds": 1, "expect": {}},
    {"name": "the second attempt, counted, a second after the first", "do": "drain", "doc": "a",
     "expect": {"drained": 1, "calls": [{"attempt": 2, "action": "mail.send"}],
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "pending", "code": "action_error", "attempts": 2}]}},
    {"do": "wait", "seconds": 1, "expect": {}},
    {"name": "the wait doubles", "do": "drain", "expect": {"drained": 0, "calls": []}},
    {"do": "wait", "seconds": 1, "expect": {}},
    {"name": "the third attempt runs: one event, for the outcome", "do": "drain", "doc": "a",
     "expect": {"drained": 1, "calls": [{"attempt": 3, "action": "mail.send", "event": {"version": 3}}],
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "done", "attempts": 3}],
                "events": ["created", "transition:approve", "action_run:books.post", "transition:pay", "action_run:mail.send"]}},

    {"name": "an action that refuses is dead at once, with what it said", "do": "transition", "doc": "a", "as": "alice", "transition": "close", "expect": {"state": "closed", "version": 4}},
    {"do": "drain", "doc": "a",
     "expect": {"drained": 1, "calls": [{"attempt": 1, "action": "period.check", "args": {}}],
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "done"}, {"action": "period.check", "status": "dead", "code": "action_error", "attempts": 1}],
                "events": ["created", "transition:approve", "action_run:books.post", "transition:pay", "action_run:mail.send", "transition:close", "action_failed:period.check"]}},
    {"name": "and is not asked again by itself", "do": "drain", "expect": {"drained": 0, "calls": []}},
    {"name": "retried by hand it is called again, from the first attempt", "do": "retry", "doc": "a", "row": 2, "expect": {}},
    {"do": "drain", "doc": "a",
     "expect": {"drained": 1, "calls": [{"attempt": 1, "action": "period.check"}],
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "done"}, {"action": "period.check", "status": "dead", "code": "action_error", "attempts": 1}],
                "events": ["created", "transition:approve", "action_run:books.post", "transition:pay", "action_run:mail.send", "transition:close", "action_failed:period.check", "action_failed:period.check"]}},

    {"name": "a required argument that is blank is queued and refused: the function is not called", "do": "create", "doc": "b", "as": "alice", "values": {"number": "INV-8"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "b", "as": "alice", "transition": "approve", "expect": {"state": "approved", "version": 2}},
    {"name": "an argument that is blank arrives as null", "do": "drain", "doc": "b",
     "expect": {"drained": 1, "calls": [{"action": "books.post", "args": {"invoice": "INV-8", "amount": null, "day": null, "urgent": false, "payload": {"number": "INV-8", "total": null, "meta": null}}}]}},
    {"do": "transition", "doc": "b", "as": "alice", "transition": "pay",
     "expect": {"state": "paid", "version": 3,
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "pending", "args": {"to": null, "subject": "Paid: INV-8"}}]}},
    {"do": "drain", "doc": "b",
     "expect": {"drained": 1, "calls": [],
                "outbox": [{"action": "books.post", "status": "done"}, {"action": "mail.send", "status": "dead", "code": "required", "attempts": 1}],
                "events": ["created", "transition:approve", "action_run:books.post", "transition:pay", "action_failed:mail.send"]}},

    {"name": "a rule on delete calls with the event of the delete and the document as it was", "do": "delete", "doc": "b", "as": "alice", "expect": {}},
    {"do": "drain", "doc": "b",
     "expect": {"drained": 1,
                "calls": [{"action": "audit.ping", "args": {"at": 1772366403},
                           "event": {"kind": "deleted", "class": "Invoice", "version": 3, "actor_id": "alice", "document": {"state": "paid", "version": 3, "values": {"number": "INV-8"}}}}]}},

    {"name": "an argument that errors refuses the command, with the action's path, and queues nothing", "do": "create", "doc": "c", "values": {"number": "INV-9"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "c", "transition": "recount", "expect": {"code": "div_by_zero", "action": "/rules/4/do/0"}},
    {"do": "get", "doc": "c", "expect": {"state": "draft", "version": 1, "outbox": []}},
    {"name": "a preview records it and goes on", "do": "preview", "doc": "c", "transition": "recount",
     "expect": {"state": "draft", "errors": [{"code": "div_by_zero", "variable": "urgent", "action": "/rules/4/do/0"}], "queued": [{"action": "books.post"}], "calls": []}},

    {"name": "a trial runs the action once outside any document: values in, the result out, no event", "do": "try", "action": "books.post", "args": {"invoice": "INV-10", "amount": 12.5, "day": "2026-04-01"},
     "expect": {"outcome": {"action": "books.post", "ok": true, "result": {"entry": "E-1"}},
                "calls": [{"attempt": 1, "action": "books.post", "args": {"invoice": "INV-10", "amount": "12.50", "day": "2026-04-01", "urgent": null, "payload": null, "note": null}, "event": null}]}},
    {"name": "a trial that gets no answer says so, and that the outbox would ask again", "do": "try", "action": "mail.send", "args": {"to": "x@example.test"},
     "expect": {"outcome": {"ok": false, "code": "action_error", "retry": true}, "calls": [{"attempt": 1}]}},
    {"name": "a trial that is refused says what the action said", "do": "try", "action": "period.check",
     "expect": {"outcome": {"ok": false, "code": "action_error", "message": "the period is closed"}}},
    {"name": "the arguments of a trial are checked as the worker checks them", "do": "try", "action": "books.post", "args": {"invoice": "INV-10", "memo": "x"}, "expect": {"code": "unknown_parameter"}},
    {"do": "try", "action": "books.post", "args": {"amount": "1.00"}, "expect": {"code": "required"}},
    {"do": "try", "action": "books.post", "args": {"invoice": 7}, "expect": {"code": "bad_value"}},
    {"do": "try", "action": "books.post", "args": {"invoice": "INV-10", "amount": "1.005"}, "expect": {"code": "bad_value"}},
    {"do": "try", "action": "slack.post", "args": {"text": "x"}, "expect": {"code": "unknown_action"}},
    {"name": "an engine action acts on a document and is not tried alone", "do": "try", "action": "create", "expect": {"code": "not_allowed"}},

    {"name": "a preview of an action shows the call and calls nothing", "do": "preview_action", "action": "Books.Post", "args": {"INVOICE": "INV-11", "urgent": true, "payload": {"a": [1, "b"]}},
     "expect": {"call": {"attempt": 1, "action": "books.post", "args": {"invoice": "INV-11", "amount": null, "urgent": true, "payload": {"a": [1, "b"]}}}, "calls": []}},

    {"name": "the catalogue lists the engine's actions and the defined ones, with their parameters", "do": "actions",
     "expect": {"catalogue": [
       {"name": "set", "kind": "engine", "sync": true, "available": true, "params": [{"name": "values", "type": "formulas", "required": true}]},
       {"name": "create", "kind": "engine", "available": true},
       {"name": "table.update", "kind": "engine", "available": true},
       {"name": "books.post", "kind": "registered", "version": 1, "available": true, "label": "Post to the books",
        "params": [{"name": "invoice", "type": "text", "required": true, "description": "The number of the invoice"}, {"name": "amount", "type": "decimal(2)"}, {"name": "day", "type": "date"},
                   {"name": "urgent", "type": "bool"}, {"name": "payload", "type": "json"}, {"name": "note", "type": "text"}],
        "returns": [{"name": "entry", "type": "text"}]},
       {"name": "period.check", "kind": "registered", "version": 1, "available": true}
     ]}}
  ]
}
