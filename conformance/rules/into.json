{
  "suite": "into",
  "description": "The result of an action comes back to the document that caused it (ADR-0045, item 8). An action of the outbox may carry into, a map from input variables of the rule's own document to formulas over what the action returns, with OK, whether it ran, and ERROR, the code it failed with. When the action is done or dead, the engine writes those values as a set on the document, in the transaction that marks the action: a commit of its own with an event of kind set. It is the engine's write, so no write right is consulted. Like any set it raises values_change and is followed by the eventless transitions: the process goes on from the answer, and from a failure too. A document that is frozen or gone, or that refuses a value, leaves the action's outcome as it stands, and the row says why the result was not stored. A create returns the id of the document it made and a transition the state and the version it left its document in.",
  "clock": "2026-03-01 12:00:00",
  "outbound": {"hosts": ["hooks.example"]},
  "replies": [{"url": "https://hooks.example/orders", "status": 201, "body": {"id": 7}}],
  "actions": [
    {"name": "pay.charge", "params": {"amount": "decimal(2)", "card": "text"}, "returns": {"payment": "text", "fee": "decimal(2)"}},
    {"name": "pay.decline", "params": {"card": "text"}, "returns": {"payment": "text"}},
    {"name": "label.print", "returns": {"code": "text"}},
    {"name": "risk.score", "returns": {"score": "number"}}
  ],
  "functions": {
    "pay.charge": {"returns": {"payment": "pay_1", "fee": "1.5"}},
    "pay.decline": {"refuses": "the card was declined"},
    "label.print": {"returns": {"code": 12}},
    "risk.score": {"fails": 1, "returns": {"score": 0.4}}
  },
  "class": {
    "name": "Order",
    "variables": {
      "total": {"type": "decimal", "scale": 2},
      "card": {"type": "text"},
      "payment_id": {"type": "text"},
      "fee": {"type": "decimal", "scale": 2},
      "pay_error": {"type": "text"},
      "charged": {"type": "bool"},
      "note": {"type": "text"},
      "child": {"type": "text"},
      "child_state": {"type": "text"},
      "n": {"type": "number"},
      "level": {"type": "text", "values": ["low", "high"]}
    },
    "states": {"initial": "new", "list": ["new", "charging", "paid", "failed", "shelved", "closed"], "final": ["closed"]},
    "transitions": [
      {"name": "charge", "from": "new", "to": "charging"},
      {"from": "charging", "to": "paid", "guard": "NOT ISBLANK(payment_id)"},
      {"from": "charging", "to": "failed", "guard": "NOT ISBLANK(pay_error)"},
      {"name": "shelve", "from": "new", "to": "shelved"},
      {"name": "close", "from": "shelved", "to": "closed"},
      {"name": "spawn", "from": "new", "to": "new"},
      {"name": "poke", "from": "new", "to": "new"},
      {"name": "hook", "from": "new", "to": "new"},
      {"name": "label", "from": "new", "to": "new"},
      {"name": "grade", "from": "new", "to": "new"},
      {"name": "score", "from": "new", "to": "new"},
      {"name": "ratio", "from": "new", "to": "new"}
    ],
    "rights": {"*": {"payment_id": {"write": ["nobody"]}}},
    "rules": [
      {"on": "enter", "state": "charging", "if": "card <> \"bad\"",
       "do": [{"action": "pay.charge", "args": {"amount": "total", "card": "card"},
               "into": {"payment_id": "payment", "fee": "fee", "pay_error": "ERROR", "charged": "OK"}}]},
      {"on": "enter", "state": "charging", "if": "card = \"bad\"",
       "do": [{"action": "pay.decline", "args": {"card": "card"}, "into": {"payment_id": "payment", "pay_error": "ERROR", "charged": "OK"}}]},
      {"on": "values_change", "variables": ["payment_id"], "do": [{"action": "set", "values": {"note": "\"paid with \" & payment_id"}}]},
      {"on": "exit", "state": "shelved", "do": [{"action": "pay.charge", "args": {"amount": "total"}, "into": {"note": "payment"}}]},
      {"on": "transition", "name": "spawn",
       "do": [{"action": "create", "class": "Order", "id": "ID() & \"-child\"", "values": {"total": "total"}, "into": {"child": "id"}}]},
      {"on": "transition", "name": "poke",
       "do": [{"action": "transition", "id": "child", "name": "charge", "into": {"child_state": "IF(OK, state, ERROR)", "n": "version"}}]},
      {"on": "transition", "name": "hook",
       "do": [{"action": "http.call", "args": {"url": "\"https://hooks.example/orders\"", "body": {"total": "total"}}, "into": {"n": "status", "charged": "OK"}}]},
      {"on": "transition", "name": "label", "do": [{"action": "label.print", "into": {"note": "code", "pay_error": "ERROR", "charged": "OK"}}]},
      {"on": "transition", "name": "grade", "do": [{"action": "pay.charge", "into": {"level": "payment", "note": "payment"}}]},
      {"on": "transition", "name": "score", "do": [{"action": "risk.score", "into": {"n": "score", "pay_error": "ERROR"}}]},
      {"on": "transition", "name": "ratio", "do": [{"action": "pay.charge", "into": {"note": "payment", "n": "1 / NUMBER(fee - fee)", "charged": "OK"}}]}
    ]
  },
  "principals": {
    "alice": {"id": "alice", "groups": ["sales"]}
  },
  "script": [
    {"do": "create", "doc": "a", "as": "alice", "values": {"total": "100.00", "card": "good"}, "expect": {"state": "new", "version": 1}},
    {"name": "a person may not set the payment's id", "do": "set", "doc": "a", "as": "alice", "values": {"payment_id": "forged"}, "expect": {"code": "forbidden"}},
    {"name": "a preview says where the result will go; it has no result to show", "do": "preview", "doc": "a", "as": "alice", "transition": "charge",
     "expect": {"state": "charging", "queued": [{"action": "pay.charge", "into": ["payment_id", "fee", "pay_error", "charged"]}]}},
    {"do": "transition", "doc": "a", "as": "alice", "transition": "charge",
     "expect": {"state": "charging", "version": 2, "values": {"payment_id": null, "charged": null}, "outbox": [{"action": "pay.charge", "status": "pending"}]}},
    {"name": "the action runs, and its result is written to the document", "do": "drain", "doc": "a",
     "expect": {"drained": 1, "calls": [{"action": "pay.charge", "event": {"version": 2}}],
                "outbox": [{"action": "pay.charge", "status": "done", "attempts": 1, "into_code": ""}]}},
    {"name": "as a set of the engine's own, which the eventless transition follows: the process went on from the answer", "do": "get", "doc": "a", "as": "alice",
     "expect": {"state": "paid", "version": 4,
                "values": {"payment_id": "pay_1", "fee": "1.50", "pay_error": null, "charged": true, "note": "paid with pay_1"},
                "history": ["new", "charging", "charging", "paid"],
                "events": ["created", "transition:charge", "action_run:pay.charge", "set", "transition:"]}},

    {"name": "a failure comes back too: OK is FALSE and ERROR the code", "do": "create", "doc": "b", "as": "alice", "values": {"total": "5.00", "card": "bad"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "b", "as": "alice", "transition": "charge", "expect": {"state": "charging", "version": 2}},
    {"do": "drain", "doc": "b",
     "expect": {"drained": 1, "outbox": [{"action": "pay.decline", "status": "dead", "code": "action_error", "attempts": 1, "into_code": ""}]}},
    {"name": "and the process goes on from it, by the other guard", "do": "get", "doc": "b",
     "expect": {"state": "failed", "version": 4, "values": {"payment_id": null, "pay_error": "action_error", "charged": false, "note": null},
                "events": ["created", "transition:charge", "action_failed:pay.decline", "set", "transition:"]}},
    {"name": "retried by hand it fails again, and a result that changes nothing commits nothing", "do": "retry", "doc": "b", "row": 0, "expect": {}},
    {"do": "drain", "doc": "b",
     "expect": {"drained": 1, "calls": [{"action": "pay.decline", "attempt": 1}], "outbox": [{"action": "pay.decline", "status": "dead", "code": "action_error", "into_code": ""}],
                "events": ["created", "transition:charge", "action_failed:pay.decline", "set", "transition:", "action_failed:pay.decline"]}},

    {"name": "a document that is frozen when the result arrives keeps what it has: the action's outcome stands", "do": "create", "doc": "c", "values": {"total": "9.00"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "c", "transition": "shelve", "expect": {"state": "shelved", "version": 2}},
    {"do": "transition", "doc": "c", "transition": "close", "expect": {"state": "closed", "version": 3, "outbox": [{"action": "pay.charge", "status": "pending"}]}},
    {"do": "drain", "doc": "c",
     "expect": {"drained": 1, "calls": [{"action": "pay.charge"}], "outbox": [{"action": "pay.charge", "status": "done", "into_code": "terminal"}],
                "events": ["created", "transition:shelve", "transition:close", "action_run:pay.charge"]}},
    {"do": "get", "doc": "c", "expect": {"state": "closed", "version": 3, "values": {"note": null}}},

    {"name": "a document that is gone when the result arrives", "do": "create", "doc": "d", "values": {"total": "3.00", "card": "good"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "d", "transition": "charge", "expect": {"state": "charging"}},
    {"do": "delete", "doc": "d", "expect": {}},
    {"do": "drain", "doc": "d",
     "expect": {"drained": 1, "outbox": [{"action": "pay.charge", "status": "done", "into_code": "unknown_document"}],
                "events": ["created", "transition:charge", "deleted", "action_run:pay.charge"]}},

    {"name": "a create returns the id of the document it made", "do": "create", "id": "E-1", "doc": "e", "values": {"total": "7.00"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "e", "transition": "spawn", "expect": {"state": "new", "version": 2}},
    {"do": "drain", "doc": "e", "expect": {"drained": 1, "outbox": [{"action": "create", "status": "done", "into_code": ""}]}},
    {"do": "get", "doc": "e", "expect": {"state": "new", "version": 3, "values": {"child": "E-1-child"}, "events": ["created", "transition:spawn", "action_run:create", "set"]}},
    {"do": "get", "id": "E-1-child", "expect": {"state": "new", "version": 1, "values": {"total": "7.00"}}},

    {"name": "a transition returns the state and the version it left the other document in", "do": "transition", "doc": "e", "transition": "poke", "expect": {"state": "new", "version": 4}},
    {"name": "the child is charged in the same drain, by its own rule", "do": "drain", "doc": "e",
     "expect": {"drained": 2, "outbox": [{"action": "create", "status": "done"}, {"action": "transition", "status": "done", "into_code": ""}]}},
    {"do": "get", "doc": "e", "expect": {"version": 5, "values": {"child_state": "charging", "n": 2}}},
    {"do": "get", "id": "E-1-child", "expect": {"state": "paid", "version": 4, "values": {"payment_id": "pay_1"}}},
    {"name": "a transition that is refused says so through ERROR", "do": "create", "doc": "f", "expect": {"version": 1}},
    {"do": "transition", "doc": "f", "transition": "poke", "expect": {"version": 2}},
    {"do": "drain", "doc": "f", "expect": {"drained": 1, "outbox": [{"action": "transition", "status": "dead", "code": "unknown_document", "into_code": ""}]}},
    {"do": "get", "doc": "f", "expect": {"version": 3, "values": {"child_state": "unknown_document", "n": null}}},

    {"name": "http.call returns the status of the reply", "do": "transition", "doc": "f", "transition": "hook", "expect": {"version": 4}},
    {"do": "drain", "doc": "f", "expect": {"drained": 1, "requests": [{"method": "POST", "url": "https://hooks.example/orders"}]}},
    {"do": "get", "doc": "f", "expect": {"version": 5, "values": {"n": 201, "charged": true}}},

    {"name": "an action that ran and returned what its definition does not declare: OK is TRUE, the values are blank and ERROR says bad_result", "do": "transition", "doc": "f", "transition": "label", "expect": {"version": 6}},
    {"do": "drain", "doc": "f",
     "expect": {"drained": 1, "outbox": [{"action": "transition", "status": "dead", "code": "unknown_document"}, {"action": "http.call", "status": "done"}, {"action": "label.print", "status": "done", "into_code": "bad_result"}]}},
    {"do": "get", "doc": "f", "expect": {"version": 7, "values": {"note": null, "pay_error": "bad_result", "charged": true}}},

    {"name": "a value the document refuses stores nothing of the result, and the row says why", "do": "transition", "doc": "f", "transition": "grade", "expect": {"version": 8}},
    {"do": "drain", "doc": "f",
     "expect": {"drained": 1, "outbox": [{"action": "transition", "status": "dead", "code": "unknown_document"}, {"action": "http.call", "status": "done"}, {"action": "label.print", "status": "done"},
                                         {"action": "pay.charge", "status": "done", "into_code": "not_in_values"}]}},
    {"do": "get", "doc": "f", "expect": {"version": 8, "values": {"level": null, "note": null}}},

    {"name": "an action that waits for another attempt has not ended: nothing is written between attempts", "do": "create", "doc": "g", "expect": {"version": 1}},
    {"do": "transition", "doc": "g", "transition": "score", "expect": {"version": 2}},
    {"do": "drain", "doc": "g", "expect": {"drained": 1, "outbox": [{"action": "risk.score", "status": "pending", "code": "action_error", "attempts": 1, "into_code": ""}]}},
    {"do": "get", "doc": "g", "expect": {"version": 2, "values": {"n": null, "pay_error": null}, "events": ["created", "transition:score"]}},
    {"do": "wait", "seconds": 1, "expect": {}},
    {"do": "drain", "doc": "g", "expect": {"drained": 1, "outbox": [{"action": "risk.score", "status": "done", "attempts": 2, "into_code": ""}]}},
    {"do": "get", "doc": "g", "expect": {"version": 3, "values": {"n": 0.4, "pay_error": null}, "events": ["created", "transition:score", "action_run:risk.score", "set"]}},

    {"name": "a formula of the result that fails stores nothing of the result, not the values beside it", "do": "transition", "doc": "g", "transition": "ratio", "expect": {"version": 4}},
    {"do": "drain", "doc": "g",
     "expect": {"drained": 1, "outbox": [{"action": "risk.score", "status": "done"}, {"action": "pay.charge", "status": "done", "into_code": "div_by_zero"}]}},
    {"do": "get", "doc": "g", "expect": {"version": 4, "values": {"note": null, "n": 0.4, "charged": null}}}
  ]
}
