{
  "suite": "requests",
  "description": "A declared action is a definition with a request, which the engine sends (ADR-0045, items 3 to 7). The address, the headers and the body are pure formulas over the arguments the commit stored and over the secrets of the definition's connection, which the host program supplies when the request is sent and which are in no row, no event and no preview. A request with a connection goes only to the hosts of that connection, and one without reads no secret. A reply of 2xx for which ok is TRUE is the action run; no reply, 408, 429 and 5xx are no answer, asked again, no sooner than the reply's Retry-After asks; any other reply, and a 2xx for which ok is not TRUE, is a refusal. A request without a body of its own carries the call: the arguments and the event that fired the rule. http.call is the engine's own declared action, for a call nobody named.",
  "clock": "2026-03-01 12:00:00",
  "outbound": {
    "hosts": ["hooks.example", "rates.example"],
    "connections": {"slack": ["slack.com"], "books": ["books.example"], "sms": ["sms.example"], "vault": ["vault.example"]}
  },
  "secrets": {
    "slack": {"token": "xoxb-conformance"},
    "books": {"signing_key": "whsec-conformance"},
    "sms": {"sid": "AC42", "key": "sk-conformance"}
  },
  "replies": [
    {"url": "https://slack.com/api/chat.postMessage", "body": {"ok": true, "ts": "1700000000.000100"}},
    {"url": "https://slack.com/api/chat.postMessage", "status": 500, "text": "upstream down"},
    {"url": "https://slack.com/api/chat.postMessage", "status": 429, "retry_after": 30},
    {"url": "https://slack.com/api/chat.postMessage", "body": {"ok": true, "ts": "1700000001.000200"}},
    {"url": "https://slack.com/api/chat.postMessage", "body": {"ok": false, "error": "channel_not_found"}},
    {"url": "https://slack.com/api/chat.postMessage", "status": 403, "body": {"error": "invalid_auth"}},
    {"url": "https://slack.com/api/chat.postMessage", "no_reply": "dial tcp: connection refused"},
    {"url": "https://slack.com/api/chat.postMessage", "body": {"ok": true, "ts": "1700000002.000300"}},
    {"url": "https://slack.com/api/chat.postMessage", "body": {"ok": true, "ts": "1700000009.000900"}},
    {"url": "https://rates.example/v1/rate?pair=EUR%2FPLN", "body": {"rate": "4.25"}}
  ],
  "actions": [
    {"name": "slack.post", "label": "Post a message to Slack",
     "params": {"channel": {"type": "text", "required": true}, "text": {"type": "text", "required": true}},
     "returns": {"ts": "text"},
     "connection": {"name": "slack", "secrets": ["token"]},
     "request": {"method": "POST",
                 "url": "\"https://slack.com/api/chat.postMessage\"",
                 "headers": {"Authorization": "\"Bearer \" & SECRET(\"token\")"},
                 "body": {"channel": "channel", "text": "text"}},
     "ok": "JSONVALUE(BODY, \"ok\") = \"TRUE\"",
     "result": {"ts": "JSONVALUE(BODY, \"ts\")"}},
    {"name": "books.post", "label": "Tell the books",
     "params": {"invoice": {"type": "text", "required": true}},
     "connection": {"name": "books", "secrets": ["signing_key"]},
     "request": {"url": "\"https://books.example/hooks/fadodb\"", "sign": "signing_key"}},
    {"name": "rates.get",
     "params": {"pair": {"type": "text", "required": true}},
     "returns": {"rate": "decimal(4)"},
     "request": {"method": "GET", "url": "\"https://rates.example/v1/rate?pair=\" & URLENCODE(pair)"},
     "result": {"rate": "DECIMALVALUE(JSONVALUE(BODY, \"rate\"), 4)"}},
    {"name": "sms.send",
     "params": {"to": {"type": "text", "required": true}, "text": "text"},
     "connection": {"name": "sms", "secrets": ["sid", "key"]},
     "request": {"url": "\"https://sms.example/v1/accounts/\" & SECRET(\"sid\") & \"/messages\"",
                 "headers": {"Content-Type": "\"application/x-www-form-urlencoded\"", "Authorization": "\"Key \" & SECRET(\"key\")"},
                 "body": "\"To=\" & URLENCODE(to) & \"&Body=\" & URLENCODE(text)"}},
    {"name": "vault.ping",
     "connection": {"name": "vault", "secrets": ["token"]},
     "request": {"url": "\"https://vault.example/ping\"", "headers": {"X-Token": "SECRET(\"token\")"}}}
  ],
  "class": {
    "name": "Invoice",
    "variables": {
      "number": {"type": "text"},
      "total": {"type": "decimal", "scale": 2},
      "channel": {"type": "text", "default": "\"#finance\""},
      "phone": {"type": "text"}
    },
    "states": {"initial": "draft", "list": ["draft", "approved", "paid", "closed"]},
    "transitions": [
      {"name": "approve", "from": "draft", "to": "approved"},
      {"name": "pay", "from": "approved", "to": "paid"},
      {"name": "close", "from": ["draft", "approved", "paid"], "to": "closed"},
      {"name": "remind", "from": "draft", "to": "draft"},
      {"name": "leak", "from": "draft", "to": "draft"},
      {"name": "ping", "from": "draft", "to": "draft"}
    ],
    "rules": [
      {"on": "transition", "name": "approve",
       "do": [{"action": "slack.post", "args": {"channel": "channel", "text": "\"Approved: \" & number"}}]},
      {"on": "enter", "state": "paid", "do": [{"action": "books.post", "args": {"invoice": "number"}}]},
      {"on": "transition", "name": "close",
       "do": [{"action": "http.call", "args": {"url": "\"https://hooks.example/closed\"", "headers": {"X-Number": "number"}, "body": {"number": "number", "total": "total"}}}]},
      {"on": "transition", "name": "remind", "do": [{"action": "sms.send", "args": {"to": "phone", "text": "\"Pay \" & number"}}]},
      {"on": "transition", "name": "leak",
       "do": [{"action": "http.call", "args": {"url": "\"https://elsewhere.example/collect\"", "body": {"n": "number"}}}]},
      {"on": "transition", "name": "ping", "do": [{"action": "vault.ping"}]}
    ]
  },
  "principals": {
    "alice": {"id": "alice", "groups": ["finance"]}
  },
  "script": [
    {"do": "create", "doc": "a", "as": "alice", "values": {"number": "INV-7", "total": "1250.00"}, "expect": {"state": "draft", "version": 1, "requests": []}},

    {"name": "a preview of the action shows the request, the secret masked, and sends nothing", "do": "preview_action", "action": "slack.post", "args": {"channel": "#ops", "text": "hello"},
     "expect": {"request": {"method": "POST", "url": "https://slack.com/api/chat.postMessage", "connection": "slack",
                            "headers": {"Authorization": "Bearer ***", "Content-Type": "application/json", "FadoDB-Attempt": "1"},
                            "body": {"channel": "#ops", "text": "hello"}},
                "requests": []}},
    {"name": "the commit queues the arguments, and no secret", "do": "transition", "doc": "a", "as": "alice", "key": "approve-a", "transition": "approve",
     "expect": {"state": "approved", "version": 2, "requests": [],
                "outbox": [{"action": "slack.post", "status": "pending", "attempts": 0, "args": {"channel": "#finance", "text": "Approved: INV-7"}}]}},
    {"name": "the worker sends the request over the connection, with the secret the host supplied and the engine's own headers", "do": "drain", "doc": "a",
     "expect": {"drained": 1,
                "requests": [{"method": "POST", "url": "https://slack.com/api/chat.postMessage", "connection": "slack",
                              "headers": {"Authorization": "Bearer xoxb-conformance", "Content-Type": "application/json", "User-Agent": "FadoDB", "FadoDB-Attempt": "1"},
                              "body": {"channel": "#finance", "text": "Approved: INV-7"}}],
                "outbox": [{"action": "slack.post", "status": "done", "attempts": 1}],
                "events": ["created", "transition:approve", "action_run:slack.post"]}},

    {"name": "a reply of 5xx is no answer: asked again", "do": "create", "doc": "b", "values": {"number": "INV-8"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "b", "transition": "approve", "expect": {"state": "approved"}},
    {"do": "drain", "doc": "b",
     "expect": {"drained": 1, "requests": [{"headers": {"FadoDB-Attempt": "1"}}],
                "outbox": [{"action": "slack.post", "status": "pending", "code": "try_later", "attempts": 1}]}},
    {"do": "drain", "expect": {"drained": 0, "requests": []}},
    {"do": "wait", "seconds": 1, "expect": {}},
    {"name": "a 429 is no answer either, and its Retry-After moves the next attempt later", "do": "drain", "doc": "b",
     "expect": {"drained": 1, "requests": [{"headers": {"FadoDB-Attempt": "2"}}],
                "outbox": [{"action": "slack.post", "status": "pending", "code": "try_later", "attempts": 2}]}},
    {"do": "wait", "seconds": 2, "expect": {}},
    {"name": "the engine's own wait has passed and the receiver's has not", "do": "drain", "expect": {"drained": 0, "requests": []}},
    {"do": "wait", "seconds": 28, "expect": {}},
    {"do": "drain", "doc": "b",
     "expect": {"drained": 1, "requests": [{"headers": {"FadoDB-Attempt": "3"}, "body": {"text": "Approved: INV-8"}}],
                "outbox": [{"action": "slack.post", "status": "done", "attempts": 3}],
                "events": ["created", "transition:approve", "action_run:slack.post"]}},

    {"name": "a 2xx for which ok is not TRUE is a refusal: dead at once", "do": "create", "doc": "c", "values": {"number": "INV-9"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "c", "transition": "approve", "expect": {"state": "approved"}},
    {"do": "drain", "doc": "c",
     "expect": {"drained": 1, "requests": [{"method": "POST"}],
                "outbox": [{"action": "slack.post", "status": "dead", "code": "not_ok", "attempts": 1}],
                "events": ["created", "transition:approve", "action_failed:slack.post"]}},
    {"name": "any other status is a refusal too", "do": "create", "doc": "d", "values": {"number": "INV-10"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "d", "transition": "approve", "expect": {"state": "approved"}},
    {"do": "drain", "doc": "d", "expect": {"drained": 1, "outbox": [{"action": "slack.post", "status": "dead", "code": "refused", "attempts": 1}]}},
    {"name": "no reply at all is asked again", "do": "create", "doc": "e", "values": {"number": "INV-11"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "e", "transition": "approve", "expect": {"state": "approved"}},
    {"do": "drain", "doc": "e", "expect": {"drained": 1, "outbox": [{"action": "slack.post", "status": "pending", "code": "no_reply", "attempts": 1}]}},
    {"do": "wait", "seconds": 1, "expect": {}},
    {"do": "drain", "doc": "e", "expect": {"drained": 1, "outbox": [{"action": "slack.post", "status": "done", "attempts": 2}]}},

    {"name": "a request without a body of its own carries the call: the arguments and the event, with the document", "do": "transition", "doc": "a", "as": "alice", "transition": "pay", "expect": {"state": "paid", "version": 3}},
    {"do": "drain", "doc": "a",
     "expect": {"drained": 1,
                "requests": [{"method": "POST", "url": "https://books.example/hooks/fadodb", "connection": "books",
                              "headers": {"Content-Type": "application/json", "FadoDB-Attempt": "1"},
                              "body": {"attempt": 1, "action": "books.post", "args": {"invoice": "INV-7"},
                                       "event": {"kind": "transition", "name": "pay", "to_state": "paid", "version": 3, "actor_id": "alice",
                                                 "document": {"state": "paid", "version": 3, "values": {"number": "INV-7", "total": "1250.00"}}}}}],
                "outbox": [{"action": "slack.post", "status": "done"}, {"action": "books.post", "status": "done", "attempts": 1}]}},

    {"name": "http.call sends what the rule gives, to a host on the open list, with no connection and no secret", "do": "transition", "doc": "a", "as": "alice", "transition": "close",
     "expect": {"state": "closed", "version": 4,
                "outbox": [{"action": "slack.post", "status": "done"}, {"action": "books.post", "status": "done"},
                           {"action": "http.call", "status": "pending", "args": {"url": "https://hooks.example/closed", "headers": {"X-Number": "INV-7"}, "body": {"number": "INV-7", "total": "1250.00"}}}]}},
    {"do": "drain", "doc": "a",
     "expect": {"drained": 1,
                "requests": [{"method": "POST", "url": "https://hooks.example/closed", "connection": "",
                              "headers": {"X-Number": "INV-7", "Content-Type": "application/json", "FadoDB-Attempt": "1", "Authorization": null},
                              "body": {"number": "INV-7", "total": "1250.00"}}],
                "events": ["created", "transition:approve", "action_run:slack.post", "transition:pay", "action_run:books.post", "transition:close", "action_run:http.call"]}},
    {"name": "a host that is not on the list is not called: a refusal, and nothing was sent", "do": "create", "doc": "f", "values": {"number": "INV-12"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "f", "transition": "leak", "expect": {"state": "draft", "version": 2}},
    {"do": "drain", "doc": "f",
     "expect": {"drained": 1, "requests": [], "outbox": [{"action": "http.call", "status": "dead", "code": "host_not_allowed", "attempts": 1}],
                "events": ["created", "transition:leak", "action_failed:http.call"]}},

    {"name": "a body that is one text is sent as that text; a secret may be part of the address", "do": "create", "doc": "g", "values": {"number": "INV-13", "phone": "+48 600 100 200"}, "expect": {"version": 1}},
    {"do": "transition", "doc": "g", "transition": "remind", "expect": {"state": "draft", "version": 2}},
    {"do": "drain", "doc": "g",
     "expect": {"drained": 1,
                "requests": [{"method": "POST", "url": "https://sms.example/v1/accounts/AC42/messages", "connection": "sms",
                              "headers": {"Content-Type": "application/x-www-form-urlencoded", "Authorization": "Key sk-conformance"},
                              "text": "To=%2B48%20600%20100%20200&Body=Pay%20INV-13"}],
                "outbox": [{"action": "sms.send", "status": "done", "attempts": 1}]}},

    {"name": "a secret the host does not supply is no answer, and the request is not sent", "do": "transition", "doc": "g", "transition": "ping", "expect": {"state": "draft", "version": 3}},
    {"do": "drain", "doc": "g",
     "expect": {"drained": 1, "requests": [],
                "outbox": [{"action": "sms.send", "status": "done"}, {"action": "vault.ping", "status": "pending", "code": "secret_unavailable", "attempts": 1}]}},

    {"name": "a trial sends the request for real: a GET says everything in its address, and result reads the reply", "do": "try", "action": "rates.get", "args": {"pair": "EUR/PLN"},
     "expect": {"outcome": {"action": "rates.get", "ok": true, "result": {"rate": "4.2500"}},
                "requests": [{"method": "GET", "url": "https://rates.example/v1/rate?pair=EUR%2FPLN", "connection": "",
                              "headers": {"FadoDB-Attempt": "1", "FadoDB-Event": null, "Content-Type": null}, "body": null, "text": null}]}},
    {"do": "try", "action": "slack.post", "args": {"channel": "#ops", "text": "hi"},
     "expect": {"outcome": {"ok": true, "result": {"ts": "1700000009.000900"}}, "requests": [{"body": {"channel": "#ops", "text": "hi"}}]}},
    {"name": "a trial that the receiver does not confirm says so", "do": "try", "action": "slack.post", "args": {"channel": "#ops", "text": "hi"},
     "expect": {"outcome": {"ok": false, "code": "not_ok"}}},
    {"do": "try", "action": "vault.ping", "expect": {"outcome": {"ok": false, "code": "secret_unavailable", "retry": true}, "requests": []}},

    {"name": "a preview of a signed request shows the call as its body and masks the signature", "do": "preview_action", "action": "books.post", "args": {"invoice": "INV-1"},
     "expect": {"request": {"method": "POST", "url": "https://books.example/hooks/fadodb", "connection": "books",
                            "headers": {"FadoDB-Signature": "t=1772366432,v1=***"},
                            "body": {"attempt": 1, "action": "books.post", "args": {"invoice": "INV-1"}, "event": null}},
                "requests": []}},
    {"name": "a preview refuses what the outbound rules would refuse", "do": "preview_action", "action": "http.call", "args": {"url": "https://elsewhere.example/x"}, "expect": {"code": "host_not_allowed"}},
    {"do": "preview_action", "action": "http.call", "args": {"url": "ftp://hooks.example/x"}, "expect": {"code": "bad_value"}},
    {"do": "preview_action", "action": "http.call", "args": {"url": "https://hooks.example/x", "method": "FETCH"}, "expect": {"code": "bad_value"}},
    {"do": "preview_action", "action": "http.call", "args": {"url": "https://hooks.example/x", "headers": {"Idempotency-Key": "mine"}}, "expect": {"code": "bad_value"}},
    {"name": "a header is one line: a value cannot bring a header of its own", "do": "preview_action", "action": "http.call", "args": {"url": "https://hooks.example/x", "headers": {"X-A": "a\r\nX-Injected: 1"}}, "expect": {"code": "bad_value"}},
    {"do": "preview_action", "action": "http.call", "args": {"url": "https://user:pw@hooks.example/x"}, "expect": {"code": "bad_value"}},
    {"do": "preview_action", "action": "http.call", "args": {"url": "https://hooks.example/x", "headers": ["X-A"]}, "expect": {"code": "bad_value"}},
    {"do": "preview_action", "action": "http.call", "args": {"url": "https://hooks.example/x", "headers": {"X-A": {"nested": 1}}}, "expect": {"code": "bad_value"}},
    {"name": "http.call: a GET, and headers that are texts, numbers and bools", "do": "preview_action", "action": "http.call",
     "args": {"url": "https://hooks.example/x?n=1", "method": "get", "headers": {"X-A": "a", "X-N": 7, "X-B": true, "X-None": null}},
     "expect": {"request": {"method": "GET", "url": "https://hooks.example/x?n=1", "connection": "",
                            "headers": {"X-A": "a", "X-N": "7", "X-B": "TRUE", "X-None": null, "Content-Type": null}, "body": null}}},

    {"name": "the catalogue lists the declared actions with their connection and the secrets they read", "do": "actions",
     "expect": {"catalogue": [
       {"name": "http.call", "kind": "declared", "available": true, "params": [{"name": "url", "type": "text", "required": true}, {"name": "method", "type": "text"}, {"name": "headers", "type": "json"}, {"name": "body", "type": "json"}]},
       {"name": "slack.post", "kind": "declared", "version": 1, "available": true, "connection": "slack", "secrets": ["token"], "returns": [{"name": "ts", "type": "text"}]},
       {"name": "books.post", "kind": "declared", "connection": "books", "secrets": ["signing_key"], "available": true},
       {"name": "rates.get", "kind": "declared", "available": true, "connection": null, "secrets": null}
     ]}}
  ]
}
