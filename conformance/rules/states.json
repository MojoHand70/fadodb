{
  "suite": "states",
  "description": "The functions of a state in triggered variables, guards, access rules and rules (ADR-0047, item 6). They read the document's life from its events: what the log has, and the steps of the command in progress, the entry that the commit makes included. A transition back into the same state is an entry. An editor of a state is who created the document there or changed it there, not who moved it in or out. A filter is refused them.",
  "clock": "2026-03-01 12:00:00",
  "class": {"name": "Request", "variables": {"amount": {"type": "decimal(2)"}, "note": {"type": "text"}, "rounds": {"type": "number", "formula": "ENTRIES(\"review\")", "mode": "triggered", "on": ["enter:review"]}, "first_sent": {"type": "datetime", "formula": "FIRSTENTERED(\"review\")", "mode": "triggered", "on": ["enter:review"]}, "sent_by": {"type": "text", "formula": "FIRSTENTEREDBY(\"review\") & \"/\" & LASTENTEREDBY(\"review\")", "mode": "triggered", "on": ["enter:review"]}, "out": {"type": "text", "formula": "LASTLEFTBY(\"draft\") & \" after \" & TEXT(ENTRIES(\"draft\")) & \" in draft and \" & TEXT(ENTRIES(\"review\")) & \" in review\"", "mode": "triggered", "on": ["exit:draft"]}, "back_to": {"type": "text", "formula": "LASTEDITOR(\"draft\")", "mode": "triggered", "on": ["enter:draft"]}, "days": {"type": "number", "formula": "DAYSIN(\"review\")", "mode": "triggered", "on": ["refresh"]}, "here": {"type": "number", "formula": "DAYSIN(STATE())", "mode": "triggered", "on": ["refresh"]}, "summary": {"type": "text"}, "why": {"type": "text"}}, "states": {"initial": "draft", "list": ["draft", "review", "approved", "rejected"], "final": ["approved", "rejected"]}, "transitions": [{"name": "submit", "from": "draft", "to": "review"}, {"name": "back", "from": "review", "to": "draft"}, {"name": "remind", "from": "review", "to": "review"}, {"name": "approve", "from": "review", "to": "approved", "guard": "DAYSIN(\"review\") >= 1"}, {"from": "review", "to": "rejected", "guard": "ENTRIES(\"review\") > 3"}], "access": {"transition": {"approve": "FIRSTENTEREDBY(\"review\") <> USER()"}}, "rules": [{"on": "enter", "state": "approved", "do": [{"action": "set", "values": {"summary": "FIRSTEDITOR(\"draft\") & \">\" & LASTEDITOR(\"draft\") & \">\" & FIRSTENTEREDBY(\"review\") & \">\" & LASTLEFTBY(\"review\") & \" \" & TEXT(ENTRIES(\"approved\"))"}}]}, {"on": "enter", "state": "rejected", "do": [{"action": "set", "values": {"why": "\"after \" & TEXT(ENTRIES(\"review\")) & \" rounds, by \" & LASTLEFTBY(\"review\") & \", \" & TEXT(ENTRIES(\"rejected\")) & \" \" & TEXT(LASTLEFT(\"review\") = NOW())"}}]}]},
  "principals": {"ann": {"id": "ann"}, "bob": {"id": "bob"}, "carl": {"id": "carl"}, "dave": {"id": "dave"}, "erin": {"id": "erin"}, "fay": {"id": "fay"}},
  "script": [
    {"do": "create", "id": "R-1", "doc": "r", "as": "ann", "values": {"amount": "10.00", "note": "a"}, "expect": {"state": "draft", "version": 1, "values": {"back_to": "ann"}}, "name": "created in draft: who creates a document is the first editor of the state it is created in"},
    {"do": "set", "doc": "r", "as": "bob", "values": {"note": "b"}, "expect": {"version": 2}},
    {"name": "a preview reads the life with the step it would make", "do": "preview", "doc": "r", "as": "carl", "transition": "submit", "expect": {"state": "review", "version": 3, "values": {"rounds": 1, "sent_by": "carl/carl", "out": "carl after 1 in draft and 1 in review", "first_sent": 1772366400}}},
    {"name": "and leaves nothing behind: the entry that the commit makes is the first", "do": "transition", "doc": "r", "as": "carl", "transition": "submit", "expect": {"state": "review", "version": 3, "values": {"rounds": 1, "sent_by": "carl/carl", "out": "carl after 1 in draft and 1 in review", "first_sent": 1772366400}}},
    {"do": "wait", "seconds": 86400, "expect": {}},
    {"name": "back in draft it goes to who last changed it there: not to who sent it to review, and not to who sent it back", "do": "transition", "doc": "r", "as": "dave", "transition": "back", "expect": {"state": "draft", "version": 4, "values": {"back_to": "bob"}}},
    {"do": "set", "doc": "r", "as": "fay", "values": {"note": "c"}, "expect": {"version": 5}},
    {"name": "the second round: the first entry stays the first", "do": "transition", "doc": "r", "as": "ann", "transition": "submit", "expect": {"state": "review", "version": 6, "values": {"rounds": 2, "sent_by": "carl/ann", "out": "ann after 2 in draft and 2 in review", "first_sent": 1772366400}}},
    {"do": "wait", "seconds": 43200, "expect": {}},
    {"name": "a day in the first stay and half a day in this one", "do": "refresh", "doc": "r", "as": "ann", "variables": ["days", "here"], "expect": {"version": 7, "values": {"days": 1.5, "here": 1.5}}},
    {"name": "who first sent it to review may not approve it", "do": "transition", "doc": "r", "as": "carl", "transition": "approve", "expect": {"code": "forbidden"}},
    {"name": "the listing asks the same of the life", "do": "transitions", "doc": "r", "as": "carl", "expect": {"transitions": [{"name": "back", "to": "draft", "enabled": true}, {"name": "remind", "to": "review", "enabled": true}, {"name": "approve", "to": "approved", "enabled": false, "code": "forbidden"}]}},
    {"do": "transitions", "doc": "r", "as": "erin", "expect": {"transitions": [{"name": "back", "to": "draft", "enabled": true}, {"name": "remind", "to": "review", "enabled": true}, {"name": "approve", "to": "approved", "enabled": true}]}},
    {"name": "a reminder is an entry: the third", "do": "transition", "doc": "r", "as": "erin", "transition": "remind", "expect": {"state": "review", "version": 8, "values": {"rounds": 3, "sent_by": "carl/erin"}}},
    {"name": "the rule of the entry reads the whole life: the editors of the draft, who sent it first, who moved it out last", "do": "transition", "doc": "r", "as": "erin", "transition": "approve", "expect": {"state": "approved", "version": 9, "values": {"summary": "ann>fay>carl>erin 1"}}},
    {"name": "a filter is refused these functions; the view of stays has them for every document", "do": "query", "where": "ENTRIES(\"review\") > 1", "expect": {"code": "not_allowed"}},
    {"name": "a guard that has not held: less than a day in review in all", "do": "create", "id": "R-2", "doc": "q", "as": "ann", "expect": {"state": "draft", "version": 1}},
    {"do": "transition", "doc": "q", "as": "bob", "transition": "submit", "expect": {"state": "review", "version": 2, "values": {"rounds": 1}}},
    {"do": "transition", "doc": "q", "as": "erin", "transition": "approve", "expect": {"code": "guard_false"}},
    {"do": "transition", "doc": "q", "as": "erin", "transition": "back", "expect": {"state": "draft", "version": 3, "values": {"back_to": "ann"}}},
    {"do": "transition", "doc": "q", "as": "bob", "transition": "submit", "expect": {"state": "review", "version": 4, "values": {"rounds": 2}}},
    {"do": "transition", "doc": "q", "as": "erin", "transition": "remind", "expect": {"state": "review", "version": 5, "values": {"rounds": 3}}},
    {"name": "the fourth entry: the eventless transition counts the entry of the commit before it, and its rule the move it makes itself", "do": "transition", "doc": "q", "as": "dave", "transition": "remind", "expect": {"state": "rejected", "version": 7, "values": {"rounds": 4, "why": "after 4 rounds, by dave, 1 TRUE"}, "history": ["draft", "review", "draft", "review", "review", "review", "rejected"], "origins": ["command", "command", "command", "command", "command", "command", "guard"]}}
  ]
}
