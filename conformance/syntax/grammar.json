{
  "suite": "grammar",
  "description": "What the parser accepts and refuses at definition time: ADR-0019's grammar, the catalog's arities, both IF forms, names that collide with functions, the keyword functions in function form. Type errors are not here; they are the binder's.",
  "variables": {"Alfa": "number", "Beta": "number", "Godziny": "number", "Code": "text", "Log": "number", "Sign": "number", "Year": "number", "x": "number", "a": "bool", "b": "bool", "lines": "rows", "d": "date", "żółw": "number", "_x": "number", "x1": "number"},
  "accept": [
    "1",
    "Alfa",
    "1 + 2",
    "Alfa - Beta",
    "Alfa ^ 2",
    "-Alfa ^ 2",
    "2 ^ Beta ^ 2",
    "2 ^ -1",
    "Alfa * 2 / 3 \\ 4",
    "1e3",
    ".5",
    "1.",
    "50%",
    "50%%",
    "-5%",
    "Alfa%",
    "--1",
    "1 - -1",
    "a<>b",
    "a<=b",
    "a>=b",
    "Alfa > 0 AND Beta > 0",
    "Alfa > 0 OR Beta > 2 AND Alfa > 0",
    "NOT Alfa > 0",
    "NOT NOT a",
    "NOT (a AND b)",
    "NOT(a)",
    "NOT(a) <= b",
    "NOT(a) & NOT(b)",
    "AND(a, b)",
    "AND(a, b, Alfa > 0)",
    "and(a)",
    "OR(a, b)",
    "IF(a, 1, 2)",
    "IF a THEN 1 ELSE 2",
    "IF (a) THEN 1 ELSE 2",
    "IF(a) THEN 1 ELSE 2",
    "IF(Alfa > 0) THEN IF(Beta > 2) THEN 1 ELSE 2 ELSE 3",
    "IF Alfa > 0 THEN IF Beta > 2 THEN 1 ELSE 2 ELSE 3",
    "1 + IF(Alfa > 0, 10, 20)",
    "1 + IF Alfa > 0 THEN 10 ELSE 20",
    "IF(Alfa > 0, 1, 0) * Beta",
    "IF(IF(Alfa > 0, 1, 0) = 1, Alfa, Beta)",
    "if(alfa > 0, 1, 0)",
    "IF(Beta = 0, BLANK, Alfa / Beta)",
    "BLANK",
    "blank + 1",
    "ISBLANK(BLANK)",
    "isblank(Code)",
    "x = BLANK",
    "True",
    "false",
    "TRUE AND FALSE",
    "ROUND(Godziny)",
    "ROUND(Godziny, 2)",
    "ROUND(Godziny / 8)",
    "ROUND(Godziny / 8, 0)",
    "ROUND(Godziny, -2)",
    "ROUND(Godziny, Godziny - Godziny)",
    "ROUND(ABS(Godziny) / 8)",
    "IF(Godziny > 0, ROUND(Godziny / 8), 0)",
    "ROUND(Godziny / 8) * 8",
    "ABS(Godziny)",
    "FLOOR(Godziny / 8)",
    "CEILING(Godziny / 8)",
    "CEIL(Godziny / 8)",
    "ceiling(Godziny / 8)",
    "FLOOR(Godziny, 2)",
    "CEILING(Godziny, -2)",
    "CEILING(Godziny / 8) * 8 - Godziny",
    "MAX(Alfa, Beta)",
    "MIN(Alfa, Beta, 1)",
    "min(Alfa, Beta)",
    "MIN(7)",
    "POWER(Beta, 2)",
    "SQRT(Alfa * Alfa)",
    "ROUND(EXP(Beta), 3)",
    "LOG(1000)",
    "LOG(8, 2)",
    "MOD(Alfa, 3)",
    "SIGN(Alfa)",
    "TRUNC(Alfa / 3, 1)",
    "SUM(Alfa, Beta)",
    "SUM(lines.qty * lines.price)",
    "COUNT(lines)",
    "AVERAGE(lines.price)",
    "Log + 1",
    "Sign * Log",
    "LOG(Log)",
    "SIGN(Sign) + Sign",
    "Year + YEAR(d)",
    "żółw + 1",
    "_x + x1",
    "\"abc\"",
    "\"\"",
    "\"it\"\"s\"",
    "\"say 'hi'\"",
    "\"a\" & \"b\"",
    "Code & \"x\"",
    "UPPER(Code)",
    "LEN(Code) + 1",
    "LEFT(Code, FINDLAST(\"-\", Code) - 1)",
    "FIND(\"a\", Code)",
    "FINDFIRST(\"a\", Code)",
    "SUBSTITUTE(Code, \"-\", \"\")",
    "MID(Code, 2)",
    "MID(Code, 2, 3)",
    "VALUE(Code)",
    "TEXT(Alfa)",
    "DATE(2024, 1, 31)",
    "DATEVALUE(\"2024-01-31\")",
    "ADDMONTHS(d, 1)",
    "DAYS(d, TODAY())",
    "NOW()",
    "TODAY()",
    "USER()",
    "USER() = \"alice\"",
    "INGROUP(\"admins\")",
    "lines.qty",
    "INDEX(lines.qty, 1)",
    "FILTER(lines, lines.qty > 0)",
    "FIRST(lines.sku)",
    "CONTAINS(lines.sku, \"A1\")",
    "JOIN(lines.sku, \", \")",
    "JSONVALUE(Code, \"address.city\")",
    "THIS.code",
    "this.Code",
    "LOOKUP(Rates, rate, code = THIS.code)",
    "LOOKUP(Rates, rate, code = THIS.code AND valid_from <= THIS.date)",
    "QUERY(Invoice, total)",
    "QUERY(Invoice, total, state = \"paid\")",
    "QUERY(Invoice, total, state = \"paid\", total, customer, 100)",
    "  1 + 2  ",
    "(((1)))",
    "1+2*3^4%"
  ],
  "reject": [
    {"formula": "", "reason": "empty"},
    {"formula": "   ", "reason": "empty"},
    {"formula": "Alfa ^", "reason": "missing operand"},
    {"formula": "^ Alfa", "reason": "missing operand"},
    {"formula": "1 +", "reason": "missing operand"},
    {"formula": "+ 1", "reason": "there is no unary plus"},
    {"formula": "(1 + 2", "reason": "unclosed parenthesis"},
    {"formula": "1 + 2)", "reason": "stray parenthesis"},
    {"formula": "1 2", "reason": "two expressions"},
    {"formula": "Alfa Beta", "reason": "two expressions"},
    {"formula": "()", "reason": "empty parentheses"},
    {"formula": ",", "reason": "stray comma"},
    {"formula": "1 == 2", "reason": "equality is a single ="},
    {"formula": "1 != 2", "reason": "inequality is <>"},
    {"formula": "a && b", "reason": "AND is a word"},
    {"formula": "a || b", "reason": "OR is a word"},
    {"formula": "!a", "reason": "NOT is a word"},
    {"formula": "'abc'", "reason": "text literals use double quotes"},
    {"formula": "\"abc", "reason": "unterminated text"},
    {"formula": "\"it\"\"s", "reason": "unterminated text"},
    {"formula": "1e", "reason": "malformed number"},
    {"formula": "12abc", "reason": "malformed number"},
    {"formula": "1e999", "reason": "number out of range"},
    {"formula": "1 + #", "reason": "unexpected character"},
    {"formula": "AND Alfa", "reason": "AND needs a left operand"},
    {"formula": "Alfa AND", "reason": "AND needs a right operand"},
    {"formula": "NOT", "reason": "NOT needs an operand"},
    {"formula": "IF", "reason": "IF needs a condition"},
    {"formula": "THEN", "reason": "a keyword is not an expression"},
    {"formula": "ELSE 1", "reason": "a keyword is not an expression"},
    {"formula": "IF(Alfa > 0, 1)", "reason": "IF takes three arguments"},
    {"formula": "IF(Alfa > 0, 1, 2, 3)", "reason": "IF takes three arguments"},
    {"formula": "IF(Alfa > 0 OR, 1, 0)", "reason": "OR needs a right operand"},
    {"formula": "IF Alfa > 0 THEN 1", "reason": "ELSE is required"},
    {"formula": "IF Alfa > 0 ELSE 1", "reason": "THEN is required"},
    {"formula": "IF(Alfa > 0) THEN 1", "reason": "ELSE is required"},
    {"formula": "IF(Alfa > 0) 1 ELSE 2", "reason": "THEN is required"},
    {"formula": "IF Alfa > 0 THEN 1 ELSE", "reason": "ELSE needs an expression"},
    {"formula": "TRUE()", "reason": "a literal is not a function"},
    {"formula": "BLANK()", "reason": "a literal is not a function"},
    {"formula": "THIS", "reason": "THIS needs .name"},
    {"formula": "THIS.", "reason": "THIS needs .name"},
    {"formula": "THIS.1", "reason": "THIS needs .name"},
    {"formula": "THIS()", "reason": "THIS is not a function"},
    {"formula": "lines.", "reason": "a column name is required"},
    {"formula": "lines.qty.x", "reason": "names nest only one level"},
    {"formula": "lines.1", "reason": "a column name is required"},
    {"formula": "FOO(1)", "reason": "unknown function"},
    {"formula": "ROUND(Godziny", "reason": "unclosed call"},
    {"formula": "ROUND()", "reason": "ROUND needs a number"},
    {"formula": "ROUND(Godziny, 2, 3)", "reason": "ROUND takes at most two arguments"},
    {"formula": "ROUND(Godziny,)", "reason": "trailing comma"},
    {"formula": "ROUND(,Godziny)", "reason": "leading comma"},
    {"formula": "ABS()", "reason": "ABS needs a number"},
    {"formula": "FLOOR()", "reason": "FLOOR needs a number"},
    {"formula": "CEILING(Godziny", "reason": "unclosed call"},
    {"formula": "CEILING(Godziny, 1, 2)", "reason": "CEILING takes at most two arguments"},
    {"formula": "MIN()", "reason": "MIN needs a value"},
    {"formula": "MAX()", "reason": "MAX needs a value"},
    {"formula": "POWER(Alfa)", "reason": "POWER takes two arguments"},
    {"formula": "POWER(Alfa, 2, 3)", "reason": "POWER takes two arguments"},
    {"formula": "SQRT(Alfa, 2)", "reason": "SQRT takes one argument"},
    {"formula": "SQRT()", "reason": "SQRT takes one argument"},
    {"formula": "LOG()", "reason": "LOG needs a number"},
    {"formula": "LOG(Alfa, 2, 3)", "reason": "LOG takes at most two arguments"},
    {"formula": "MOD(Alfa)", "reason": "MOD takes two arguments"},
    {"formula": "SIGN()", "reason": "SIGN takes one argument"},
    {"formula": "TRUNC()", "reason": "TRUNC needs a number"},
    {"formula": "ISBLANK()", "reason": "ISBLANK takes one argument"},
    {"formula": "ISBLANK(Alfa, Beta)", "reason": "ISBLANK takes one argument"},
    {"formula": "ISBLANK(Alfa", "reason": "unclosed call"},
    {"formula": "LEFT(Code)", "reason": "LEFT takes two arguments"},
    {"formula": "UPPER(Code, 2)", "reason": "UPPER takes one argument"},
    {"formula": "TRIM()", "reason": "TRIM takes one argument"},
    {"formula": "FIND(Code)", "reason": "FIND takes two arguments"},
    {"formula": "FINDFIRST(Code)", "reason": "FINDFIRST takes two arguments"},
    {"formula": "FINDLAST(Code)", "reason": "FINDLAST takes two arguments"},
    {"formula": "NOW(1)", "reason": "NOW takes no arguments"},
    {"formula": "TODAY(d)", "reason": "TODAY takes no arguments"},
    {"formula": "INGROUP()", "reason": "INGROUP takes one argument"},
    {"formula": "LOOKUP(Rates, rate)", "reason": "LOOKUP takes three arguments"},
    {"formula": "QUERY(Invoice)", "reason": "QUERY needs columns"},
    {"formula": "QUERY(Invoice, total, a, b, c, d, e)", "reason": "QUERY takes at most six arguments"},
    {"formula": "NOT()", "reason": "NOT takes one argument"},
    {"formula": "NOT(a, b)", "reason": "NOT takes one argument"},
    {"formula": "AND()", "reason": "AND needs a condition"},
    {"formula": "OR()", "reason": "OR needs a condition"}
  ]
}
